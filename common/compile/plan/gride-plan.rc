// gride-plan.rc - the version resource of gride-plan.exe, which Windows shows in the file's Properties > Details.
// gride-plan is numbered with the block it fronts (gride_compile.h), as it says in its --version.
#include <winres.h>
#include "../gride_compile.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GRIDE_COMPILE_MAJOR, GRIDE_COMPILE_MINOR, 0, 0
 PRODUCTVERSION GRIDE_COMPILE_MAJOR, GRIDE_COMPILE_MINOR, 0, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "G. R. Akhtar"
            VALUE "FileDescription",  "gride-plan - prints GRIDE's build plan"
            VALUE "FileVersion",      GRIDE_COMPILE_NUMBER
            VALUE "InternalName",     "gride-plan"
            VALUE "LegalCopyright",   "(c) 2026 G. R. Akhtar"
            VALUE "OriginalFilename", "gride-plan.exe"
            VALUE "ProductName",      "GRIDE"
            VALUE "ProductVersion",   GRIDE_COMPILE_NUMBER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
