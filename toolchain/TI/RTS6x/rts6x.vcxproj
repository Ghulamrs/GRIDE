<?xml version="1.0" encoding="utf-8"?>
<!--
  rts6x - the C6747 runtime libraries, built with the solution's own cpp11 and asm6x, packed by ar6x:
    lib\rts6x-tms6747\rts6x.lib, printf6x.lib     (-O2 -DNDEBUG=1)
    lib\rts6x-tms6747\rts6xd.lib, printf6xd.lib   (-O0 -g -D_DEBUG=1)
    lib\rts6x-tms6747\shmrt6x.lib, shmrt6xd.lib   (the Shalimar runtime's C6747 assembly that shalimar's build wrote)
  beside the programs in $(OutDir). Both variants are built in either configuration, as RTS6x's build.cmd builds
  them. The steps are MSBuild tasks (..\..\msbuild\Toolchain.targets): nothing runs through cmd.exe. Built after
  cpp11, asm6x and shalimar (the solution's dependencies).
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{08BE728A-FAFA-293F-A679-72F80B983AD1}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>rts6x</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- standalone (no solution): the programs are looked for where a solution build puts them -->
    <OutDir Condition="'$(SolutionDir)'=='' Or '$(SolutionDir)'=='*Undefined*'">$(ProjectDir)..\..\..\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build\$(Configuration)\</IntDir>
    <!-- Visual Studio's own up-to-date check does not know the libraries; Rts6xLibraries' Inputs/Outputs decide -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <Rts6xCpp11>$(OutDir)cpp11.exe</Rts6xCpp11>
    <Rts6xAsm6x>$(OutDir)asm6x.exe</Rts6xAsm6x>
    <Rts6xAr6x>$(ProjectDir)tools\ar6x\build\$(Configuration)\ar6x.exe</Rts6xAr6x>
    <Rts6xLibDir>$(OutDir)lib\rts6x-tms6747\</Rts6xLibDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="printf6x.members" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\..\msbuild\Toolchain.targets" />

  <ItemGroup>
    <Rts6xInput Include="$(ProjectDir)src\**\*.cpp;$(ProjectDir)src\**\*.s;$(ProjectDir)src\**\*.h;$(ProjectDir)printf6x.members" />
  </ItemGroup>

  <Target Name="Rts6xLibraries" AfterTargets="Build"
          Inputs="@(Rts6xInput);$(Rts6xCpp11);$(Rts6xAsm6x);$(Rts6xAr6x);$(OutDir)lib\shmrt-tms6747\Runtime.s;$(OutDir)lib\shmrt-tms6747-debug\Runtime.s"
          Outputs="$(Rts6xLibDir)rts6x.lib;$(Rts6xLibDir)rts6xd.lib;$(Rts6xLibDir)printf6x.lib;$(Rts6xLibDir)printf6xd.lib;$(Rts6xLibDir)shmrt6x.lib;$(Rts6xLibDir)shmrt6xd.lib">
    <Error Condition="!Exists('$(Rts6xCpp11)')" Text="rts6x: no cpp11.exe in $(OutDir) - cpp11 is built first in the solution" />
    <Error Condition="!Exists('$(Rts6xAsm6x)')" Text="rts6x: no asm6x.exe in $(OutDir) - asm6x is built first in the solution" />
    <Error Condition="!Exists('$(OutDir)lib\shmrt-tms6747')" Text="rts6x: no lib\shmrt-tms6747 in $(OutDir) - shalimar's build writes it, and is built first in the solution" />
    <Error Condition="!Exists('$(Rts6xAr6x)')" Text="rts6x: no ar6x.exe at $(Rts6xAr6x) - the ar6x project (tools\ar6x) is built first in the solution" />
    <Rts6xVariant Cpp11="$(Rts6xCpp11)" Asm6x="$(Rts6xAsm6x)" Ar6x="$(Rts6xAr6x)" SourceRoot="$(ProjectDir)" ObjDir="$(IntDir)obj"
                  Flags="-O2 -DNDEBUG=1" Members="$(ProjectDir)printf6x.members"
                  Library="$(Rts6xLibDir)rts6x.lib" PrintfLibrary="$(Rts6xLibDir)printf6x.lib" />
    <Rts6xVariant Cpp11="$(Rts6xCpp11)" Asm6x="$(Rts6xAsm6x)" Ar6x="$(Rts6xAr6x)" SourceRoot="$(ProjectDir)" ObjDir="$(IntDir)objd"
                  Flags="-O0 -g -D_DEBUG=1" Members="$(ProjectDir)printf6x.members"
                  Library="$(Rts6xLibDir)rts6xd.lib" PrintfLibrary="$(Rts6xLibDir)printf6xd.lib" />
    <PackObjects Asm6x="$(Rts6xAsm6x)" Ar6x="$(Rts6xAr6x)" AssemblyDir="$(OutDir)lib\shmrt-tms6747" ObjDir="$(IntDir)shmrt6x" Library="$(Rts6xLibDir)shmrt6x.lib" />
    <PackObjects Asm6x="$(Rts6xAsm6x)" Ar6x="$(Rts6xAr6x)" AssemblyDir="$(OutDir)lib\shmrt-tms6747-debug" ObjDir="$(IntDir)shmrt6xd" Library="$(Rts6xLibDir)shmrt6xd.lib" />
  </Target>

  <Target Name="Rts6xClean" AfterTargets="Clean">
    <RemoveDir Directories="$(IntDir)obj;$(IntDir)objd;$(IntDir)shmrt6x;$(IntDir)shmrt6xd" />
    <Delete Files="$(Rts6xLibDir)rts6x.lib;$(Rts6xLibDir)rts6xd.lib;$(Rts6xLibDir)printf6x.lib;$(Rts6xLibDir)printf6xd.lib;$(Rts6xLibDir)shmrt6x.lib;$(Rts6xLibDir)shmrt6xd.lib" />
  </Target>
</Project>
