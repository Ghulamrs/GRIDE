// <unordered_map> - [unord.map], [unord.multimap]: a map and a multimap kept by hash, over <__hashtable>.
// The allocator is kept and handed back, as the other containers' are; the nodes come from operator new.
#ifndef _CXX1_UNORDERED_MAP
#define _CXX1_UNORDERED_MAP

#include <cstddef>
#include <initializer_list>
#include <utility>
#include <tuple>
#include <functional>
#include <stdexcept>
#include <__allocator>
#include <__hashtable>

namespace std {

template <class Key, class T, class Hash = hash<Key>, class Pred = equal_to<Key>,
          class Alloc = allocator<pair<const Key, T> >, bool Unique = true>
class __cxx1_unordered_map_base {
protected:
    typedef __cxx1_hashtable<pair<const Key, T>, __cxx1_key_first<pair<const Key, T> >, Hash, Pred, Alloc, Unique> table;
    table t_;

public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Hash hasher;
    typedef Pred key_equal;
    typedef Alloc allocator_type;
    typedef value_type &reference;
    typedef const value_type &const_reference;
    typedef value_type *pointer;
    typedef const value_type *const_pointer;
    typedef std::size_t size_type;
    typedef std::ptrdiff_t difference_type;
    typedef typename table::iterator iterator;
    typedef typename table::const_iterator const_iterator;
    typedef typename table::local_iterator local_iterator;
    typedef typename table::const_local_iterator const_local_iterator;

    explicit __cxx1_unordered_map_base(size_type n, const Hash &h, const Pred &e, const Alloc &a) : t_(n, h, e, a) {}
    __cxx1_unordered_map_base(const __cxx1_unordered_map_base &o, const Alloc &a) : t_(o.t_, a) {}
    __cxx1_unordered_map_base(__cxx1_unordered_map_base &&o, const Alloc &a) : t_(std::move(o.t_), a) {}
    __cxx1_unordered_map_base(const __cxx1_unordered_map_base &o) : t_(o.t_) {}
    __cxx1_unordered_map_base(__cxx1_unordered_map_base &&o) : t_(std::move(o.t_)) {}
    __cxx1_unordered_map_base &operator=(const __cxx1_unordered_map_base &o) {
        t_ = o.t_;
        return *this;
    }
    __cxx1_unordered_map_base &operator=(__cxx1_unordered_map_base &&o) {
        t_ = std::move(o.t_);
        return *this;
    }

    allocator_type get_allocator() const noexcept { return t_.get_allocator(); }
    bool empty() const noexcept { return t_.empty(); }
    size_type size() const noexcept { return t_.size(); }
    size_type max_size() const noexcept { return t_.max_size(); }
    iterator begin() noexcept { return t_.begin(); }
    const_iterator begin() const noexcept { return t_.begin(); }
    iterator end() noexcept { return t_.end(); }
    const_iterator end() const noexcept { return t_.end(); }
    const_iterator cbegin() const noexcept { return t_.begin(); }
    const_iterator cend() const noexcept { return t_.end(); }

    iterator erase(const_iterator pos) { return t_.erase(pos); }
    size_type erase(const key_type &k) { return t_.eraseKey(k); }
    iterator erase(const_iterator first, const_iterator last) { return t_.erase(first, last); }
    void clear() noexcept { t_.clear(); }

    hasher hash_function() const { return t_.hash_function(); }
    key_equal key_eq() const { return t_.key_eq(); }
    iterator find(const key_type &k) { return t_.find(k); }
    const_iterator find(const key_type &k) const { return t_.find(k); }
    size_type count(const key_type &k) const { return t_.count(k); }
    pair<iterator, iterator> equal_range(const key_type &k) { return t_.equal_range(k); }
    pair<const_iterator, const_iterator> equal_range(const key_type &k) const { return t_.equal_range(k); }

    size_type bucket_count() const noexcept { return t_.bucket_count(); }
    size_type max_bucket_count() const noexcept { return t_.max_bucket_count(); }
    size_type bucket_size(size_type n) const { return t_.bucket_size(n); }
    size_type bucket(const key_type &k) const { return t_.bucket(k); }
    local_iterator begin(size_type n) { return t_.begin(n); }
    const_local_iterator begin(size_type n) const { return t_.begin(n); }
    local_iterator end(size_type n) { return t_.end(n); }
    const_local_iterator end(size_type n) const { return t_.end(n); }
    const_local_iterator cbegin(size_type n) const { return t_.begin(n); }
    const_local_iterator cend(size_type n) const { return t_.end(n); }
    float load_factor() const noexcept { return t_.load_factor(); }
    float max_load_factor() const noexcept { return t_.max_load_factor(); }
    void max_load_factor(float z) { t_.max_load_factor(z); }
    void rehash(size_type n) { t_.rehash(n); }
    void reserve(size_type n) { t_.reserve(n); }

    bool __cxx1_equal(const __cxx1_unordered_map_base &o) const { return t_.equals(o.t_); }
};

template <class Key, class T, class Hash = hash<Key>, class Pred = equal_to<Key>,
          class Alloc = allocator<pair<const Key, T> > >
class unordered_map : public __cxx1_unordered_map_base<Key, T, Hash, Pred, Alloc, true> {
    typedef __cxx1_unordered_map_base<Key, T, Hash, Pred, Alloc, true> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::value_type value_type;
    typedef typename base::key_type key_type;
    typedef typename base::iterator iterator;
    typedef typename base::const_iterator const_iterator;

    explicit unordered_map(size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(), const Alloc &a = Alloc())
        : base(n, h, e, a) {}
    template <class It>
    unordered_map(It first, It last, size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(),
                  const Alloc &a = Alloc())
        : base(n, h, e, a) {
        insert(first, last);
    }
    explicit unordered_map(const Alloc &a) : base(11, Hash(), Pred(), a) {}
    unordered_map(const unordered_map &o) : base(o) {}
    unordered_map(unordered_map &&o) : base(std::move(o)) {}
    unordered_map(const unordered_map &o, const Alloc &a) : base(o, a) {}
    unordered_map(unordered_map &&o, const Alloc &a) : base(std::move(o), a) {}
    unordered_map(initializer_list<value_type> il, size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(),
                  const Alloc &a = Alloc())
        : base(n, h, e, a) {
        insert(il.begin(), il.end());
    }
    unordered_map &operator=(const unordered_map &o) {
        base::operator=(o);
        return *this;
    }
    unordered_map &operator=(unordered_map &&o) {
        base::operator=(std::move(o));
        return *this;
    }
    unordered_map &operator=(initializer_list<value_type> il) {
        this->clear();
        insert(il.begin(), il.end());
        return *this;
    }

    template <class... A> pair<iterator, bool> emplace(A &&... a) { return this->t_.emplace(std::forward<A>(a)...); }
    template <class... A> iterator emplace_hint(const_iterator, A &&... a) { return emplace(std::forward<A>(a)...).first; }
    pair<iterator, bool> insert(const value_type &v) { return this->t_.insertValue(v); }
    template <class P, class = typename enable_if<is_constructible<value_type, P &&>::value>::type>
    pair<iterator, bool> insert(P &&v) {
        return this->t_.insertValue(value_type(std::forward<P>(v)));
    }
    iterator insert(const_iterator, const value_type &v) { return insert(v).first; }
    template <class P, class = typename enable_if<is_constructible<value_type, P &&>::value>::type>
    iterator insert(const_iterator, P &&v) {
        return insert(std::forward<P>(v)).first;
    }
    template <class It> void insert(It first, It last) {
        for (; first != last; ++first) this->t_.insertValue(*first);
    }
    void insert(initializer_list<value_type> il) { insert(il.begin(), il.end()); }
    void swap(unordered_map &o) { this->t_.swap(o.t_); }

    // [unord.map.elem]: made from the key and a value-initialised T where the key is not there.
    T &operator[](const key_type &k) {
        iterator i = this->find(k);
        if (i == this->end())
            i = this->t_.emplace(piecewise_construct, forward_as_tuple(k), tuple<>()).first;
        return i->second;
    }
    T &operator[](key_type &&k) {
        iterator i = this->find(k);
        if (i == this->end())
            i = this->t_.emplace(piecewise_construct, forward_as_tuple(std::move(k)), tuple<>()).first;
        return i->second;
    }
    T &at(const key_type &k) {
        iterator i = this->find(k);
        if (i == this->end()) throw out_of_range("unordered_map::at");
        return i->second;
    }
    const T &at(const key_type &k) const {
        const_iterator i = this->find(k);
        if (i == this->end()) throw out_of_range("unordered_map::at");
        return i->second;
    }
};

template <class Key, class T, class Hash = hash<Key>, class Pred = equal_to<Key>,
          class Alloc = allocator<pair<const Key, T> > >
class unordered_multimap : public __cxx1_unordered_map_base<Key, T, Hash, Pred, Alloc, false> {
    typedef __cxx1_unordered_map_base<Key, T, Hash, Pred, Alloc, false> base;

public:
    typedef typename base::size_type size_type;
    typedef typename base::value_type value_type;
    typedef typename base::key_type key_type;
    typedef typename base::iterator iterator;
    typedef typename base::const_iterator const_iterator;

    explicit unordered_multimap(size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(), const Alloc &a = Alloc())
        : base(n, h, e, a) {}
    template <class It>
    unordered_multimap(It first, It last, size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(),
                       const Alloc &a = Alloc())
        : base(n, h, e, a) {
        insert(first, last);
    }
    explicit unordered_multimap(const Alloc &a) : base(11, Hash(), Pred(), a) {}
    unordered_multimap(const unordered_multimap &o) : base(o) {}
    unordered_multimap(unordered_multimap &&o) : base(std::move(o)) {}
    unordered_multimap(const unordered_multimap &o, const Alloc &a) : base(o, a) {}
    unordered_multimap(unordered_multimap &&o, const Alloc &a) : base(std::move(o), a) {}
    unordered_multimap(initializer_list<value_type> il, size_type n = 11, const Hash &h = Hash(), const Pred &e = Pred(),
                       const Alloc &a = Alloc())
        : base(n, h, e, a) {
        insert(il.begin(), il.end());
    }
    unordered_multimap &operator=(const unordered_multimap &o) {
        base::operator=(o);
        return *this;
    }
    unordered_multimap &operator=(unordered_multimap &&o) {
        base::operator=(std::move(o));
        return *this;
    }
    unordered_multimap &operator=(initializer_list<value_type> il) {
        this->clear();
        insert(il.begin(), il.end());
        return *this;
    }

    template <class... A> iterator emplace(A &&... a) { return this->t_.emplace(std::forward<A>(a)...).first; }
    template <class... A> iterator emplace_hint(const_iterator, A &&... a) { return emplace(std::forward<A>(a)...); }
    iterator insert(const value_type &v) { return this->t_.insertValue(v).first; }
    template <class P, class = typename enable_if<is_constructible<value_type, P &&>::value>::type>
    iterator insert(P &&v) {
        return this->t_.insertValue(value_type(std::forward<P>(v))).first;
    }
    iterator insert(const_iterator, const value_type &v) { return insert(v); }
    template <class P, class = typename enable_if<is_constructible<value_type, P &&>::value>::type>
    iterator insert(const_iterator, P &&v) {
        return insert(std::forward<P>(v));
    }
    template <class It> void insert(It first, It last) {
        for (; first != last; ++first) this->t_.insertValue(*first);
    }
    void insert(initializer_list<value_type> il) { insert(il.begin(), il.end()); }
    void swap(unordered_multimap &o) { this->t_.swap(o.t_); }
};

template <class K, class T, class H, class P, class A>
inline bool operator==(const unordered_map<K, T, H, P, A> &x, const unordered_map<K, T, H, P, A> &y) { return x.__cxx1_equal(y); }
template <class K, class T, class H, class P, class A>
inline bool operator!=(const unordered_map<K, T, H, P, A> &x, const unordered_map<K, T, H, P, A> &y) { return !x.__cxx1_equal(y); }
template <class K, class T, class H, class P, class A>
inline bool operator==(const unordered_multimap<K, T, H, P, A> &x, const unordered_multimap<K, T, H, P, A> &y) { return x.__cxx1_equal(y); }
template <class K, class T, class H, class P, class A>
inline bool operator!=(const unordered_multimap<K, T, H, P, A> &x, const unordered_multimap<K, T, H, P, A> &y) { return !x.__cxx1_equal(y); }
template <class K, class T, class H, class P, class A>
inline void swap(unordered_map<K, T, H, P, A> &x, unordered_map<K, T, H, P, A> &y) { x.swap(y); }
template <class K, class T, class H, class P, class A>
inline void swap(unordered_multimap<K, T, H, P, A> &x, unordered_multimap<K, T, H, P, A> &y) { x.swap(y); }

}  // namespace std

#endif
