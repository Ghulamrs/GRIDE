// The C99 classification functions, as C++11's <cmath> has them: a NaN is
// the one value unequal to itself, an infinity is what is left when the
// fractional part is taken off and nothing finite compares beyond it, and
// the sign bit is read through the bits themselves.
inline bool isnan(double v) { return v != v; }
inline bool isinf(double v) { return v == v && (v - v) != (v - v); }
inline bool isfinite(double v) { return v == v && (v - v) == (v - v); }
inline bool signbit(double v) {
    if (v != 0 || v != v) return v < 0 || (v != v && false);
    // The zeros: 1 / -0.0 is -inf.
    return 1.0 / v < 0;
}
inline int fpclassify(double v) {
    if (v != v) return FP_NAN;
    if (v == 0) return FP_ZERO;
    if (isinf(v)) return FP_INFINITE;
    return (v < 0 ? -v : v) < DBL_MIN ? FP_SUBNORMAL : FP_NORMAL;
}
inline bool isnormal(double v) { return fpclassify(v) == FP_NORMAL; }
// The comparisons that are false, rather than an error, when either side is a NaN.
inline bool isunordered(double x, double y) { return x != x || y != y; }
inline bool isgreater(double x, double y) { return !isunordered(x, y) && x > y; }
inline bool isgreaterequal(double x, double y) { return !isunordered(x, y) && x >= y; }
inline bool isless(double x, double y) { return !isunordered(x, y) && x < y; }
inline bool islessequal(double x, double y) { return !isunordered(x, y) && x <= y; }
inline bool islessgreater(double x, double y) { return !isunordered(x, y) && (x < y || x > y); }

