// <ostream> - [output.streams]: basic_ostream, its sentry, the inserters and the manipulators that go
// through it.
//
// **Every character goes to the stream's buffer** through sputn. A number is formatted with `snprintf` into a
// narrow buffer, through the conversion [facet.num.put.virtuals] names for the flags - Tables 88 to 90 - widened
// to the stream's character type and padded to the width as its stage 3 says. The "C" locale is the only one:
// the point is '.', and nothing is grouped.
#ifndef _CXX1_OSTREAM
#define _CXX1_OSTREAM

#include <cstddef>
#include <cstdio>
#include <cstring>
#include <exception>
#include <ios>
#include <streambuf>
#include <__num_facets>
#include <string>

namespace std {

template <class C, class Tr> class basic_ostream : virtual public basic_ios<C, Tr> {
public:
    typedef C char_type;
    typedef typename Tr::int_type int_type;
    typedef typename Tr::pos_type pos_type;
    typedef typename Tr::off_type off_type;
    typedef Tr traits_type;

    explicit basic_ostream(basic_streambuf<C, Tr> *sb) { this->init(sb); }
    virtual ~basic_ostream() {}

    // [ostream::sentry]: a stream that is not good writes nothing, and the stream tied to it is flushed first;
    // `unitbuf` flushes at the end.
    class sentry {
        basic_ostream &os_;
        bool ok_;

    public:
        explicit sentry(basic_ostream &os) : os_(os), ok_(false) {
            if (!os.good()) return;
            if (os.tie() != 0) os.tie()->flush();
            ok_ = os.good();
        }
        ~sentry() {
            if ((os_.flags() & ios_base::unitbuf) != 0 && !std::uncaught_exception() && os_.good()) os_.flush();
        }
        explicit operator bool() const { return ok_; }
        sentry(const sentry &) = delete;
        sentry &operator=(const sentry &) = delete;
    };

    // [ostream.inserters.arithmetic]: in hexadecimal and octal a signed value prints its unsigned
    // reinterpretation, converted through the corresponding unsigned type.
    basic_ostream &operator<<(bool v) { return numbered(v); }
    basic_ostream &operator<<(short v) {
        const ios_base::fmtflags b = this->flags() & ios_base::basefield;
        return numbered(b == ios_base::oct || b == ios_base::hex ? static_cast<long>(static_cast<unsigned short>(v)) : static_cast<long>(v));
    }
    basic_ostream &operator<<(unsigned short v) { return numbered(static_cast<unsigned long>(v)); }
    basic_ostream &operator<<(int v) {
        const ios_base::fmtflags b = this->flags() & ios_base::basefield;
        return numbered(b == ios_base::oct || b == ios_base::hex ? static_cast<long>(static_cast<unsigned int>(v)) : static_cast<long>(v));
    }
    basic_ostream &operator<<(unsigned int v) { return numbered(static_cast<unsigned long>(v)); }
    basic_ostream &operator<<(long v) { return numbered(v); }
    basic_ostream &operator<<(unsigned long v) { return numbered(v); }
    basic_ostream &operator<<(long long v) { return numbered(v); }
    basic_ostream &operator<<(unsigned long long v) { return numbered(v); }
    basic_ostream &operator<<(float v) { return numbered(static_cast<double>(v)); }
    basic_ostream &operator<<(double v) { return numbered(v); }
    basic_ostream &operator<<(long double v) { return numbered(v); }
    basic_ostream &operator<<(const void *p) { return numbered(p); }
    // [ostream.inserters]/7: everything the buffer will give, to the end; nothing inserted is failbit.
    basic_ostream &operator<<(basic_streambuf<C, Tr> *sb) {
        sentry ok(*this);
        if (!ok) return *this;
        if (sb == 0) { this->setstate(ios_base::badbit); return *this; }
        bool any = false;
        for (;;) {
            const int_type c = sb->sgetc();
            if (Tr::eq_int_type(c, Tr::eof())) break;
            if (Tr::eq_int_type(this->rdbuf()->sputc(Tr::to_char_type(c)), Tr::eof())) break;
            any = true;
            sb->sbumpc();
        }
        if (!any) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_ostream &operator<<(basic_ostream &(*pf)(basic_ostream &)) { return pf(*this); }
    basic_ostream &operator<<(basic_ios<C, Tr> &(*pf)(basic_ios<C, Tr> &)) { pf(*this); return *this; }
    basic_ostream &operator<<(ios_base &(*pf)(ios_base &)) { pf(*this); return *this; }

    // [ostream.unformatted]
    basic_ostream &put(char_type c) {
        sentry ok(*this);
        if (ok && Tr::eq_int_type(this->rdbuf()->sputc(c), Tr::eof())) this->setstate(ios_base::badbit);
        return *this;
    }
    basic_ostream &write(const char_type *s, streamsize n) {
        sentry ok(*this);
        if (ok && n > 0 && this->rdbuf()->sputn(s, n) != n) this->setstate(ios_base::badbit);
        return *this;
    }
    basic_ostream &flush() {
        if (this->rdbuf() != 0 && this->rdbuf()->pubsync() == -1) this->setstate(ios_base::badbit);
        return *this;
    }

    // [ostream.seeks]
    pos_type tellp() {
        if (this->fail()) return pos_type(-1);
        return this->rdbuf()->pubseekoff(0, ios_base::cur, ios_base::out);
    }
    basic_ostream &seekp(pos_type pos) {
        if (!this->fail() && this->rdbuf()->pubseekpos(pos, ios_base::out) == pos_type(-1)) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_ostream &seekp(off_type off, ios_base::seekdir dir) {
        if (!this->fail() && this->rdbuf()->pubseekoff(off, dir, ios_base::out) == pos_type(-1)) this->setstate(ios_base::failbit);
        return *this;
    }

    // [ostream.formatted.reqmts]/3 and stage 3 of [facet.num.put.virtuals]: padded to the width with the fill -
    // after the text for `left`, at `split` for `internal` (after a sign or `0x`), before it otherwise - and the
    // width forgotten. __cxx1_nfield's text is narrow - a number's, `true` - and widened character by character.
    basic_ostream &__cxx1_field(const char_type *s, std::size_t n, std::size_t split) { return field_(s, 0, n, split); }
    basic_ostream &__cxx1_nfield(const char *s, std::size_t n, std::size_t split) { return field_(0, s, n, split); }

protected:
    basic_ostream() {}
    basic_ostream(const basic_ostream &) = delete;
    basic_ostream(basic_ostream &&rhs) { basic_ios<C, Tr>::move(rhs); }
    basic_ostream &operator=(const basic_ostream &) = delete;
    basic_ostream &operator=(basic_ostream &&rhs) { swap(rhs); return *this; }
    void swap(basic_ostream &rhs) { basic_ios<C, Tr>::swap(rhs); }

private:
    void put_(const char_type *s, std::size_t n) {
        if (n != 0 && this->rdbuf()->sputn(s, static_cast<streamsize>(n)) != static_cast<streamsize>(n)) this->setstate(ios_base::badbit);
    }
    // One of `wide` and `narrow` is the text, the other null.
    basic_ostream &field_(const char_type *wide, const char *narrow, std::size_t n, std::size_t split) {
        sentry ok(*this);
        if (!ok) return *this;
        const ios_base::fmtflags adjust = this->flags() & ios_base::adjustfield;
        const std::size_t width = this->width() > 0 ? static_cast<std::size_t>(this->width()) : 0;
        const std::size_t pad = width > n ? width - n : 0;
        this->width(0);
        const std::size_t at = adjust == ios_base::left ? n : adjust == ios_base::internal ? split : 0;
        put_(wide, narrow, 0, at);
        const char_type f = this->fill();
        for (std::size_t i = 0; i < pad; i++) put_(&f, 1);
        put_(wide, narrow, at, n);
        return *this;
    }
    void put_(const char_type *wide, const char *narrow, std::size_t from, std::size_t to) {
        if (wide != 0) { put_(wide + from, to - from); return; }
        for (std::size_t i = from; i < to; i++) {
            const char_type c = this->widen(narrow[i]);
            put_(&c, 1);
        }
    }
    // [ostream.inserters.arithmetic]: through the num_put facet; a buffer that will not take it all is badbit.
    template <class V> basic_ostream &numbered(V v) {
        sentry ok(*this);
        if (!ok) return *this;
        typedef ostreambuf_iterator<C, Tr> It;
        if (use_facet<num_put<C, It> >(this->ios_base::loc_).put(It(*this), *this, this->fill(), v).failed())
            this->setstate(ios_base::badbit);
        return *this;
    }
};

// [ostream.inserters.character]
template <class C, class Tr> basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &out, C c) { return out.__cxx1_field(&c, 1, 0); }
template <class C, class Tr> basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &out, char c) {
    const C w = out.widen(c);
    return out.__cxx1_field(&w, 1, 0);
}
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, char c) { return out.__cxx1_field(&c, 1, 0); }
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, signed char c) {
    const char n = static_cast<char>(c);
    return out.__cxx1_field(&n, 1, 0);
}
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, unsigned char c) {
    const char n = static_cast<char>(c);
    return out.__cxx1_field(&n, 1, 0);
}
template <class C, class Tr> basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &out, const C *s) {
    if (s == 0) { out.setstate(ios_base::badbit); return out; }
    return out.__cxx1_field(s, Tr::length(s), 0);
}
template <class C, class Tr> basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &out, const char *s) {
    if (s == 0) { out.setstate(ios_base::badbit); return out; }
    return out.__cxx1_nfield(s, std::strlen(s), 0);
}
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, const char *s) {
    if (s == 0) { out.setstate(ios_base::badbit); return out; }
    return out.__cxx1_field(s, std::strlen(s), 0);
}
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, const signed char *s) {
    return out << reinterpret_cast<const char *>(s);
}
template <class Tr> basic_ostream<char, Tr> &operator<<(basic_ostream<char, Tr> &out, const unsigned char *s) {
    return out << reinterpret_cast<const char *>(s);
}

// [ostream.rvalue]: an rvalue stream, as `std::ostringstream() << 1`.
template <class C, class Tr, class T> basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &&out, const T &x) {
    out << x;
    return out;
}

// [ostream.manip]
template <class C, class Tr> basic_ostream<C, Tr> &endl(basic_ostream<C, Tr> &o) { o.put(o.widen('\n')); o.flush(); return o; }
template <class C, class Tr> basic_ostream<C, Tr> &ends(basic_ostream<C, Tr> &o) { o.put(C()); return o; }
template <class C, class Tr> basic_ostream<C, Tr> &flush(basic_ostream<C, Tr> &o) { o.flush(); return o; }

}  // namespace std

#endif
