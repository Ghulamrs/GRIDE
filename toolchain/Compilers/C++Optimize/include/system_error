// <system_error> - [syserr]: error codes, error conditions, their categories, and system_error.
//
// generic_category's numbers are errno's, its messages strerror's. system_category's are the operating
// system's: errno again on POSIX, GetLastError's on Windows, whose messages come from FormatMessage and
// whose common numbers map to errc conditions. Each category is a function-local static, so an inline
// function gives every translation unit the one object [syserr.errcat.objects]/1 compares by address.
#ifndef _CXX1_SYSTEM_ERROR
#define _CXX1_SYSTEM_ERROR

#include <cerrno>
#include <cstring>
#include <stdexcept>
#include <string>
#include <type_traits>

namespace std {

#if defined(_WIN32)
namespace __cxx1_os {
extern "C" unsigned long FormatMessageA(unsigned long flags, const void *source, unsigned long id, unsigned long language,
                                        char *buffer, unsigned long size, void *arguments);
}
#endif

class error_category;
class error_code;
class error_condition;

template <class T> struct is_error_code_enum : false_type {};
template <class T> struct is_error_condition_enum : false_type {};

// [syserr]/2
