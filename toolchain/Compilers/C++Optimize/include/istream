// <istream> - [input.streams]: basic_istream, its sentry, the extractors, basic_iostream and ws.
//
// **Every character comes from the stream's buffer**, sgetc to look and sbumpc to take. A number is the stream's
// locale's num_get's to read, and whitespace its ctype's to tell.
#ifndef _CXX1_ISTREAM
#define _CXX1_ISTREAM

#include <cctype>
#include <climits>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <ios>
#include <ostream>
#include <__num_facets>
#include <streambuf>
#include <string>

namespace std {

template <class C, class Tr> class basic_istream : virtual public basic_ios<C, Tr> {
public:
    typedef C char_type;
    typedef typename Tr::int_type int_type;
    typedef typename Tr::pos_type pos_type;
    typedef typename Tr::off_type off_type;
    typedef Tr traits_type;

    explicit basic_istream(basic_streambuf<C, Tr> *sb) : count_(0) { this->init(sb); }
    virtual ~basic_istream() {}

    // [istream::sentry]: a stream that is not good fails at once; the tied stream is flushed; a formatted
    // input skips whitespace while `skipws` is set, an end met there being eofbit and failbit.
    class sentry {
        bool ok_;

    public:
        explicit sentry(basic_istream &is, bool noskipws = false) : ok_(false) {
            if (!is.good()) { is.setstate(ios_base::failbit); return; }
            if (is.tie() != 0) is.tie()->flush();
            if (!noskipws && (is.flags() & ios_base::skipws) != 0) {
                basic_streambuf<C, Tr> *sb = is.rdbuf();
                for (;;) {
                    const int_type c = sb->sgetc();
                    if (Tr::eq_int_type(c, Tr::eof())) { is.setstate(ios_base::eofbit | ios_base::failbit); return; }
                    if (!is.__cxx1_space(Tr::to_char_type(c))) break;
                    sb->sbumpc();
                }
            }
            ok_ = is.good();
        }
        explicit operator bool() const { return ok_; }
        sentry(const sentry &) = delete;
        sentry &operator=(const sentry &) = delete;
    };

    // [istream.formatted.arithmetic]: through the num_get facet; short and int read as long and checked against
    // their range, the nearest limit stored and a failure where it is out of it.
    basic_istream &operator>>(bool &v) { return numbered(v); }
    basic_istream &operator>>(short &v) { return narrowed(v, SHRT_MIN, SHRT_MAX); }
    basic_istream &operator>>(unsigned short &v) { return numbered(v); }
    basic_istream &operator>>(int &v) { return narrowed(v, INT_MIN, INT_MAX); }
    basic_istream &operator>>(unsigned int &v) { return numbered(v); }
    basic_istream &operator>>(long &v) { return numbered(v); }
    basic_istream &operator>>(unsigned long &v) { return numbered(v); }
    basic_istream &operator>>(long long &v) { return numbered(v); }
    basic_istream &operator>>(unsigned long long &v) { return numbered(v); }
    basic_istream &operator>>(float &v) { return numbered(v); }
    basic_istream &operator>>(double &v) { return numbered(v); }
    basic_istream &operator>>(long double &v) { return numbered(v); }
    basic_istream &operator>>(void *&v) { return numbered(v); }
    basic_istream &operator>>(basic_streambuf<C, Tr> *sb) {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return *this;
        if (sb == 0) { this->setstate(ios_base::failbit); return *this; }
        for (;;) {
            const int_type c = this->rdbuf()->sgetc();
            if (Tr::eq_int_type(c, Tr::eof())) { this->setstate(ios_base::eofbit); break; }
            if (Tr::eq_int_type(sb->sputc(Tr::to_char_type(c)), Tr::eof())) break;
            this->rdbuf()->sbumpc();
            count_++;
        }
        if (count_ == 0) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_istream &operator>>(basic_istream &(*pf)(basic_istream &)) { return pf(*this); }
    basic_istream &operator>>(basic_ios<C, Tr> &(*pf)(basic_ios<C, Tr> &)) { pf(*this); return *this; }
    basic_istream &operator>>(ios_base &(*pf)(ios_base &)) { pf(*this); return *this; }

    // [istream.unformatted]
    streamsize gcount() const { return count_; }
    int_type get() {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return Tr::eof();
        const int_type c = get_();
        if (Tr::eq_int_type(c, Tr::eof())) this->setstate(ios_base::eofbit | ios_base::failbit);
        else count_ = 1;
        return c;
    }
    basic_istream &get(char_type &c) {
        const int_type v = get();
        if (!Tr::eq_int_type(v, Tr::eof())) c = Tr::to_char_type(v);
        return *this;
    }
    basic_istream &get(char_type *s, streamsize n, char_type delim) {
        count_ = 0;
        sentry ok(*this, true);
        if (ok) {
            while (count_ + 1 < n) {
                const int_type c = this->rdbuf()->sgetc();
                if (Tr::eq_int_type(c, Tr::eof())) { this->setstate(ios_base::eofbit); break; }
                if (Tr::eq(Tr::to_char_type(c), delim)) break;
                s[count_++] = Tr::to_char_type(c);
                this->rdbuf()->sbumpc();
            }
        }
        if (n > 0) s[count_] = char_type();
        if (count_ == 0) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_istream &get(char_type *s, streamsize n) { return get(s, n, this->widen('\n')); }
    basic_istream &get(basic_streambuf<C, Tr> &sb, char_type delim) {
        count_ = 0;
        sentry ok(*this, true);
        if (ok) {
            for (;;) {
                const int_type c = this->rdbuf()->sgetc();
                if (Tr::eq_int_type(c, Tr::eof())) { this->setstate(ios_base::eofbit); break; }
                if (Tr::eq(Tr::to_char_type(c), delim)) break;
                if (Tr::eq_int_type(sb.sputc(Tr::to_char_type(c)), Tr::eof())) break;
                this->rdbuf()->sbumpc();
                count_++;
            }
        }
        if (count_ == 0) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_istream &get(basic_streambuf<C, Tr> &sb) { return get(sb, this->widen('\n')); }
    basic_istream &getline(char_type *s, streamsize n, char_type delim) {
        count_ = 0;
        streamsize stored = 0;
        sentry ok(*this, true);
        if (ok) {
            for (;;) {
                const int_type c = this->rdbuf()->sgetc();
                if (Tr::eq_int_type(c, Tr::eof())) { this->setstate(ios_base::eofbit); break; }
                if (Tr::eq(Tr::to_char_type(c), delim)) { this->rdbuf()->sbumpc(); count_++; break; }
                if (stored + 1 >= n) { this->setstate(ios_base::failbit); break; }
                s[stored++] = Tr::to_char_type(c);
                count_++;
                this->rdbuf()->sbumpc();
            }
        }
        if (n > 0) s[stored] = char_type();
        if (count_ == 0) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_istream &getline(char_type *s, streamsize n) { return getline(s, n, this->widen('\n')); }
    basic_istream &ignore(streamsize n = 1, int_type delim = Tr::eof()) {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return *this;
        const bool forever = n == static_cast<streamsize>(~0ULL >> 1);
        while (forever || count_ < n) {
            const int_type c = this->rdbuf()->sbumpc();
            if (Tr::eq_int_type(c, Tr::eof())) { this->setstate(ios_base::eofbit); break; }
            count_++;
            if (!Tr::eq_int_type(delim, Tr::eof()) && Tr::eq_int_type(c, delim)) break;
        }
        return *this;
    }
    int_type peek() {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return Tr::eof();
        const int_type c = this->rdbuf()->sgetc();
        if (Tr::eq_int_type(c, Tr::eof())) this->setstate(ios_base::eofbit);
        return c;
    }
    basic_istream &read(char_type *s, streamsize n) {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return *this;
        count_ = this->rdbuf()->sgetn(s, n);
        if (count_ != n) this->setstate(ios_base::eofbit | ios_base::failbit);
        return *this;
    }
    streamsize readsome(char_type *s, streamsize n) {
        count_ = 0;
        sentry ok(*this, true);
        if (!ok) return 0;
        const streamsize avail = this->rdbuf()->in_avail();
        if (avail == -1) { this->setstate(ios_base::eofbit); return 0; }
        count_ = this->rdbuf()->sgetn(s, avail < n ? avail : n);
        return count_;
    }
    basic_istream &putback(char_type c) {
        count_ = 0;
        this->clear(this->rdstate() & ~ios_base::eofbit);
        sentry ok(*this, true);
        if (ok && Tr::eq_int_type(this->rdbuf()->sputbackc(c), Tr::eof())) this->setstate(ios_base::badbit);
        return *this;
    }
    basic_istream &unget() {
        count_ = 0;
        this->clear(this->rdstate() & ~ios_base::eofbit);
        sentry ok(*this, true);
        if (ok && Tr::eq_int_type(this->rdbuf()->sungetc(), Tr::eof())) this->setstate(ios_base::badbit);
        return *this;
    }
    int sync() {
        if (this->rdbuf() == 0) return -1;
        if (this->rdbuf()->pubsync() == -1) { this->setstate(ios_base::badbit); return -1; }
        return 0;
    }
    // [istream.unformatted]/39-43: unformatted input functions - the sentry first, so a stream at its end fails
    // here - and seekg clears eofbit before it.
    pos_type tellg() {
        const sentry ok(*this, true);
        if (this->fail()) return pos_type(-1);
        return this->rdbuf()->pubseekoff(0, ios_base::cur, ios_base::in);
    }
    basic_istream &seekg(pos_type pos) {
        this->clear(this->rdstate() & ~ios_base::eofbit);
        const sentry ok(*this, true);
        if (!this->fail() && this->rdbuf()->pubseekpos(pos, ios_base::in) == pos_type(-1)) this->setstate(ios_base::failbit);
        return *this;
    }
    basic_istream &seekg(off_type off, ios_base::seekdir dir) {
        this->clear(this->rdstate() & ~ios_base::eofbit);
        const sentry ok(*this, true);
        if (!this->fail() && this->rdbuf()->pubseekoff(off, dir, ios_base::in) == pos_type(-1)) this->setstate(ios_base::failbit);
        return *this;
    }

    // What the string and character extractors below are made of.
    int_type __cxx1_get() { return get_(); }
    void __cxx1_unget() { unget_(); }
    bool __cxx1_space(char_type c) const { return use_facet<ctype<C> >(this->ios_base::loc_).is(ctype_base::space, c); }

protected:
    basic_istream() : count_(0) {}
    basic_istream(const basic_istream &) = delete;
    basic_istream(basic_istream &&rhs) : count_(rhs.count_) { basic_ios<C, Tr>::move(rhs); rhs.count_ = 0; }
    basic_istream &operator=(const basic_istream &) = delete;
    basic_istream &operator=(basic_istream &&rhs) { swap(rhs); return *this; }
    void swap(basic_istream &rhs) { basic_ios<C, Tr>::swap(rhs); std::swap(count_, rhs.count_); }

private:
    streamsize count_;

    int_type get_() { return this->rdbuf()->sbumpc(); }
    void unget_() { this->rdbuf()->sungetc(); }
    template <class V> basic_istream &numbered(V &v) {
        sentry ok(*this);
        if (!ok) return *this;
        ios_base::iostate err = ios_base::goodbit;
        typedef istreambuf_iterator<C, Tr> It;
        use_facet<num_get<C, It> >(this->ios_base::loc_).get(It(*this), It(), *this, err, v);
        this->setstate(err);
        return *this;
    }
    template <class V> basic_istream &narrowed(V &v, long lo, long hi) {
        sentry ok(*this);
        if (!ok) return *this;
        ios_base::iostate err = ios_base::goodbit;
        typedef istreambuf_iterator<C, Tr> It;
        long n = 0;
        use_facet<num_get<C, It> >(this->ios_base::loc_).get(It(*this), It(), *this, err, n);
        if (n < lo) { err |= ios_base::failbit; v = static_cast<V>(lo); }
        else if (n > hi) { err |= ios_base::failbit; v = static_cast<V>(hi); }
        else v = static_cast<V>(n);
        this->setstate(err);
        return *this;
    }
};

// [istream.extractors]/7-12: a character, and a word into an array - whitespace skipped, then up to the next
// whitespace or `width() - 1` characters, a null after them.
template <class C, class Tr> basic_istream<C, Tr> &operator>>(basic_istream<C, Tr> &in, C &c) {
    typename basic_istream<C, Tr>::sentry ok(in);
    if (!ok) return in;
    const typename Tr::int_type v = in.__cxx1_get();
    if (Tr::eq_int_type(v, Tr::eof())) in.setstate(ios_base::eofbit | ios_base::failbit);
    else c = Tr::to_char_type(v);
    return in;
}
template <class Tr> basic_istream<char, Tr> &operator>>(basic_istream<char, Tr> &in, signed char &c) {
    return in >> reinterpret_cast<char &>(c);
}
template <class Tr> basic_istream<char, Tr> &operator>>(basic_istream<char, Tr> &in, unsigned char &c) {
    return in >> reinterpret_cast<char &>(c);
}
template <class C, class Tr> basic_istream<C, Tr> &operator>>(basic_istream<C, Tr> &in, C *s) {
    typename basic_istream<C, Tr>::sentry ok(in);
    if (!ok) return in;
    const streamsize most = in.width() > 0 ? in.width() - 1 : static_cast<streamsize>(~0ULL >> 1);
    streamsize n = 0;
    while (n < most) {
        const typename Tr::int_type c = in.__cxx1_get();
        if (Tr::eq_int_type(c, Tr::eof())) { in.setstate(ios_base::eofbit); break; }
        if (in.__cxx1_space(Tr::to_char_type(c))) { in.__cxx1_unget(); break; }
        s[n++] = Tr::to_char_type(c);
    }
    s[n] = C();
    in.width(0);
    if (n == 0) in.setstate(ios_base::failbit);
    return in;
}
template <class Tr> basic_istream<char, Tr> &operator>>(basic_istream<char, Tr> &in, signed char *s) {
    return in >> reinterpret_cast<char *>(s);
}
template <class Tr> basic_istream<char, Tr> &operator>>(basic_istream<char, Tr> &in, unsigned char *s) {
    return in >> reinterpret_cast<char *>(s);
}

// [istream.rvalue]
template <class C, class Tr, class T> basic_istream<C, Tr> &operator>>(basic_istream<C, Tr> &&in, T &x) {
    in >> x;
    return in;
}

// [istream.manip]
template <class C, class Tr> basic_istream<C, Tr> &ws(basic_istream<C, Tr> &in) {
    typename basic_istream<C, Tr>::sentry ok(in, true);
    if (!ok) return in;
    for (;;) {
        const typename Tr::int_type c = in.rdbuf()->sgetc();
        if (Tr::eq_int_type(c, Tr::eof())) { in.setstate(ios_base::eofbit); break; }
        if (!in.__cxx1_space(Tr::to_char_type(c))) break;
        in.rdbuf()->sbumpc();
    }
    return in;
}

// [iostreamclass]
template <class C, class Tr> class basic_iostream : public basic_istream<C, Tr>, public basic_ostream<C, Tr> {
public:
    typedef C char_type;
    typedef typename Tr::int_type int_type;
    typedef typename Tr::pos_type pos_type;
    typedef typename Tr::off_type off_type;
    typedef Tr traits_type;
    explicit basic_iostream(basic_streambuf<C, Tr> *sb) : basic_istream<C, Tr>(sb), basic_ostream<C, Tr>(sb) {}
    virtual ~basic_iostream() {}

protected:
    basic_iostream(const basic_iostream &) = delete;
    basic_iostream(basic_iostream &&rhs) : basic_istream<C, Tr>(std::move(rhs)), basic_ostream<C, Tr>() {}
    basic_iostream &operator=(const basic_iostream &) = delete;
    basic_iostream &operator=(basic_iostream &&rhs) { swap(rhs); return *this; }
    void swap(basic_iostream &rhs) { basic_istream<C, Tr>::swap(rhs); }
};

}  // namespace std

#endif
