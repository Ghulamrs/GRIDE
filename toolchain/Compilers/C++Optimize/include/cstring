// <cstring> - The byte and string functions, under `std::`.
//
// Note what this is *not*: `<cstring>` is the C header wrapped, and `<string>`
// is a class. They are unrelated headers with confusable names, and a program
// that wants `std::string` and includes this one gets neither an error nor the
// class - which is worth knowing before it happens.
//
// Derived from lib/string.h: every name that header declares is named here, and
// the two are checked against each other by the case that includes both.
#ifndef _CXX1_CSTRING
#define _CXX1_CSTRING

#include <string.h>

namespace std {

using ::size_t;

using ::memcmp;
using ::memcpy;
using ::memmove;
using ::memset;
using ::strcat;
using ::strcmp;
using ::strcoll;
using ::strcpy;
using ::strcspn;
using ::strerror;
using ::strlen;
using ::strncat;
using ::strncmp;
using ::strncpy;
using ::strspn;
using ::strtok;
using ::strxfrm;

// [c.strings]/4: each search function as the const-correct pair C++ declares in place of C's one, over the
// C library's; a search of a const string no longer hands back its characters as writable.
inline const void *memchr(const void *s, int c, size_t n) { return ::memchr(s, c, n); }
inline void *memchr(void *s, int c, size_t n) { return ::memchr(s, c, n); }
inline const char *strchr(const char *s, int c) { return ::strchr(s, c); }
inline char *strchr(char *s, int c) { return ::strchr(s, c); }
inline const char *strpbrk(const char *s, const char *accept) { return ::strpbrk(s, accept); }
inline char *strpbrk(char *s, const char *accept) { return ::strpbrk(s, accept); }
inline const char *strrchr(const char *s, int c) { return ::strrchr(s, c); }
inline char *strrchr(char *s, int c) { return ::strrchr(s, c); }
inline const char *strstr(const char *s, const char *needle) { return ::strstr(s, needle); }
inline char *strstr(char *s, const char *needle) { return ::strstr(s, needle); }

}  // namespace std

#endif
