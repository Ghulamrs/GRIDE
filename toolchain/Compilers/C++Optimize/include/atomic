template <class T> T atomic_exchange_explicit(atomic<T> *a, T v, memory_order m) noexcept { return a->exchange(v, m); }
template <class T> bool atomic_compare_exchange_weak(volatile atomic<T> *a, T *e, T d) noexcept { return a->compare_exchange_weak(*e, d); }
template <class T> bool atomic_compare_exchange_weak(atomic<T> *a, T *e, T d) noexcept { return a->compare_exchange_weak(*e, d); }
