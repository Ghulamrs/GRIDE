// [atomics.types.operations]: the free functions, each the member of the same name.
template <class T> bool atomic_is_lock_free(const volatile atomic<T> *a) noexcept { return a->is_lock_free(); }
template <class T> bool atomic_is_lock_free(const atomic<T> *a) noexcept { return a->is_lock_free(); }
template <class T> void atomic_init(volatile atomic<T> *a, T v) noexcept { a->store(v, memory_order_relaxed); }
template <class T> void atomic_init(atomic<T> *a, T v) noexcept { a->store(v, memory_order_relaxed); }
template <class T> void atomic_store(volatile atomic<T> *a, T v) noexcept { a->store(v); }
template <class T> void atomic_store(atomic<T> *a, T v) noexcept { a->store(v); }
