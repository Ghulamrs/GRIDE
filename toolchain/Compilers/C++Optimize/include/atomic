// <atomic> - [atomics]: atomic types, atomic_flag, the free functions and the fences.
//
// Every operation but atomic_flag's takes the program's one lock (<__threads>): each is then indivisible and
// sequentially consistent, whatever order it is given, and none is lock-free - is_lock_free() says false and
// the ATOMIC_*_LOCK_FREE macros 0, as [atomics.lockfree] allows. atomic_flag is the type [atomics.flag]/2 wants
// lock-free: its exchange is a function the backend writes into each file that calls it.
#ifndef _CXX1_ATOMIC
#define _CXX1_ATOMIC

#include <cstddef>
#include <cstdint>
#include <cstring>
#include <type_traits>
#include <__threads>

namespace std {

// [atomics.order]
typedef enum memory_order {
    memory_order_relaxed, memory_order_consume, memory_order_acquire,
    memory_order_release, memory_order_acq_rel, memory_order_seq_cst
} memory_order;
template <class T> T kill_dependency(T y) noexcept { return y; }

#define ATOMIC_BOOL_LOCK_FREE 0
#define ATOMIC_CHAR_LOCK_FREE 0
#define ATOMIC_CHAR16_T_LOCK_FREE 0
#define ATOMIC_CHAR32_T_LOCK_FREE 0
#define ATOMIC_WCHAR_T_LOCK_FREE 0
#define ATOMIC_SHORT_LOCK_FREE 0
#define ATOMIC_INT_LOCK_FREE 0
#define ATOMIC_LONG_LOCK_FREE 0
#define ATOMIC_LLONG_LOCK_FREE 0
#define ATOMIC_POINTER_LOCK_FREE 0
#define ATOMIC_VAR_INIT(value) { value }
#define ATOMIC_FLAG_INIT { false }

// [atomics.fences]: the lock orders everything, so a fence is taking and leaving it.
inline void atomic_thread_fence(memory_order) noexcept { __cxx1_os::global_guard g; }
inline void atomic_signal_fence(memory_order) noexcept {}

// [atomics.types.generic]: the value, read and written under the lock. compare_exchange compares the object
// representations, [atomics.types.operations.req]/21.
template <class T> struct __cxx1_atomic_base {
    T v_;

    __cxx1_atomic_base() noexcept = default;
    constexpr __cxx1_atomic_base(T v) noexcept : v_(v) {}
    __cxx1_atomic_base(const __cxx1_atomic_base &) = delete;
    __cxx1_atomic_base &operator=(const __cxx1_atomic_base &) = delete;
    __cxx1_atomic_base &operator=(const __cxx1_atomic_base &) volatile = delete;

    bool is_lock_free() const volatile noexcept { return false; }
    bool is_lock_free() const noexcept { return false; }
    void store(T v, memory_order = memory_order_seq_cst) volatile noexcept { __cxx1_os::global_guard g; const_cast<T &>(v_) = v; }
    void store(T v, memory_order = memory_order_seq_cst) noexcept { __cxx1_os::global_guard g; v_ = v; }
    T load(memory_order = memory_order_seq_cst) const volatile noexcept { __cxx1_os::global_guard g; return const_cast<const T &>(v_); }
    T load(memory_order = memory_order_seq_cst) const noexcept { __cxx1_os::global_guard g; return v_; }
    operator T() const volatile noexcept { return load(); }
    operator T() const noexcept { return load(); }
    T exchange(T v, memory_order = memory_order_seq_cst) volatile noexcept {
        __cxx1_os::global_guard g;
        T was = const_cast<T &>(v_);
        const_cast<T &>(v_) = v;
        return was;
    }
    T exchange(T v, memory_order = memory_order_seq_cst) noexcept {
        __cxx1_os::global_guard g;
        T was = v_;
        v_ = v;
        return was;
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order = memory_order_seq_cst) volatile noexcept {
        __cxx1_os::global_guard g;
        T &now = const_cast<T &>(v_);
        if (std::memcmp(&now, &expected, sizeof(T)) == 0) { now = desired; return true; }
        expected = now;
        return false;
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order = memory_order_seq_cst) noexcept {
        __cxx1_os::global_guard g;
        if (std::memcmp(&v_, &expected, sizeof(T)) == 0) { v_ = desired; return true; }
        expected = v_;
        return false;
    }
    bool compare_exchange_strong(T &e, T d, memory_order, memory_order) volatile noexcept { return compare_exchange_strong(e, d); }
    bool compare_exchange_strong(T &e, T d, memory_order, memory_order) noexcept { return compare_exchange_strong(e, d); }
    bool compare_exchange_weak(T &e, T d, memory_order = memory_order_seq_cst) volatile noexcept { return compare_exchange_strong(e, d); }
    bool compare_exchange_weak(T &e, T d, memory_order = memory_order_seq_cst) noexcept { return compare_exchange_strong(e, d); }
    bool compare_exchange_weak(T &e, T d, memory_order, memory_order) volatile noexcept { return compare_exchange_strong(e, d); }
    bool compare_exchange_weak(T &e, T d, memory_order, memory_order) noexcept { return compare_exchange_strong(e, d); }
};

// [atomics.types.int]: the arithmetic and bitwise read-modify-writes.
template <class T> struct __cxx1_atomic_integral : __cxx1_atomic_base<T> {
    typedef __cxx1_atomic_base<T> base;
    __cxx1_atomic_integral() noexcept = default;
    constexpr __cxx1_atomic_integral(T v) noexcept : base(v) {}

#define _CXX1_ATOMIC_RMW(name, op)                                                                        \
    T name(T arg, memory_order = memory_order_seq_cst) volatile noexcept {                               \
        __cxx1_os::global_guard g;                                                                       \
        T &now = const_cast<T &>(this->v_);                                                              \
        const T was = now;                                                                               \
        now = static_cast<T>(was op arg);                                                                \
        return was;                                                                                      \
    }                                                                                                    \
    T name(T arg, memory_order = memory_order_seq_cst) noexcept {                                        \
        __cxx1_os::global_guard g;                                                                       \
        const T was = this->v_;                                                                          \
        this->v_ = static_cast<T>(was op arg);                                                           \
        return was;                                                                                      \
    }
    _CXX1_ATOMIC_RMW(fetch_add, +)
    _CXX1_ATOMIC_RMW(fetch_sub, -)
    _CXX1_ATOMIC_RMW(fetch_and, &)
    _CXX1_ATOMIC_RMW(fetch_or, |)
    _CXX1_ATOMIC_RMW(fetch_xor, ^)
#undef _CXX1_ATOMIC_RMW

    T operator++(int) volatile noexcept { return fetch_add(1); }
    T operator++(int) noexcept { return fetch_add(1); }
    T operator--(int) volatile noexcept { return fetch_sub(1); }
    T operator--(int) noexcept { return fetch_sub(1); }
    T operator++() volatile noexcept { return static_cast<T>(fetch_add(1) + 1); }
    T operator++() noexcept { return static_cast<T>(fetch_add(1) + 1); }
    T operator--() volatile noexcept { return static_cast<T>(fetch_sub(1) - 1); }
    T operator--() noexcept { return static_cast<T>(fetch_sub(1) - 1); }
    T operator+=(T a) volatile noexcept { return static_cast<T>(fetch_add(a) + a); }
    T operator+=(T a) noexcept { return static_cast<T>(fetch_add(a) + a); }
    T operator-=(T a) volatile noexcept { return static_cast<T>(fetch_sub(a) - a); }
    T operator-=(T a) noexcept { return static_cast<T>(fetch_sub(a) - a); }
    T operator&=(T a) volatile noexcept { return static_cast<T>(fetch_and(a) & a); }
    T operator&=(T a) noexcept { return static_cast<T>(fetch_and(a) & a); }
    T operator|=(T a) volatile noexcept { return static_cast<T>(fetch_or(a) | a); }
    T operator|=(T a) noexcept { return static_cast<T>(fetch_or(a) | a); }
    T operator^=(T a) volatile noexcept { return static_cast<T>(fetch_xor(a) ^ a); }
    T operator^=(T a) noexcept { return static_cast<T>(fetch_xor(a) ^ a); }
};

template <class T, bool = is_integral<T>::value && !is_same<T, bool>::value> struct __cxx1_atomic_pick {
    typedef __cxx1_atomic_base<T> type;
};
template <class T> struct __cxx1_atomic_pick<T, true> { typedef __cxx1_atomic_integral<T> type; };

template <class T> struct atomic : __cxx1_atomic_pick<T>::type {
    typedef typename __cxx1_atomic_pick<T>::type base;
    atomic() noexcept = default;
    constexpr atomic(T v) noexcept : base(v) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    atomic &operator=(const atomic &) volatile = delete;
    T operator=(T v) volatile noexcept { this->store(v); return v; }
    T operator=(T v) noexcept { this->store(v); return v; }
};

// [atomics.types.pointer]
template <class T> struct atomic<T *> : __cxx1_atomic_base<T *> {
    typedef __cxx1_atomic_base<T *> base;
    atomic() noexcept = default;
    constexpr atomic(T *v) noexcept : base(v) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    atomic &operator=(const atomic &) volatile = delete;
    T *operator=(T *v) volatile noexcept { this->store(v); return v; }
    T *operator=(T *v) noexcept { this->store(v); return v; }
    T *fetch_add(ptrdiff_t d, memory_order = memory_order_seq_cst) volatile noexcept {
        __cxx1_os::global_guard g;
        T *&now = const_cast<T *&>(this->v_);
        T *was = now;
        now = was + d;
        return was;
    }
    T *fetch_add(ptrdiff_t d, memory_order = memory_order_seq_cst) noexcept {
        __cxx1_os::global_guard g;
        T *was = this->v_;
        this->v_ = was + d;
        return was;
    }
    T *fetch_sub(ptrdiff_t d, memory_order m = memory_order_seq_cst) volatile noexcept { return fetch_add(-d, m); }
    T *fetch_sub(ptrdiff_t d, memory_order m = memory_order_seq_cst) noexcept { return fetch_add(-d, m); }
    T *operator++(int) volatile noexcept { return fetch_add(1); }
    T *operator++(int) noexcept { return fetch_add(1); }
    T *operator--(int) volatile noexcept { return fetch_sub(1); }
    T *operator--(int) noexcept { return fetch_sub(1); }
    T *operator++() volatile noexcept { return fetch_add(1) + 1; }
    T *operator++() noexcept { return fetch_add(1) + 1; }
    T *operator--() volatile noexcept { return fetch_sub(1) - 1; }
    T *operator--() noexcept { return fetch_sub(1) - 1; }
    T *operator+=(ptrdiff_t d) volatile noexcept { return fetch_add(d) + d; }
    T *operator+=(ptrdiff_t d) noexcept { return fetch_add(d) + d; }
    T *operator-=(ptrdiff_t d) volatile noexcept { return fetch_sub(d) - d; }
    T *operator-=(ptrdiff_t d) noexcept { return fetch_sub(d) - d; }
};

