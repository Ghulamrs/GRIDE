template <class T> void atomic_store_explicit(atomic<T> *a, T v, memory_order m) noexcept { a->store(v, m); }
template <class T> T atomic_load(const volatile atomic<T> *a) noexcept { return a->load(); }
template <class T> T atomic_load(const atomic<T> *a) noexcept { return a->load(); }
template <class T> T atomic_load_explicit(const volatile atomic<T> *a, memory_order m) noexcept { return a->load(m); }
