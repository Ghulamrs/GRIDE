#define _CXX1_ATOMIC_FETCH(name)                                                                             \
    template <class A, class D> auto atomic_##name(volatile A *a, D d) noexcept -> decltype(a->name(d)) { return a->name(d); } \
    template <class A, class D> auto atomic_##name(A *a, D d) noexcept -> decltype(a->name(d)) { return a->name(d); }          \
    template <class A, class D> auto atomic_##name##_explicit(volatile A *a, D d, memory_order m) noexcept -> decltype(a->name(d, m)) { \
        return a->name(d, m);                                                                                \
    }                                                                                                        \
    template <class A, class D> auto atomic_##name##_explicit(A *a, D d, memory_order m) noexcept -> decltype(a->name(d, m)) { \
        return a->name(d, m);                                                                                \
    }
_CXX1_ATOMIC_FETCH(fetch_add)
_CXX1_ATOMIC_FETCH(fetch_sub)
_CXX1_ATOMIC_FETCH(fetch_and)
_CXX1_ATOMIC_FETCH(fetch_or)
_CXX1_ATOMIC_FETCH(fetch_xor)
#undef _CXX1_ATOMIC_FETCH

// [atomics.flag]
extern "C" bool __cxx1_flag_exchange(volatile bool *, bool) noexcept;
typedef struct atomic_flag {
    bool f_;

    atomic_flag() noexcept = default;
    atomic_flag(const atomic_flag &) = delete;
    atomic_flag &operator=(const atomic_flag &) = delete;
    atomic_flag &operator=(const atomic_flag &) volatile = delete;
    bool test_and_set(memory_order = memory_order_seq_cst) volatile noexcept { return __cxx1_flag_exchange(&f_, true); }
    bool test_and_set(memory_order = memory_order_seq_cst) noexcept { return __cxx1_flag_exchange(&f_, true); }
    void clear(memory_order = memory_order_seq_cst) volatile noexcept { __cxx1_flag_exchange(&f_, false); }
    void clear(memory_order = memory_order_seq_cst) noexcept { __cxx1_flag_exchange(&f_, false); }
} atomic_flag;

inline bool atomic_flag_test_and_set(volatile atomic_flag *f) noexcept { return f->test_and_set(); }
inline bool atomic_flag_test_and_set(atomic_flag *f) noexcept { return f->test_and_set(); }
inline bool atomic_flag_test_and_set_explicit(volatile atomic_flag *f, memory_order m) noexcept { return f->test_and_set(m); }
inline bool atomic_flag_test_and_set_explicit(atomic_flag *f, memory_order m) noexcept { return f->test_and_set(m); }
inline void atomic_flag_clear(volatile atomic_flag *f) noexcept { f->clear(); }
inline void atomic_flag_clear(atomic_flag *f) noexcept { f->clear(); }
inline void atomic_flag_clear_explicit(volatile atomic_flag *f, memory_order m) noexcept { f->clear(m); }
