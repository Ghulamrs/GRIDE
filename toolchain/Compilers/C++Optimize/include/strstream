// <strstream> - [depr.str.strstreams]: streams over a char array the program owns, or over one the buffer
// grows itself until str() freezes it.
#ifndef _CXX1_STRSTREAM
#define _CXX1_STRSTREAM

#include <climits>
#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <istream>
#include <ostream>
#include <streambuf>

namespace std {

class strstreambuf : public basic_streambuf<char, char_traits<char> > {
public:
    explicit strstreambuf(streamsize alsize_arg = 0)
        : dynamic_(true), constant_(false), frozen_(false), allocated_(false), alsize_(alsize_arg), palloc_(0),
          pfree_(0), beg_(0) {}
    strstreambuf(void *(*palloc_arg)(size_t), void (*pfree_arg)(void *))
        : dynamic_(true), constant_(false), frozen_(false), allocated_(false), alsize_(0), palloc_(palloc_arg),
          pfree_(pfree_arg), beg_(0) {}
    strstreambuf(char *gnext_arg, streamsize n, char *pbeg_arg = 0) { fixed(gnext_arg, n, pbeg_arg, false); }
    strstreambuf(const char *gnext_arg, streamsize n) { fixed(const_cast<char *>(gnext_arg), n, 0, true); }
    strstreambuf(signed char *gnext_arg, streamsize n, signed char *pbeg_arg = 0) {
        fixed(reinterpret_cast<char *>(gnext_arg), n, reinterpret_cast<char *>(pbeg_arg), false);
    }
    strstreambuf(const signed char *gnext_arg, streamsize n) {
        fixed(const_cast<char *>(reinterpret_cast<const char *>(gnext_arg)), n, 0, true);
    }
    strstreambuf(unsigned char *gnext_arg, streamsize n, unsigned char *pbeg_arg = 0) {
        fixed(reinterpret_cast<char *>(gnext_arg), n, reinterpret_cast<char *>(pbeg_arg), false);
    }
    strstreambuf(const unsigned char *gnext_arg, streamsize n) {
        fixed(const_cast<char *>(reinterpret_cast<const char *>(gnext_arg)), n, 0, true);
    }
    virtual ~strstreambuf() {
        if (allocated_ && !frozen_) release(beg_);
    }

    // [depr.strstreambuf.members]
    void freeze(bool freezefl = true) {
        if (dynamic_) frozen_ = freezefl;
    }
    char *str() {
        freeze();
        return beg_;
    }
    int pcount() const { return pptr() == 0 ? 0 : static_cast<int>(pptr() - pbase()); }

protected:
    // [depr.strstreambuf.virtuals]/1-8: a full dynamic array not frozen grows, keeping every position.
    virtual int_type overflow(int_type c = EOF) {
        if (c == EOF) return 0;
        if (pptr() == epptr()) {
            if (!dynamic_ || frozen_) return EOF;
            const streamsize used = pptr() == 0 ? 0 : epptr() - beg_;
            streamsize size = used * 2;
            if (size < alsize_) size = alsize_;
            if (size < 16) size = 16;
            char *grown = acquire(static_cast<size_t>(size));
            if (grown == 0) return EOF;
            if (used != 0) std::memcpy(grown, beg_, static_cast<size_t>(used));
            const streamsize g = gptr() == 0 ? 0 : gptr() - beg_, eg = egptr() == 0 ? 0 : egptr() - beg_;
            const streamsize p = pptr() == 0 ? 0 : pptr() - beg_;
            if (allocated_) release(beg_);
            beg_ = grown;
            allocated_ = true;
            setp(beg_, beg_ + size);
            pbump(static_cast<int>(p));
            setg(beg_, beg_ + g, beg_ + eg);
        }
        *pptr() = static_cast<char>(c);
        pbump(1);
        return static_cast<unsigned char>(c);
    }
    virtual int_type pbackfail(int_type c = EOF) {
        if (gptr() == eback()) return EOF;
        if (c == EOF) {
            gbump(-1);
            return 0;
        }
        if (static_cast<char>(c) == gptr()[-1]) {
            gbump(-1);
            return c;
        }
        if (constant_) return EOF;
        gbump(-1);
        *gptr() = static_cast<char>(c);
        return c;
    }
    // What was written past the end of the get area becomes readable.
    virtual int_type underflow() {
        if (gptr() == 0 && beg_ != 0) setg(beg_, beg_, beg_);
        if (gptr() != 0 && gptr() < egptr()) return static_cast<unsigned char>(*gptr());
        if (pptr() != 0 && pptr() > egptr()) {
            setg(eback() == 0 ? beg_ : eback(), gptr() == 0 ? beg_ : gptr(), pptr());
            if (gptr() < egptr()) return static_cast<unsigned char>(*gptr());
        }
        return EOF;
    }
    // [depr.strstreambuf.virtuals]/9-15: positions counted from the array's start, within what has been put
    // or can be read.
    virtual pos_type seekoff(off_type off, ios_base::seekdir way, ios_base::openmode which = ios_base::in | ios_base::out) {
        const bool in = (which & ios_base::in) != 0, out = (which & ios_base::out) != 0;
        if (!in && !out) return pos_type(off_type(-1));
        if (in && out && way == ios_base::cur) return pos_type(off_type(-1));
        char *seekhigh = egptr();
        if (pptr() != 0 && pptr() > seekhigh) seekhigh = pptr();
        if (seekhigh == 0) seekhigh = beg_;
        const off_type high = seekhigh - beg_;
        off_type from = 0;
        if (way == ios_base::cur) from = in ? (gptr() == 0 ? 0 : gptr() - beg_) : (pptr() == 0 ? 0 : pptr() - beg_);
        else if (way == ios_base::end) from = high;
        const off_type to = from + off;
        if (to < 0 || to > high) return pos_type(off_type(-1));
        if (in) {
            if (gptr() == 0) return pos_type(off_type(-1));
            setg(eback(), beg_ + to, seekhigh > egptr() ? seekhigh : egptr());
        }
        if (out) {
            if (pptr() == 0 || beg_ + to < pbase()) return pos_type(off_type(-1));
            const char *top = epptr();
            setp(pbase(), const_cast<char *>(top));
            pbump(static_cast<int>(beg_ + to - pbase()));
        }
        return pos_type(to);
    }
    virtual pos_type seekpos(pos_type sp, ios_base::openmode which = ios_base::in | ios_base::out) {
        return seekoff(off_type(sp), ios_base::beg, which);
    }
    virtual basic_streambuf<char, char_traits<char> > *setbuf(char *, streamsize) { return this; }

private:
    strstreambuf(const strstreambuf &);
    strstreambuf &operator=(const strstreambuf &);

    // [depr.strstreambuf.cons]/3-5: N is n, the string's length for 0, unbounded for a negative n; the get area
    // runs to the put area's start where there is one.
    void fixed(char *gnext, streamsize n, char *pbeg, bool isConstant) {
        dynamic_ = false;
        constant_ = isConstant;
        frozen_ = false;
        allocated_ = false;
        alsize_ = 0;
        palloc_ = 0;
        pfree_ = 0;
        beg_ = gnext;
        const streamsize N = n > 0 ? n : n == 0 ? static_cast<streamsize>(std::strlen(gnext)) : INT_MAX;
        if (pbeg == 0) {
            setg(gnext, gnext, gnext + N);
        } else {
            setg(gnext, gnext, pbeg);
            setp(pbeg, pbeg + N);
        }
    }
    char *acquire(size_t n) { return static_cast<char *>(palloc_ != 0 ? palloc_(n) : std::malloc(n)); }
    void release(char *p) {
        if (pfree_ != 0) pfree_(p);
        else std::free(p);
    }

    bool dynamic_, constant_, frozen_, allocated_;
    streamsize alsize_;
    void *(*palloc_)(size_t);
    void (*pfree_)(void *);
    char *beg_;
};

class istrstream : public basic_istream<char, char_traits<char> > {
public:
    explicit istrstream(const char *s) : basic_istream<char, char_traits<char> >(&sb_), sb_(s, 0) {}
    explicit istrstream(char *s) : basic_istream<char, char_traits<char> >(&sb_), sb_(s, 0) {}
    istrstream(const char *s, streamsize n) : basic_istream<char, char_traits<char> >(&sb_), sb_(s, n) {}
    istrstream(char *s, streamsize n) : basic_istream<char, char_traits<char> >(&sb_), sb_(s, n) {}
    virtual ~istrstream() {}
    strstreambuf *rdbuf() const { return const_cast<strstreambuf *>(&sb_); }
    char *str() { return sb_.str(); }

private:
    strstreambuf sb_;
};

class ostrstream : public basic_ostream<char, char_traits<char> > {
public:
    ostrstream() : basic_ostream<char, char_traits<char> >(&sb_) {}
    // [depr.ostrstream.cons]/2: with `app` the writing starts at the string's end.
    ostrstream(char *s, int n, ios_base::openmode mode = ios_base::out)
        : basic_ostream<char, char_traits<char> >(&sb_), sb_(s, n, (mode & ios_base::app) != 0 ? s + std::strlen(s) : s) {}
    virtual ~ostrstream() {}
    strstreambuf *rdbuf() const { return const_cast<strstreambuf *>(&sb_); }
    void freeze(bool freezefl = true) { sb_.freeze(freezefl); }
    char *str() { return sb_.str(); }
    int pcount() const { return sb_.pcount(); }

private:
    strstreambuf sb_;
};

class strstream : public basic_iostream<char, char_traits<char> > {
public:
    typedef char char_type;
    typedef char_traits<char>::int_type int_type;
    typedef char_traits<char>::pos_type pos_type;
    typedef char_traits<char>::off_type off_type;

    strstream() : basic_iostream<char, char_traits<char> >(&sb_) {}
    strstream(char *s, int n, ios_base::openmode mode = ios_base::in | ios_base::out)
        : basic_iostream<char, char_traits<char> >(&sb_), sb_(s, n, (mode & ios_base::app) != 0 ? s + std::strlen(s) : s) {}
    virtual ~strstream() {}
    strstreambuf *rdbuf() const { return const_cast<strstreambuf *>(&sb_); }
    void freeze(bool freezefl = true) { sb_.freeze(freezefl); }
    int pcount() const { return sb_.pcount(); }
    char *str() { return sb_.str(); }

private:
    strstreambuf sb_;
};

}  // namespace std

#endif
