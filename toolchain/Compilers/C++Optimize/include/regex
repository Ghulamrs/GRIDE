template <class BidirIt, class Alloc, class charT, class traits>
bool regex_match(BidirIt first, BidirIt last, match_results<BidirIt, Alloc> &m, const basic_regex<charT, traits> &e,
                 regex_constants::match_flag_type flags = regex_constants::match_default) {
    vector<pair<BidirIt, BidirIt> > caps;
