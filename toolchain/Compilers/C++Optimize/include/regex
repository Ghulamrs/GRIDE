template <class BidirIt, class Alloc = allocator<sub_match<BidirIt> > > class match_results {
public:
    typedef sub_match<BidirIt> value_type;
    typedef const value_type &const_reference;
    typedef const_reference reference;
    typedef typename vector<value_type, Alloc>::const_iterator const_iterator;
    typedef const_iterator iterator;
    typedef typename iterator_traits<BidirIt>::difference_type difference_type;
    typedef typename allocator_traits<Alloc>::size_type size_type;
    typedef Alloc allocator_type;
    typedef typename iterator_traits<BidirIt>::value_type char_type;
    typedef basic_string<char_type> string_type;

    explicit match_results(const Alloc &a = Alloc()) : subs_(a), ready_(false) {}
    match_results(const match_results &m) : subs_(m.subs_), prefix_(m.prefix_), suffix_(m.suffix_), null_(m.null_), ready_(m.ready_) {}
    match_results(match_results &&m) noexcept
        : subs_(std::move(m.subs_)), prefix_(m.prefix_), suffix_(m.suffix_), null_(m.null_), ready_(m.ready_) {}
    match_results &operator=(const match_results &m) {
        subs_ = m.subs_; prefix_ = m.prefix_; suffix_ = m.suffix_; null_ = m.null_; ready_ = m.ready_;
        return *this;
    }
    match_results &operator=(match_results &&m) {
        subs_ = std::move(m.subs_); prefix_ = m.prefix_; suffix_ = m.suffix_; null_ = m.null_; ready_ = m.ready_;
        return *this;
    }
    ~match_results() {}

    bool ready() const { return ready_; }
    size_type size() const { return subs_.size(); }
    size_type max_size() const { return subs_.max_size(); }
    bool empty() const { return subs_.empty(); }
    difference_type length(size_type sub = 0) const { return (*this)[sub].length(); }
    difference_type position(size_type sub = 0) const {
        return sub < subs_.size() ? std::distance(base_, subs_[sub].first) : difference_type(-1);
    }
    string_type str(size_type sub = 0) const { return (*this)[sub].str(); }
    const_reference operator[](size_type n) const { return n < subs_.size() ? subs_[n] : null_; }
    const_reference prefix() const { return prefix_; }
    const_reference suffix() const { return suffix_; }
    const_iterator begin() const { return subs_.begin(); }
    const_iterator end() const { return subs_.end(); }
    const_iterator cbegin() const { return subs_.begin(); }
    const_iterator cend() const { return subs_.end(); }

    // [re.results.form]: $& $n $nn $` $' $$ by default; with format_sed, & \n.
    template <class OutputIter>
    OutputIter format(OutputIter out, const char_type *fmt_first, const char_type *fmt_last,
                      regex_constants::match_flag_type flags = regex_constants::format_default) const {
        const ctype<char_type> &ct = use_facet<ctype<char_type> >(locale());
        for (const char_type *p = fmt_first; p != fmt_last; ++p) {
            const char c = ct.narrow(*p, '\0');
            if ((flags & regex_constants::format_sed) != 0) {
                if (c == '&') { out = copy((*this)[0], out); continue; }
                if (c == '\\' && p + 1 != fmt_last) {
                    const char d = ct.narrow(p[1], '\0');
                    if (d >= '0' && d <= '9') { ++p; out = copy((*this)[static_cast<size_type>(d - '0')], out); continue; }
                    ++p;
                    *out++ = *p;
                    continue;
                }
                *out++ = *p;
                continue;
            }
            if (c != '$' || p + 1 == fmt_last) { *out++ = *p; continue; }
            const char d = ct.narrow(p[1], '\0');
            if (d == '$') { ++p; *out++ = *p; continue; }
            if (d == '&') { ++p; out = copy((*this)[0], out); continue; }
            if (d == '`') { ++p; out = copy(prefix_, out); continue; }
            if (d == '\'') { ++p; out = copy(suffix_, out); continue; }
            if (d >= '0' && d <= '9') {
                size_type n = static_cast<size_type>(d - '0');
                ++p;
                if (p + 1 != fmt_last) {
                    const char e = ct.narrow(p[1], '\0');
                    if (e >= '0' && e <= '9' && n * 10 + static_cast<size_type>(e - '0') < size()) {
                        n = n * 10 + static_cast<size_type>(e - '0');
                        ++p;
                    }
                }
                out = copy((*this)[n], out);
                continue;
            }
            *out++ = *p;
        }
        return out;
    }
    template <class OutputIter, class ST, class SA>
    OutputIter format(OutputIter out, const basic_string<char_type, ST, SA> &fmt,
                      regex_constants::match_flag_type flags = regex_constants::format_default) const {
        return format(out, fmt.data(), fmt.data() + fmt.size(), flags);
    }
    template <class ST, class SA>
    basic_string<char_type, ST, SA> format(const basic_string<char_type, ST, SA> &fmt,
                                           regex_constants::match_flag_type flags = regex_constants::format_default) const {
        basic_string<char_type, ST, SA> r;
        format(back_inserter(r), fmt.data(), fmt.data() + fmt.size(), flags);
        return r;
    }
    string_type format(const char_type *fmt, regex_constants::match_flag_type flags = regex_constants::format_default) const {
        string_type r;
        format(back_inserter(r), fmt, fmt + char_traits<char_type>::length(fmt), flags);
        return r;
    }

    allocator_type get_allocator() const { return subs_.get_allocator(); }
    void swap(match_results &that) {
        subs_.swap(that.subs_);
        std::swap(prefix_, that.prefix_);
        std::swap(suffix_, that.suffix_);
        std::swap(null_, that.null_);
        std::swap(ready_, that.ready_);
        std::swap(base_, that.base_);
    }

    // Filled by the algorithms.
    void __cxx1_set(BidirIt base, BidirIt first, BidirIt last, const vector<pair<BidirIt, BidirIt> > &caps,
                    const vector<bool> &set, bool matched) {
        base_ = base;
        ready_ = true;
        subs_.clear();
        null_ = value_type();
        null_.first = null_.second = last;
        if (!matched) {
            prefix_ = value_type();
            suffix_ = value_type();
            return;
        }
        for (size_t i = 0; i < caps.size(); i++) {
            value_type s;
            s.matched = set[i];
            s.first = set[i] ? caps[i].first : last;
            s.second = set[i] ? caps[i].second : last;
            subs_.push_back(s);
        }
        prefix_.first = first;
        prefix_.second = subs_[0].first;
        prefix_.matched = prefix_.first != prefix_.second;
        suffix_.first = subs_[0].second;
        suffix_.second = last;
        suffix_.matched = suffix_.first != suffix_.second;
    }
    void __cxx1_prefix_from(BidirIt from) {
        prefix_.first = from;
        prefix_.matched = prefix_.first != prefix_.second;
    }

private:
    template <class Out> static Out copy(const value_type &s, Out out) {
        for (BidirIt i = s.first; s.matched && i != s.second; ++i) *out++ = *i;
        return out;
    }
    vector<value_type, Alloc> subs_;
    value_type prefix_, suffix_, null_;
    BidirIt base_;
    bool ready_;
};
