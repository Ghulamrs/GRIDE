template <class BidirIt, class Alloc>
bool operator==(const match_results<BidirIt, Alloc> &m1, const match_results<BidirIt, Alloc> &m2) {
    if (m1.empty() != m2.empty() || m1.ready() != m2.ready()) return false;
    if (m1.empty()) return true;
    if (m1.size() != m2.size() || !(m1.prefix() == m2.prefix()) || !(m1.suffix() == m2.suffix())) return false;
    for (size_t i = 0; i < m1.size(); i++)
        if (!(m1[i] == m2[i])) return false;
    return true;
}
