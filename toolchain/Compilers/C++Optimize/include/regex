// <regex> - [re]: regular expressions in the six grammars, matched by a backtracking machine.
//
// A pattern is parsed to a tree and the tree compiled to a small program - characters, classes, splits, saves,
// assertions - run with an explicit stack of the alternatives not yet tried, so a long target takes heap and not
// the C++ stack. Each capture or loop register changed is logged and put back when its alternative fails.
// ECMAScript takes the first match the alternatives' order gives; the POSIX grammars go on to the longest.
#ifndef _CXX1_REGEX
#define _CXX1_REGEX

#include <algorithm>
#include <cstddef>
#include <initializer_list>
#include <iterator>
#include <locale>
#include <memory>
#include <ostream>
#include <stdexcept>
#include <string>
#include <type_traits>
#include <utility>
#include <vector>

namespace std {

namespace regex_constants {
// [re.synopt], [re.matchflag], [re.err]: bitmask types, with their operators.
enum syntax_option_type {
    icase = 1 << 0, nosubs = 1 << 1, optimize = 1 << 2, collate = 1 << 3,
    ECMAScript = 1 << 4, basic = 1 << 5, extended = 1 << 6, awk = 1 << 7, grep = 1 << 8, egrep = 1 << 9
};
enum match_flag_type {
    match_default = 0, match_not_bol = 1 << 0, match_not_eol = 1 << 1, match_not_bow = 1 << 2, match_not_eow = 1 << 3,
    match_any = 1 << 4, match_not_null = 1 << 5, match_continuous = 1 << 6, match_prev_avail = 1 << 7,
    format_default = 0, format_sed = 1 << 8, format_no_copy = 1 << 9, format_first_only = 1 << 10
};
enum error_type {
    error_collate, error_ctype, error_escape, error_backref, error_brack, error_paren, error_brace, error_badbrace,
    error_range, error_space, error_badrepeat, error_complexity, error_stack
};
constexpr syntax_option_type operator&(syntax_option_type a, syntax_option_type b) { return syntax_option_type(int(a) & int(b)); }
constexpr syntax_option_type operator|(syntax_option_type a, syntax_option_type b) { return syntax_option_type(int(a) | int(b)); }
constexpr syntax_option_type operator^(syntax_option_type a, syntax_option_type b) { return syntax_option_type(int(a) ^ int(b)); }
constexpr syntax_option_type operator~(syntax_option_type a) { return syntax_option_type(~int(a) & 0x3FF); }
inline syntax_option_type &operator&=(syntax_option_type &a, syntax_option_type b) { return a = a & b; }
inline syntax_option_type &operator|=(syntax_option_type &a, syntax_option_type b) { return a = a | b; }
inline syntax_option_type &operator^=(syntax_option_type &a, syntax_option_type b) { return a = a ^ b; }
constexpr match_flag_type operator&(match_flag_type a, match_flag_type b) { return match_flag_type(int(a) & int(b)); }
constexpr match_flag_type operator|(match_flag_type a, match_flag_type b) { return match_flag_type(int(a) | int(b)); }
constexpr match_flag_type operator^(match_flag_type a, match_flag_type b) { return match_flag_type(int(a) ^ int(b)); }
constexpr match_flag_type operator~(match_flag_type a) { return match_flag_type(~int(a) & 0x7FF); }
inline match_flag_type &operator&=(match_flag_type &a, match_flag_type b) { return a = a & b; }
inline match_flag_type &operator|=(match_flag_type &a, match_flag_type b) { return a = a | b; }
inline match_flag_type &operator^=(match_flag_type &a, match_flag_type b) { return a = a ^ b; }
}  // namespace regex_constants

// [re.badexp]
class regex_error : public runtime_error {
public:
    explicit regex_error(regex_constants::error_type ecode) : runtime_error(text(ecode)), code_(ecode) {}
    regex_constants::error_type code() const { return code_; }

private:
    static const char *text(regex_constants::error_type e) {
        switch (e) {
        case regex_constants::error_collate: return "regex: an invalid collating element name";
        case regex_constants::error_ctype: return "regex: an invalid character class name";
        case regex_constants::error_escape: return "regex: an invalid escape or a trailing escape";
        case regex_constants::error_backref: return "regex: a back-reference to no group";
        case regex_constants::error_brack: return "regex: unmatched [ or ]";
        case regex_constants::error_paren: return "regex: unmatched ( or )";
        case regex_constants::error_brace: return "regex: unmatched { or }";
        case regex_constants::error_badbrace: return "regex: an invalid range in { }";
        case regex_constants::error_range: return "regex: an invalid character range";
        case regex_constants::error_space: return "regex: out of memory";
        case regex_constants::error_badrepeat: return "regex: a repeat with nothing to repeat";
        case regex_constants::error_complexity: return "regex: the match is too complex";
        default: return "regex: the match needs more stack than it has";
        }
    }
    regex_constants::error_type code_;
};

// [re.traits]
template <class charT> struct regex_traits {
public:
    typedef charT char_type;
    typedef basic_string<charT> string_type;
    typedef locale locale_type;
    // ctype's mask, and one more bit for \w's underscore.
    typedef unsigned int char_class_type;

    regex_traits() {}
    static size_t length(const char_type *p) { return char_traits<charT>::length(p); }
    charT translate(charT c) const { return c; }
    charT translate_nocase(charT c) const { return use_facet<ctype<charT> >(loc_).tolower(c); }
    template <class ForwardIterator> string_type transform(ForwardIterator first, ForwardIterator last) const {
        const string_type s(first, last);
        return use_facet<std::collate<charT> >(loc_).transform(s.data(), s.data() + s.size());
    }
    template <class ForwardIterator> string_type transform_primary(ForwardIterator first, ForwardIterator last) const {
        string_type s(first, last);
        const ctype<charT> &ct = use_facet<ctype<charT> >(loc_);
        for (size_t i = 0; i < s.size(); i++) s[i] = ct.tolower(s[i]);
        return use_facet<std::collate<charT> >(loc_).transform(s.data(), s.data() + s.size());
    }
    // A one-character name is that character; the "C" locale names no others.
    template <class ForwardIterator> string_type lookup_collatename(ForwardIterator first, ForwardIterator last) const {
        const string_type s(first, last);
        return s.size() == 1 ? s : string_type();
    }
    template <class ForwardIterator>
    char_class_type lookup_classname(ForwardIterator first, ForwardIterator last, bool icase = false) const {
        string n;
        const ctype<charT> &ct = use_facet<ctype<charT> >(loc_);
        for (; first != last; ++first) n += ct.narrow(ct.tolower(*first), '?');
        static const char *const names[] = { "alnum", "alpha", "blank", "cntrl", "digit", "graph", "lower", "print",
                                             "punct", "space", "upper", "xdigit", "d", "s", "w" };
        static const char_class_type classes[] = {
            ctype_base::alnum, ctype_base::alpha, ctype_base::blank, ctype_base::cntrl, ctype_base::digit,
            ctype_base::graph, ctype_base::lower, ctype_base::print, ctype_base::punct, ctype_base::space,
            ctype_base::upper, ctype_base::xdigit, ctype_base::digit, ctype_base::space, ctype_base::alnum | 0x10000u };
        for (size_t i = 0; i < sizeof names / sizeof names[0]; i++)
            if (n == names[i]) {
                char_class_type c = classes[i];
                if (icase && (c == ctype_base::lower || c == ctype_base::upper)) c = ctype_base::alpha;
                return c;
            }
        return 0;
    }
    bool isctype(charT c, char_class_type f) const {
        const ctype<charT> &ct = use_facet<ctype<charT> >(loc_);
        if (ct.is(static_cast<ctype_base::mask>(f & 0xFFFFu), c)) return true;
        return (f & 0x10000u) != 0 && c == ct.widen('_');
    }
    int value(charT ch, int radix) const {
        const char c = use_facet<ctype<charT> >(loc_).narrow(ch, '\0');
        const int d = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 : c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
        return d >= 0 && d < radix ? d : -1;
    }
    locale_type imbue(locale_type l) {
        locale_type was = loc_;
        loc_ = l;
        return was;
    }
    locale_type getloc() const { return loc_; }

private:
    locale_type loc_;
};

// The program's instructions: a = argument, b = second target of a split.
enum __cxx1_re_op {
    __re_char, __re_any, __re_class, __re_split, __re_jump, __re_save, __re_match, __re_bol, __re_eol,
    __re_wordb, __re_nwordb, __re_backref, __re_look, __re_nlook, __re_lookend, __re_mark, __re_progress, __re_clear
};
struct __cxx1_re_inst {
    __cxx1_re_op op;
    int a, b;
};
// A bracket expression: its characters, ranges, classes and equivalence keys, and whether it is negated.
template <class charT> struct __cxx1_re_set {
    basic_string<charT> chars;
    vector<pair<charT, charT> > ranges;
    unsigned int classes;
    vector<unsigned int> notClasses;
    vector<basic_string<charT> > equivs;
    bool negated;
    __cxx1_re_set() : classes(0), negated(false) {}
};
// The parse tree.
enum __cxx1_re_kind { __rk_empty, __rk_char, __rk_any, __rk_class, __rk_seq, __rk_alt, __rk_repeat, __rk_group,
                      __rk_bol, __rk_eol, __rk_wordb, __rk_nwordb, __rk_look, __rk_backref };
struct __cxx1_re_node {
    __cxx1_re_kind kind;
    int value;                  // the character, set, group or back-reference number; look's negation
    long lo, hi;                // a repeat's bounds, hi -1 for none
    bool lazy;
    vector<int> kids;
    int firstGroup, lastGroup;  // the groups inside a repeat, cleared at each pass
};

template <class charT, class traits = regex_traits<charT> > class basic_regex;

template <class charT, class traits> class basic_regex {
public:
    typedef charT value_type;
    typedef traits traits_type;
    typedef typename traits::string_type string_type;
    typedef regex_constants::syntax_option_type flag_type;
    typedef typename traits::locale_type locale_type;

    static constexpr flag_type icase = regex_constants::icase;
    static constexpr flag_type nosubs = regex_constants::nosubs;
    static constexpr flag_type optimize = regex_constants::optimize;
    static constexpr flag_type collate = regex_constants::collate;
    static constexpr flag_type ECMAScript = regex_constants::ECMAScript;
    static constexpr flag_type basic = regex_constants::basic;
    static constexpr flag_type extended = regex_constants::extended;
    static constexpr flag_type awk = regex_constants::awk;
    static constexpr flag_type grep = regex_constants::grep;
    static constexpr flag_type egrep = regex_constants::egrep;

    basic_regex() : flags_(regex_constants::ECMAScript), marks_(0), regs_(0) {}
    explicit basic_regex(const charT *p, flag_type f = regex_constants::ECMAScript) { compile(p, p + traits::length(p), f); }
    basic_regex(const charT *p, size_t len, flag_type f) { compile(p, p + len, f); }
    basic_regex(const basic_regex &e)
        : traits_(e.traits_), flags_(e.flags_), marks_(e.marks_), regs_(e.regs_), prog_(e.prog_), sets_(e.sets_) {}
    basic_regex(basic_regex &&e) noexcept : traits_(e.traits_), flags_(e.flags_), marks_(e.marks_), regs_(e.regs_) {
        prog_.swap(e.prog_);
        sets_.swap(e.sets_);
    }
    template <class ST, class SA>
    explicit basic_regex(const basic_string<charT, ST, SA> &p, flag_type f = regex_constants::ECMAScript) {
        compile(p.data(), p.data() + p.size(), f);
    }
    template <class ForwardIterator>
    basic_regex(ForwardIterator first, ForwardIterator last, flag_type f = regex_constants::ECMAScript) {
        const string_type s(first, last);
        compile(s.data(), s.data() + s.size(), f);
    }
    basic_regex(initializer_list<charT> il, flag_type f = regex_constants::ECMAScript) { compile(il.begin(), il.end(), f); }
    ~basic_regex() {}

    basic_regex &operator=(const basic_regex &e) { return assign(e); }
    basic_regex &operator=(basic_regex &&e) noexcept { return assign(std::move(e)); }
    basic_regex &operator=(const charT *p) { return assign(p); }
    basic_regex &operator=(initializer_list<charT> il) { return assign(il); }
    template <class ST, class SA> basic_regex &operator=(const basic_string<charT, ST, SA> &p) { return assign(p); }

    basic_regex &assign(const basic_regex &e) {
        basic_regex t(e);
        swap(t);
        return *this;
    }
    basic_regex &assign(basic_regex &&e) noexcept {
        swap(e);
        return *this;
    }
    basic_regex &assign(const charT *p, flag_type f = regex_constants::ECMAScript) { return assign(p, traits::length(p), f); }
    basic_regex &assign(const charT *p, size_t len, flag_type f) {
        basic_regex t(p, len, f);
        swap(t);
        return *this;
    }
    template <class ST, class SA>
    basic_regex &assign(const basic_string<charT, ST, SA> &s, flag_type f = regex_constants::ECMAScript) {
        return assign(s.data(), s.size(), f);
    }
    template <class InputIterator>
    basic_regex &assign(InputIterator first, InputIterator last, flag_type f = regex_constants::ECMAScript) {
        const string_type s(first, last);
        return assign(s.data(), s.size(), f);
    }
    basic_regex &assign(initializer_list<charT> il, flag_type f = regex_constants::ECMAScript) {
        return assign(il.begin(), il.size(), f);
    }

    unsigned mark_count() const { return marks_; }
    flag_type flags() const { return flags_; }
    locale_type imbue(locale_type loc) {
        prog_.clear();
        sets_.clear();
        marks_ = 0;
        return traits_.imbue(loc);
    }
    locale_type getloc() const { return traits_.getloc(); }
    void swap(basic_regex &e) {
        std::swap(traits_, e.traits_);
        std::swap(flags_, e.flags_);
        std::swap(marks_, e.marks_);
        std::swap(regs_, e.regs_);
        prog_.swap(e.prog_);
        sets_.swap(e.sets_);
    }

    // The machine. A thread is a program counter and a position; the stack holds the alternatives not yet tried,
    // each with the length the undo log had then. Lookahead runs a machine of its own at the same position.
    template <class BidirIt>
    bool __cxx1_run(BidirIt begin, BidirIt first, BidirIt last, regex_constants::match_flag_type flags, bool whole,
                    vector<pair<BidirIt, BidirIt> > &caps, vector<bool> &set) const {
        using namespace regex_constants;
        const size_t ncap = 2 * (static_cast<size_t>(marks_) + 1);
        caps.assign(ncap / 2, make_pair(last, last));
        set.assign(ncap / 2, false);
        if (prog_.empty()) return false;
        vector<BidirIt> slot(ncap, last);
        vector<bool> slotSet(ncap, false);
        vector<BidirIt> regs(static_cast<size_t>(regs_ > 0 ? regs_ : 1), last);
        struct Undo { int kind; size_t index; BidirIt was; bool wasSet; };
        struct Alt { int pc; BidirIt pos; size_t undo; };
        vector<Undo> undo;
        vector<Alt> stack;
        // A lookahead's own frame: where its machine began, and the stack and log it must not reach under.
        struct Look { int resume; bool negated; BidirIt pos; size_t stackBase, undoBase; };
        vector<Look> looks;
        const bool longest = posix();
        bool found = false;
        vector<BidirIt> best;
        vector<bool> bestSet;
        BidirIt bestEnd = first;
        unsigned long steps = 0;
        int pc = 0;
        BidirIt pos = first;
        const BidirIt nullPos = first;
        for (;;) {
            bool ok = true;
            if (++steps > 20000000ul) throw regex_error(error_complexity);
            const __cxx1_re_inst &in = prog_[static_cast<size_t>(pc)];
            switch (in.op) {
            case __re_char:
                if (pos != last && sameChar(*pos, static_cast<charT>(in.a))) { ++pos; pc++; }
                else ok = false;
                break;
            case __re_any: {
                const ctype<charT> &ct = use_facet<ctype<charT> >(traits_.getloc());
                // ECMAScript's . matches no line terminator; POSIX's . matches any character but NUL.
                if (pos != last && (posix() ? *pos != charT() : (*pos != ct.widen('\n') && *pos != ct.widen('\r')))) { ++pos; pc++; }
                else ok = false;
                break;
            }
            case __re_class:
                if (pos != last && inSet(sets_[static_cast<size_t>(in.a)], *pos)) { ++pos; pc++; }
                else ok = false;
                break;
            case __re_split: {
                Alt a = { in.b, pos, undo.size() };
                stack.push_back(a);
                if (stack.size() > 1000000) throw regex_error(error_stack);
                pc = in.a;
                break;
            }
            case __re_jump: pc = in.a; break;
            case __re_save: {
                const size_t k = static_cast<size_t>(in.a);
                if (k < ncap) {
                    Undo u = { 0, k, slot[k], slotSet[k] };
                    undo.push_back(u);
                    slot[k] = pos;
                    slotSet[k] = true;
                }
                pc++;
                break;
            }
            case __re_clear:
                for (int g = in.a; g <= in.b; g++)
                    for (size_t k = static_cast<size_t>(2 * g); k <= static_cast<size_t>(2 * g + 1) && k < ncap; k++) {
                        Undo u = { 0, k, slot[k], slotSet[k] };
                        undo.push_back(u);
                        slot[k] = last;
                        slotSet[k] = false;
                    }
                pc++;
                break;
            case __re_mark: {
                Undo u = { 1, static_cast<size_t>(in.a), regs[static_cast<size_t>(in.a)], false };
                undo.push_back(u);
                regs[static_cast<size_t>(in.a)] = pos;
                pc++;
                break;
            }
            case __re_progress:
                // A pass that consumed nothing ends the loop here, [re.grammar]'s and ECMAScript's empty check.
                if (regs[static_cast<size_t>(in.a)] == pos) ok = false;
                else pc++;
                break;
            case __re_bol:
                // C++11's grammars are not multiline: the start of the sequence alone, [re.matchflag].
                ok = pos == begin && (flags & (match_not_bol | match_prev_avail)) == 0;
                if (ok) pc++;
                break;
            case __re_eol:
                ok = pos == last && (flags & match_not_eol) == 0;
                if (ok) pc++;
                break;
            case __re_wordb:
            case __re_nwordb: {
                bool before = false, after = false;
                if (pos != begin || (flags & match_prev_avail) != 0) {
                    BidirIt q = pos;
                    --q;
                    before = traits_.isctype(*q, ctype_base::alnum | 0x10000u);
                } else if ((flags & match_not_bow) != 0) {
                    before = true;
                }
                if (pos != last) after = traits_.isctype(*pos, ctype_base::alnum | 0x10000u);
                else if ((flags & match_not_eow) != 0) after = true;
                const bool boundary = before != after;
                ok = in.op == __re_wordb ? boundary : !boundary;
                if (ok) pc++;
                break;
            }
            case __re_backref: {
                const size_t k = 2 * static_cast<size_t>(in.a);
                if (!slotSet[k] || !slotSet[k + 1]) { pc++; break; }
                BidirIt s = slot[k];
                BidirIt q = pos;
                for (; s != slot[k + 1]; ++s, ++q)
                    if (q == last || !sameChar(*s, *q)) { ok = false; break; }
                if (ok) { pos = q; pc++; }
                break;
            }
            case __re_look:
            case __re_nlook: {
                Look l = { in.a, in.op == __re_nlook, pos, stack.size(), undo.size() };
                looks.push_back(l);
                // A barrier: failing back to it means the lookahead's body failed.
                Alt a = { -1, pos, undo.size() };
                stack.push_back(a);
                pc++;
                break;
            }
            case __re_lookend: {
                // The body matched: drop its alternatives; a negative lookahead fails, a positive one goes on from
                // where it began, its captures kept.
                const Look l = looks.back();
                looks.pop_back();
                stack.resize(l.stackBase);
                if (l.negated) {
                    ok = false;
                } else {
                    pos = l.pos;
                    pc = l.resume;
                }
                break;
            }
            case __re_match:
                if ((whole && pos != last) || ((flags & match_not_null) != 0 && pos == nullPos)) {
                    ok = false;
                    break;
                }
                if (!longest || (flags & match_any) != 0) {
                    for (size_t g = 0; g < ncap / 2; g++) {
                        caps[g] = make_pair(slot[2 * g], slot[2 * g + 1]);
                        set[g] = slotSet[2 * g] && slotSet[2 * g + 1];
                    }
                    return true;
                }
                if (!found || std::distance(first, pos) > std::distance(first, bestEnd)) {
                    found = true;
                    bestEnd = pos;
                    best = slot;
                    bestSet = slotSet;
                }
                ok = false;
                break;
            }
            if (ok) continue;
            // Back to the latest alternative; a lookahead's barrier reached means its body failed.
            for (;;) {
                if (stack.empty()) {
                    if (!found) return false;
                    for (size_t g = 0; g < ncap / 2; g++) {
                        caps[g] = make_pair(best[2 * g], best[2 * g + 1]);
                        set[g] = bestSet[2 * g] && bestSet[2 * g + 1];
                    }
                    return true;
                }
                const Alt a = stack.back();
                stack.pop_back();
                while (undo.size() > a.undo) {
                    const Undo &u = undo.back();
                    if (u.kind == 0) { slot[u.index] = u.was; slotSet[u.index] = u.wasSet; }
                    else regs[u.index] = u.was;
                    undo.pop_back();
                }
                if (a.pc >= 0) {
                    pc = a.pc;
                    pos = a.pos;
                    break;
                }
                const Look l = looks.back();
                looks.pop_back();
                if (l.negated) {
                    pc = l.resume;
                    pos = l.pos;
                    break;
                }
            }
        }
    }

private:
    bool posix() const {
        return (flags_ & (regex_constants::basic | regex_constants::extended | regex_constants::awk | regex_constants::grep |
                          regex_constants::egrep)) != 0;
    }
    bool bre() const { return (flags_ & (regex_constants::basic | regex_constants::grep)) != 0; }
    bool awkSyntax() const { return (flags_ & regex_constants::awk) != 0; }
    bool icaseOn() const { return (flags_ & regex_constants::icase) != 0; }
    static void fail(regex_constants::error_type e) { throw regex_error(e); }

    // ---- parsing
    struct Parse {
        const charT *p, *end;
        int groups;
        vector<int> closed;
    };
    char nar(charT c) const { return use_facet<ctype<charT> >(traits_.getloc()).narrow(c, '\0'); }
    bool at(const Parse &ps, char c) const { return ps.p != ps.end && nar(*ps.p) == c; }
    bool at2(const Parse &ps, char a, char b) const { return ps.end - ps.p >= 2 && nar(ps.p[0]) == a && nar(ps.p[1]) == b; }
    int node(__cxx1_re_kind k, int value = 0) {
        __cxx1_re_node n;
        n.kind = k;
        n.value = value;
        n.lo = n.hi = 0;
        n.lazy = false;
        n.firstGroup = n.lastGroup = 0;
        tree_.push_back(n);
        return static_cast<int>(tree_.size()) - 1;
    }
    int charNode(charT c) { return node(__rk_char, static_cast<int>(static_cast<typename make_unsigned<charT>::type>(c))); }

    void compile(const charT *first, const charT *last, flag_type f) {
        flags_ = f;
        if ((flags_ & (regex_constants::ECMAScript | regex_constants::basic | regex_constants::extended | regex_constants::awk |
                       regex_constants::grep | regex_constants::egrep)) == 0)
            flags_ = flags_ | regex_constants::ECMAScript;
        prog_.clear();
        sets_.clear();
        tree_.clear();
        regs_ = 0;
        Parse ps;
        ps.p = first;
        ps.end = last;
        ps.groups = 0;
        const int root = disjunction(ps);
        if (ps.p != ps.end) fail(regex_constants::error_paren);
        marks_ = (flags_ & regex_constants::nosubs) != 0 ? 0 : static_cast<unsigned>(ps.groups);
        emit(__re_save, 0);
        gen(root);
        emit(__re_save, 1);
        emit(__re_match);
        tree_.clear();
    }

    bool closes(const Parse &ps) const { return bre() ? at2(ps, '\\', ')') : at(ps, ')'); }
    bool alternates(const Parse &ps) const {
        if ((flags_ & (regex_constants::grep | regex_constants::egrep)) != 0 && at(ps, '\n')) return true;
        return !bre() && at(ps, '|');
    }
    int disjunction(Parse &ps) {
        const int first = alternative(ps);
        if (!alternates(ps)) return first;
        const int alt = node(__rk_alt);
        tree_[static_cast<size_t>(alt)].kids.push_back(first);
        while (alternates(ps)) {
            ++ps.p;
            const int next = alternative(ps);
            tree_[static_cast<size_t>(alt)].kids.push_back(next);
        }
        return alt;
    }
    int alternative(Parse &ps) {
        const int seq = node(__rk_seq);
        bool first = true;
        while (ps.p != ps.end && !alternates(ps) && !closes(ps)) {
            const int t = term(ps, first);
            tree_[static_cast<size_t>(seq)].kids.push_back(t);
            first = false;
        }
        return seq;
    }
    int term(Parse &ps, bool first) {
        if (at(ps, '^') && (!bre() || first)) { ++ps.p; return node(__rk_bol); }
        if (at(ps, '$') && (!bre() || ps.p + 1 == ps.end || (ps.end - ps.p >= 3 && nar(ps.p[1]) == '\\' && nar(ps.p[2]) == ')')))
            { ++ps.p; return node(__rk_eol); }
        if (!posix() && at2(ps, '\\', 'b')) { ps.p += 2; return node(__rk_wordb); }
        if (!posix() && at2(ps, '\\', 'B')) { ps.p += 2; return node(__rk_nwordb); }
        if (!posix() && ps.end - ps.p >= 3 && nar(ps.p[0]) == '(' && nar(ps.p[1]) == '?' &&
            (nar(ps.p[2]) == '=' || nar(ps.p[2]) == '!')) {
            const bool neg = nar(ps.p[2]) == '!';
            ps.p += 3;
            const int look = node(__rk_look, neg ? 1 : 0);
            const int inner = disjunction(ps);
            if (!at(ps, ')')) fail(regex_constants::error_paren);
            ++ps.p;
            tree_[static_cast<size_t>(look)].kids.push_back(inner);
            return look;
        }
        const int groupsBefore = ps.groups;
        int a;
        if (bre() && first && at(ps, '*')) {
            a = charNode(*ps.p);
            ++ps.p;
        } else {
            a = atom(ps);
        }
        return quantified(ps, a, groupsBefore);
    }
    int atom(Parse &ps) {
        const char c = nar(*ps.p);
        if (bre()) {
            if (at2(ps, '\\', '(')) { ps.p += 2; return group(ps, true); }
            if (at2(ps, '\\', '{')) fail(regex_constants::error_badrepeat);
        } else {
            if (c == '(') {
                ++ps.p;
                bool capture = true;
                if (!posix() && at2(ps, '?', ':')) { ps.p += 2; capture = false; }
                return group(ps, capture);
            }
            if (c == '*' || c == '+' || c == '?' || c == '{') fail(regex_constants::error_badrepeat);
            if (c == ')') fail(regex_constants::error_paren);
        }
        if (c == '.') { ++ps.p; return node(__rk_any); }
        if (c == '[') { ++ps.p; return bracket(ps); }
        if (c == '\\') { ++ps.p; return escape(ps); }
        const int n = charNode(*ps.p);
        ++ps.p;
        return n;
    }
    int group(Parse &ps, bool capture) {
        const int n = capture ? ++ps.groups : 0;
        const int inner = disjunction(ps);
        if (!closes(ps)) fail(regex_constants::error_paren);
        ps.p += bre() ? 2 : 1;
        if (n != 0) ps.closed.push_back(n);
        if (n == 0 || (flags_ & regex_constants::nosubs) != 0) return inner;
        const int g = node(__rk_group, n);
        tree_[static_cast<size_t>(g)].kids.push_back(inner);
        return g;
    }
    bool groupClosed(const Parse &ps, int n) const { return std::find(ps.closed.begin(), ps.closed.end(), n) != ps.closed.end(); }

    // Escapes outside a bracket: a back-reference, a class, a control or code, or the character itself.
    int escape(Parse &ps) {
        if (ps.p == ps.end) fail(regex_constants::error_escape);
        const charT wc = *ps.p;
        const char c = nar(wc);
        if (c >= '1' && c <= '9' && (!posix() || bre())) {
            int n = 0;
            while (ps.p != ps.end && nar(*ps.p) >= '0' && nar(*ps.p) <= '9' && (!bre() || n == 0)) {
                n = n * 10 + (nar(*ps.p) - '0');
                ++ps.p;
            }
            if (n > ps.groups || !groupClosed(ps, n)) fail(regex_constants::error_backref);
            return node(__rk_backref, n);
        }
        ++ps.p;
        if (!posix()) {
            unsigned int cls = 0;
            bool neg = false;
            switch (c) {
            case 'd': cls = ctype_base::digit; break;
            case 'D': cls = ctype_base::digit; neg = true; break;
            case 's': cls = ctype_base::space; break;
            case 'S': cls = ctype_base::space; neg = true; break;
            case 'w': cls = ctype_base::alnum | 0x10000u; break;
            case 'W': cls = ctype_base::alnum | 0x10000u; neg = true; break;
            default: break;
            }
            if (cls != 0) {
                __cxx1_re_set<charT> s;
                if (neg) s.notClasses.push_back(cls);
                else s.classes = cls;
                sets_.push_back(s);
                return node(__rk_class, static_cast<int>(sets_.size()) - 1);
            }
        }
        return charNode(escaped(ps, wc, false));
    }
    charT escaped(Parse &ps, charT wc, bool inBracket) {
        const char c = nar(wc);
        const ctype<charT> &ct = use_facet<ctype<charT> >(traits_.getloc());
        if (!posix() || awkSyntax()) {
            switch (c) {
            case 'n': return ct.widen('\n');
            case 't': return ct.widen('\t');
            case 'r': return ct.widen('\r');
            case 'f': return ct.widen('\f');
            case 'v': return ct.widen('\v');
            default: break;
            }
        }
        if (!posix()) {
            if (c == 'b' && inBracket) return ct.widen('\b');
            if (c == '0' && (ps.p == ps.end || nar(*ps.p) < '0' || nar(*ps.p) > '9')) return charT(0);
            if (c == 'c') {
                if (ps.p == ps.end || !ct.is(ctype_base::alpha, *ps.p)) fail(regex_constants::error_escape);
                return charT(nar(*ps.p++) % 32);
            }
            if (c == 'x' || c == 'u') {
                const int digits = c == 'x' ? 2 : 4;
                unsigned long v = 0;
                for (int k = 0; k < digits; k++) {
                    if (ps.p == ps.end) fail(regex_constants::error_escape);
                    const int d = traits_.value(*ps.p, 16);
                    if (d < 0) fail(regex_constants::error_escape);
                    v = v * 16 + static_cast<unsigned long>(d);
                    ++ps.p;
                }
                return charT(v);
            }
            if (ct.is(ctype_base::alnum, wc) || wc == ct.widen('_')) fail(regex_constants::error_escape);
            return wc;
        }
        if (awkSyntax() && c >= '0' && c <= '7') {
            unsigned long v = static_cast<unsigned long>(c - '0');
            for (int k = 0; k < 2 && ps.p != ps.end && nar(*ps.p) >= '0' && nar(*ps.p) <= '7'; k++, ++ps.p)
                v = v * 8 + static_cast<unsigned long>(nar(*ps.p) - '0');
            return charT(v);
        }
        return wc;
    }

    // [re.grammar]/3-11: a bracket's characters, ranges, [:class:], [.name.] and [=equiv=].
    int bracket(Parse &ps) {
        __cxx1_re_set<charT> s;
        if (at(ps, '^')) { s.negated = true; ++ps.p; }
        bool firstAtom = true;
        for (;;) {
            if (ps.p == ps.end) fail(regex_constants::error_brack);
            if (at(ps, ']') && !(firstAtom && posix())) { ++ps.p; break; }
            firstAtom = false;
            charT lo = charT();
            bool isChar = true;
            if (at2(ps, '[', ':') || at2(ps, '[', '.') || at2(ps, '[', '=')) {
                const char kind = nar(ps.p[1]);
                ps.p += 2;
                const charT *nameStart = ps.p;
                while (!(ps.end - ps.p >= 2 && nar(ps.p[0]) == kind && nar(ps.p[1]) == ']')) {
                    if (ps.p == ps.end) fail(regex_constants::error_brack);
                    ++ps.p;
                }
                const charT *nameEnd = ps.p;
                ps.p += 2;
                if (kind == ':') {
                    const unsigned int cls = traits_.lookup_classname(nameStart, nameEnd, icaseOn());
                    if (cls == 0) fail(regex_constants::error_ctype);
                    s.classes |= cls;
                    isChar = false;
                } else if (kind == '=') {
                    const string_type name = traits_.lookup_collatename(nameStart, nameEnd);
                    if (name.empty()) fail(regex_constants::error_collate);
                    s.equivs.push_back(traits_.transform_primary(name.begin(), name.end()));
                    isChar = false;
                } else {
                    const string_type name = traits_.lookup_collatename(nameStart, nameEnd);
                    if (name.size() != 1) fail(regex_constants::error_collate);
                    lo = name[0];
                }
            } else if (at(ps, '\\') && (!posix() || awkSyntax())) {
                ++ps.p;
                if (ps.p == ps.end) fail(regex_constants::error_escape);
                const charT e = *ps.p++;
                const char ec = nar(e);
                unsigned int cls = 0;
                bool neg = false;
                if (!posix()) {
                    if (ec == 'd') cls = ctype_base::digit;
                    else if (ec == 'D') { cls = ctype_base::digit; neg = true; }
                    else if (ec == 's') cls = ctype_base::space;
                    else if (ec == 'S') { cls = ctype_base::space; neg = true; }
                    else if (ec == 'w') cls = ctype_base::alnum | 0x10000u;
                    else if (ec == 'W') { cls = ctype_base::alnum | 0x10000u; neg = true; }
                }
                if (cls != 0) {
                    if (neg) s.notClasses.push_back(cls);
                    else s.classes |= cls;
                    isChar = false;
                } else {
                    lo = escaped(ps, e, true);
                }
            } else {
                lo = *ps.p++;
            }
            if (!isChar) continue;
            if (at(ps, '-') && !(ps.end - ps.p >= 2 && nar(ps.p[1]) == ']')) {
                ++ps.p;
                if (ps.p == ps.end) fail(regex_constants::error_brack);
                charT hi;
                if (at2(ps, '[', '.')) {
                    ps.p += 2;
                    const charT *nameStart = ps.p;
                    while (!(ps.end - ps.p >= 2 && nar(ps.p[0]) == '.' && nar(ps.p[1]) == ']')) {
                        if (ps.p == ps.end) fail(regex_constants::error_brack);
                        ++ps.p;
                    }
                    const string_type name = traits_.lookup_collatename(nameStart, ps.p);
                    ps.p += 2;
                    if (name.size() != 1) fail(regex_constants::error_collate);
                    hi = name[0];
                } else if (at(ps, '\\') && (!posix() || awkSyntax())) {
                    ++ps.p;
                    if (ps.p == ps.end) fail(regex_constants::error_escape);
                    const charT e = *ps.p++;
                    hi = escaped(ps, e, true);
                } else {
                    hi = *ps.p++;
                }
                if (hi < lo) fail(regex_constants::error_range);
                s.ranges.push_back(make_pair(lo, hi));
            } else {
                s.chars += lo;
            }
        }
        sets_.push_back(s);
        return node(__rk_class, static_cast<int>(sets_.size()) - 1);
    }

    // [re.grammar]: * + ? {n} {n,} {n,m}, lazy with a trailing '?' in ECMAScript.
    int quantified(Parse &ps, int a, int groupsBefore) {
        if (ps.p == ps.end) return a;
        long lo, hi;
        const char c = nar(*ps.p);
        if (c == '*') { lo = 0; hi = -1; ++ps.p; }
        else if (c == '+' && !bre()) { lo = 1; hi = -1; ++ps.p; }
        else if (c == '?' && !bre()) { lo = 0; hi = 1; ++ps.p; }
        else if ((!bre() && c == '{') || (bre() && at2(ps, '\\', '{'))) {
            ps.p += bre() ? 2 : 1;
            lo = number(ps);
            if (lo < 0) fail(regex_constants::error_badbrace);
            hi = lo;
            if (at(ps, ',')) {
                ++ps.p;
                hi = (bre() ? at2(ps, '\\', '}') : at(ps, '}')) ? -1 : number(ps);
                if (hi == -2) fail(regex_constants::error_badbrace);
            }
            if (bre() ? !at2(ps, '\\', '}') : !at(ps, '}')) fail(regex_constants::error_brace);
            ps.p += bre() ? 2 : 1;
            if (hi >= 0 && hi < lo) fail(regex_constants::error_badbrace);
        } else {
            return a;
        }
        bool lazy = false;
        if (!posix() && at(ps, '?')) { lazy = true; ++ps.p; }
        const __cxx1_re_kind k = tree_[static_cast<size_t>(a)].kind;
        if (k == __rk_bol || k == __rk_eol || k == __rk_wordb || k == __rk_nwordb) fail(regex_constants::error_badrepeat);
        if (lo > 1000 || hi > 1000) fail(regex_constants::error_complexity);
        const int r = node(__rk_repeat);
        __cxx1_re_node &n = tree_[static_cast<size_t>(r)];
        n.lo = lo;
        n.hi = hi;
        n.lazy = lazy;
        n.kids.push_back(a);
        n.firstGroup = groupsBefore + 1;
        n.lastGroup = ps.groups;
        // A repeated repeat: `a**` - a quantifier after a quantifier is ill-formed in ECMAScript.
        if (!posix() && ps.p != ps.end && (at(ps, '*') || at(ps, '+') || at(ps, '?') || at(ps, '{')))
            fail(regex_constants::error_badrepeat);
        return quantified(ps, r, groupsBefore);
    }
    long number(Parse &ps) {
        long v = -2;
        while (ps.p != ps.end && nar(*ps.p) >= '0' && nar(*ps.p) <= '9') {
            v = (v < 0 ? 0 : v) * 10 + (nar(*ps.p) - '0');
            if (v > 100000) fail(regex_constants::error_badbrace);
            ++ps.p;
        }
        return v;
    }

    // ---- code generation
    int emit(__cxx1_re_op op, int a = 0, int b = 0) {
        __cxx1_re_inst i = { op, a, b };
        prog_.push_back(i);
        return static_cast<int>(prog_.size()) - 1;
    }
    int here() const { return static_cast<int>(prog_.size()); }
    void gen(int id) {
        const __cxx1_re_node n = tree_[static_cast<size_t>(id)];
        switch (n.kind) {
        case __rk_empty: break;
        case __rk_char: emit(__re_char, n.value); break;
        case __rk_any: emit(__re_any); break;
        case __rk_class: emit(__re_class, n.value); break;
        case __rk_bol: emit(__re_bol); break;
        case __rk_eol: emit(__re_eol); break;
        case __rk_wordb: emit(__re_wordb); break;
        case __rk_nwordb: emit(__re_nwordb); break;
        case __rk_backref: emit(__re_backref, n.value); break;
        case __rk_seq:
            for (size_t i = 0; i < n.kids.size(); i++) gen(n.kids[i]);
            break;
        case __rk_group:
            emit(__re_save, 2 * n.value);
            gen(n.kids[0]);
            emit(__re_save, 2 * n.value + 1);
            break;
        case __rk_look: {
            const int look = emit(n.value != 0 ? __re_nlook : __re_look);
            gen(n.kids[0]);
            emit(__re_lookend);
            prog_[static_cast<size_t>(look)].a = here();
            break;
        }
        case __rk_alt: {
            vector<int> jumps;
            for (size_t k = 0; k < n.kids.size(); k++) {
                if (k + 1 < n.kids.size()) {
                    const int split = emit(__re_split);
                    prog_[static_cast<size_t>(split)].a = here();
                    gen(n.kids[k]);
                    jumps.push_back(emit(__re_jump));
                    prog_[static_cast<size_t>(split)].b = here();
                } else {
                    gen(n.kids[k]);
                }
            }
            for (size_t k = 0; k < jumps.size(); k++) prog_[static_cast<size_t>(jumps[k])].a = here();
            break;
        }
        case __rk_repeat: {
            // Each pass clears the captures of the groups inside, [re.grammar] and ECMAScript's RepeatMatcher.
            for (long k = 0; k < n.lo; k++) pass(n);
            if (n.hi < 0) {
                const int reg = regs_++;
                const int loop = emit(__re_split);
                const int body = emit(__re_mark, reg);
                pass(n);
                emit(__re_progress, reg);
                emit(__re_jump, loop);
                const int out = here();
                prog_[static_cast<size_t>(loop)].a = n.lazy ? out : body;
                prog_[static_cast<size_t>(loop)].b = n.lazy ? body : out;
            } else {
                vector<int> splits;
                for (long k = n.lo; k < n.hi; k++) {
                    const int split = emit(__re_split);
                    prog_[static_cast<size_t>(split)].a = here();
                    pass(n);
                    splits.push_back(split);
                }
                const int out = here();
                for (size_t k = 0; k < splits.size(); k++) {
                    __cxx1_re_inst &s = prog_[static_cast<size_t>(splits[k])];
                    const int body = s.a;
                    s.a = n.lazy ? out : body;
                    s.b = n.lazy ? body : out;
                }
            }
            break;
        }
        }
    }
    void pass(const __cxx1_re_node &n) {
        if (n.lastGroup >= n.firstGroup && (flags_ & regex_constants::nosubs) == 0) emit(__re_clear, n.firstGroup, n.lastGroup);
        gen(n.kids[0]);
    }

    // ---- matching
    bool sameChar(charT a, charT b) const {
        if (icaseOn()) return traits_.translate_nocase(a) == traits_.translate_nocase(b);
        return (flags_ & regex_constants::collate) != 0 ? traits_.translate(a) == traits_.translate(b) : a == b;
    }
    bool inSet(const __cxx1_re_set<charT> &s, charT c) const {
        bool in = false;
        const charT cl = icaseOn() ? traits_.translate_nocase(c) : c;
        for (size_t i = 0; i < s.chars.size() && !in; i++) in = sameChar(s.chars[i], c);
        for (size_t i = 0; i < s.ranges.size() && !in; i++) {
            if (s.ranges[i].first <= c && c <= s.ranges[i].second) in = true;
            else if (icaseOn()) {
                const ctype<charT> &ct = use_facet<ctype<charT> >(traits_.getloc());
                const charT u = ct.toupper(c);
                in = (s.ranges[i].first <= cl && cl <= s.ranges[i].second) || (s.ranges[i].first <= u && u <= s.ranges[i].second);
            }
        }
        if (!in && s.classes != 0) in = traits_.isctype(c, s.classes);
        for (size_t i = 0; i < s.notClasses.size() && !in; i++) in = !traits_.isctype(c, s.notClasses[i]);
        if (!in && !s.equivs.empty()) {
            const charT one[1] = { c };
            const string_type key = traits_.transform_primary(one, one + 1);
            for (size_t i = 0; i < s.equivs.size() && !in; i++) in = s.equivs[i] == key;
        }
        return in != s.negated;
    }

public:
    traits traits_;
    flag_type flags_;
    unsigned marks_;
    int regs_;
    vector<__cxx1_re_inst> prog_;
    vector<__cxx1_re_set<charT> > sets_;

private:
    vector<__cxx1_re_node> tree_;
};

template <class charT, class traits> constexpr typename basic_regex<charT, traits>::flag_type basic_regex<charT, traits>::icase;
