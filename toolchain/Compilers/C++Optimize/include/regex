template <class BidirIt, class Alloc, class charT, class traits>
bool regex_search(BidirIt first, BidirIt last, match_results<BidirIt, Alloc> &m, const basic_regex<charT, traits> &e,
                  regex_constants::match_flag_type flags = regex_constants::match_default) {
    vector<pair<BidirIt, BidirIt> > caps;
    vector<bool> set;
    for (BidirIt start = first;; ++start) {
        // A start past the first sees the character before it.
        regex_constants::match_flag_type f = flags;
        if (start != first) f = f | regex_constants::match_prev_avail;
        if (e.__cxx1_run(first, start, last, f, false, caps, set)) {
            m.__cxx1_set(first, first, last, caps, set, true);
            return true;
        }
        if (start == last || (flags & regex_constants::match_continuous) != 0) break;
    }
    m.__cxx1_set(first, first, last, caps, set, false);
    return false;
}
