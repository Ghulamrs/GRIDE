        n_ = o.n_;
        end_ = o.end_;
        fix(o);
        return *this;
    }
    bool operator==(const regex_token_iterator &right) const {
        if (result_ == 0 || right.result_ == 0) return result_ == right.result_;
        if (result_ == &suffix_ || right.result_ == &right.suffix_)
            return result_ == &suffix_ && right.result_ == &right.suffix_ && suffix_ == right.suffix_;
        return position_ == right.position_ && n_ == right.n_ && subs_ == right.subs_;
    }
    bool operator!=(const regex_token_iterator &right) const { return !(*this == right); }
    const value_type &operator*() const { return *result_; }
    const value_type *operator->() const { return result_; }
    regex_token_iterator &operator++() {
        if (result_ == &suffix_) {
            result_ = 0;
            return *this;
        }
        if (n_ + 1 < subs_.size()) {
            n_++;
            result_ = current();
            return *this;
        }
        const BidirIt lastEnd = (*position_)[0].second;
        ++position_;
        n_ = 0;
        if (position_ != regex_iterator<BidirIt, charT, traits>()) {
            result_ = current();
            return *this;
        }
        if (hasMinus() && lastEnd != end_) {
            suffix_.first = lastEnd;
            suffix_.second = end_;
            suffix_.matched = true;
            result_ = &suffix_;
        } else {
            result_ = 0;
        }
        return *this;
    }
    regex_token_iterator operator++(int) {
        regex_token_iterator t = *this;
        ++*this;
        return t;
    }

private:
    bool hasMinus() const { return std::find(subs_.begin(), subs_.end(), -1) != subs_.end(); }
    const value_type *current() const {
        const int s = subs_[n_];
        return s == -1 ? &(*position_).prefix() : &(*position_)[static_cast<size_t>(s)];
    }
    void init(BidirIt a, BidirIt b) {
        if (position_ != regex_iterator<BidirIt, charT, traits>()) {
            result_ = current();
        } else if (hasMinus() && a != b) {
            suffix_.first = a;
            suffix_.second = b;
            suffix_.matched = true;
            result_ = &suffix_;
        }
    }
    void fix(const regex_token_iterator &o) {
        if (o.result_ == 0) result_ = 0;
        else if (o.result_ == &o.suffix_) result_ = &suffix_;
        else result_ = current();
    }
    regex_iterator<BidirIt, charT, traits> position_;
    const value_type *result_;
    value_type suffix_;
    vector<int> subs_;
    size_t n_;
    BidirIt end_;
};
typedef regex_token_iterator<const char *> cregex_token_iterator;
typedef regex_token_iterator<const wchar_t *> wcregex_token_iterator;
typedef regex_token_iterator<string::const_iterator> sregex_token_iterator;
typedef regex_token_iterator<wstring::const_iterator> wsregex_token_iterator;

// [re.alg.replace]
template <class OutputIterator, class BidirIt, class traits, class charT, class ST, class SA>
OutputIterator regex_replace(OutputIterator out, BidirIt first, BidirIt last, const basic_regex<charT, traits> &e,
                             const basic_string<charT, ST, SA> &fmt,
                             regex_constants::match_flag_type flags = regex_constants::match_default) {
    return regex_replace(out, first, last, e, fmt.c_str(), flags);
}
template <class OutputIterator, class BidirIt, class traits, class charT>
OutputIterator regex_replace(OutputIterator out, BidirIt first, BidirIt last, const basic_regex<charT, traits> &e,
                             const charT *fmt, regex_constants::match_flag_type flags = regex_constants::match_default) {
    regex_iterator<BidirIt, charT, traits> i(first, last, e, flags), end;
    const size_t len = char_traits<charT>::length(fmt);
    if (i == end) {
        if ((flags & regex_constants::format_no_copy) == 0) out = std::copy(first, last, out);
        return out;
    }
    BidirIt tail = first;
    for (; i != end; ++i) {
        if ((flags & regex_constants::format_no_copy) == 0) out = std::copy(i->prefix().first, i->prefix().second, out);
        out = i->format(out, fmt, fmt + len, flags);
        tail = (*i)[0].second;
        if ((flags & regex_constants::format_first_only) != 0) break;
    }
    if ((flags & regex_constants::format_no_copy) == 0) out = std::copy(tail, last, out);
    return out;
}
template <class traits, class charT, class ST, class SA, class FST, class FSA>
basic_string<charT, ST, SA> regex_replace(const basic_string<charT, ST, SA> &s, const basic_regex<charT, traits> &e,
                                          const basic_string<charT, FST, FSA> &fmt,
                                          regex_constants::match_flag_type flags = regex_constants::match_default) {
    basic_string<charT, ST, SA> r;
    regex_replace(back_inserter(r), s.begin(), s.end(), e, fmt.c_str(), flags);
    return r;
}
template <class traits, class charT, class ST, class SA>
basic_string<charT, ST, SA> regex_replace(const basic_string<charT, ST, SA> &s, const basic_regex<charT, traits> &e,
                                          const charT *fmt, regex_constants::match_flag_type flags = regex_constants::match_default) {
    basic_string<charT, ST, SA> r;
    regex_replace(back_inserter(r), s.begin(), s.end(), e, fmt, flags);
    return r;
}
template <class traits, class charT, class ST, class SA>
basic_string<charT> regex_replace(const charT *s, const basic_regex<charT, traits> &e, const basic_string<charT, ST, SA> &fmt,
                                  regex_constants::match_flag_type flags = regex_constants::match_default) {
    basic_string<charT> r;
    regex_replace(back_inserter(r), s, s + char_traits<charT>::length(s), e, fmt.c_str(), flags);
    return r;
}
template <class traits, class charT>
basic_string<charT> regex_replace(const charT *s, const basic_regex<charT, traits> &e, const charT *fmt,
                                  regex_constants::match_flag_type flags = regex_constants::match_default) {
    basic_string<charT> r;
    regex_replace(back_inserter(r), s, s + char_traits<charT>::length(s), e, fmt, flags);
    return r;
}

