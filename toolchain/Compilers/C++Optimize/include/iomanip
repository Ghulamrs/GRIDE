// <iomanip> - the manipulators that take an argument.
//
// setw, setprecision and setfill are not functions the stream dispatches like
// endl; each carries a value, so each is a small object a stream knows how to
// take. `os << setw(8)` builds one and the `operator<<` for it writes the value
// into the stream's own state - which is where <ios> keeps width, precision and
// the flags, and <ostream> the fill. Nothing is formatted here; these only set
// what the next insertion reads. The no-argument manipulators are <ios>'s.
#ifndef _CXX1_IOMANIP
#define _CXX1_IOMANIP

#include <istream>
#include <ostream>

namespace std {

struct _Setw { int n; };
struct _Setprecision { int n; };
struct _Setfill { char c; };
struct _Setiosflags { ios_base::fmtflags set, mask; };

inline _Setw         setw(int n)         { _Setw s;         s.n = n; return s; }
inline _Setprecision setprecision(int n) { _Setprecision s; s.n = n; return s; }
inline _Setfill      setfill(char c)     { _Setfill s;      s.c = c; return s; }

// [std.manip]/3-5: flags set, flags cleared, and a base - 8, 10 or 16, any
// other number clearing basefield - each `setf` under a mask, on either stream.
inline _Setiosflags setiosflags(ios_base::fmtflags mask) { _Setiosflags s; s.set = mask; s.mask = mask; return s; }
inline _Setiosflags resetiosflags(ios_base::fmtflags mask) { _Setiosflags s; s.set = 0; s.mask = mask; return s; }
inline _Setiosflags setbase(int base) {
    _Setiosflags s;
    s.set = base == 8 ? ios_base::oct : base == 10 ? ios_base::dec : base == 16 ? ios_base::hex : 0;
    s.mask = ios_base::basefield;
    return s;
}

inline ostream &operator<<(ostream &os, _Setw m)         { os.width_ = m.n; return os; }
inline ostream &operator<<(ostream &os, _Setprecision m) { os.prec_  = m.n; return os; }
inline ostream &operator<<(ostream &os, _Setfill m)      { os.fill_ = m.c; return os; }
inline ostream &operator<<(ostream &os, _Setiosflags m)  { os.setf(m.set, m.mask); return os; }
inline istream &operator>>(istream &in, _Setiosflags m)  { in.setf(m.set, m.mask); return in; }
inline istream &operator>>(istream &in, _Setw m)         { in.width_ = m.n; return in; }
inline istream &operator>>(istream &in, _Setprecision m) { in.prec_ = m.n; return in; }

}  // namespace std

#endif
