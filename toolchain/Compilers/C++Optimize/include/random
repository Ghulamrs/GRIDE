namespace __cxx1_os {
extern "C" int rand_s(unsigned int *value);
}
#endif

// The engines and distributions compare and stream through members of their own; these are the namespace's
// operators [rand.req.eng]/3 and [rand.req.dist]/3 ask for, found by argument-dependent lookup.
struct __cxx1_rand_base {};
template <class T> typename enable_if<is_base_of<__cxx1_rand_base, T>::value, bool>::type operator==(const T &x, const T &y) {
    return x.__cxx1_eq(y);
}
template <class T> typename enable_if<is_base_of<__cxx1_rand_base, T>::value, bool>::type operator!=(const T &x, const T &y) {
    return !x.__cxx1_eq(y);
}
template <class T> typename enable_if<is_base_of<__cxx1_rand_base, T>::value, ostream &>::type operator<<(ostream &os, const T &x) {
    return x.__cxx1_out(os);
}
template <class T> typename enable_if<is_base_of<__cxx1_rand_base, T>::value, istream &>::type operator>>(istream &is, T &x) {
    return x.__cxx1_in(is);
}

// Saves a stream's flags, fill and precision, and sets what [rand.req.eng]/12 asks of a text representation.
struct __cxx1_rand_io {
    ios &s;
    ios_base::fmtflags flags;
    char fill;
    streamsize precision;
    explicit __cxx1_rand_io(ios &st) : s(st), flags(st.flags()), fill(st.fill()), precision(st.precision()) {
        s.flags(ios_base::dec | ios_base::left | ios_base::skipws);
        s.fill(' ');
        s.precision(numeric_limits<long double>::max_digits10);
    }
    ~__cxx1_rand_io() { s.flags(flags); s.fill(fill); s.precision(precision); }
};

// (a * x + c) mod m without overflow; m == 0 stands for 2^64.
template <class U> U __cxx1_mulmod(U a, U x, U c, U m) {
    typedef unsigned long long W;
    if (m == 0) return static_cast<U>(static_cast<W>(a) * x + c);
    if (static_cast<W>(m) <= 0xFFFFFFFFull) return static_cast<U>((static_cast<W>(a) * x + c) % m);
    W r = 0, aa = static_cast<W>(a) % m, xx = static_cast<W>(x) % m;
    while (xx != 0) {
        if (xx & 1) r = (r >= m - aa) ? r - (m - aa) : r + aa;
        aa = (aa >= m - aa) ? aa - (m - aa) : aa + aa;
        xx >>= 1;
    }
    W cc = static_cast<W>(c) % m;
    return static_cast<U>(r >= m - cc ? r - (m - cc) : r + cc);
}

// [rand.util.seedseq]
class seed_seq {
    vector<uint_least32_t> v_;

public:
    typedef uint_least32_t result_type;
    seed_seq() {}
    template <class T> seed_seq(initializer_list<T> il) {
        for (const T *p = il.begin(); p != il.end(); ++p) v_.push_back(static_cast<uint_least32_t>(*p) & 0xFFFFFFFFu);
    }
    template <class InputIt> seed_seq(InputIt first, InputIt last) {
        for (; first != last; ++first) v_.push_back(static_cast<uint_least32_t>(*first) & 0xFFFFFFFFu);
    }
    seed_seq(const seed_seq &) = delete;
    void operator=(const seed_seq &) = delete;

    template <class RandomIt> void generate(RandomIt begin, RandomIt end) {
        if (begin == end) return;
        typedef uint_least32_t W;
        const size_t n = static_cast<size_t>(end - begin), s = v_.size();
        for (RandomIt it = begin; it != end; ++it) *it = 0x8b8b8b8bu;
        const size_t t = n >= 623 ? 11 : n >= 68 ? 7 : n >= 39 ? 5 : n >= 7 ? 3 : (n - 1) / 2;
        const size_t p = (n - t) / 2, q = p + t, m = s + 1 > n ? s + 1 : n;
        for (size_t k = 0; k < m; k++) {
            W x = static_cast<W>(begin[k % n] ^ begin[(k + p) % n] ^ begin[(k + n - 1) % n]) & 0xFFFFFFFFu;
            const W r1 = static_cast<W>(1664525u * (x ^ (x >> 27))) & 0xFFFFFFFFu;
            const W r2 = static_cast<W>(r1 + (k == 0 ? s : k <= s ? k % n + v_[k - 1] : k % n)) & 0xFFFFFFFFu;
            begin[(k + p) % n] = static_cast<W>(begin[(k + p) % n] + r1) & 0xFFFFFFFFu;
            begin[(k + q) % n] = static_cast<W>(begin[(k + q) % n] + r2) & 0xFFFFFFFFu;
            begin[k % n] = r2;
        }
        for (size_t k = m; k < m + n; k++) {
            W x = static_cast<W>(begin[k % n] + begin[(k + p) % n] + begin[(k + n - 1) % n]) & 0xFFFFFFFFu;
            const W r3 = static_cast<W>(1566083941u * (x ^ (x >> 27))) & 0xFFFFFFFFu;
            const W r4 = static_cast<W>(r3 - k % n) & 0xFFFFFFFFu;
            begin[(k + p) % n] = static_cast<W>(begin[(k + p) % n] ^ r3);
            begin[(k + q) % n] = static_cast<W>(begin[(k + q) % n] ^ r4);
            begin[k % n] = r4;
        }
    }
    size_t size() const { return v_.size(); }
    template <class OutputIt> void param(OutputIt out) const {
        for (size_t i = 0; i < v_.size(); i++) *out++ = v_[i];
    }
};

// Whether T is a seed sequence for an engine of result type R: [rand.req.eng]/4's constraint on its templates.
template <class T, class R> struct __cxx1_is_seed_seq
    : integral_constant<bool, !is_convertible<T, R>::value && !is_same<typename remove_cv<T>::type, R>::value> {};

// The value of k 32-bit words of a seed sequence: [rand.eng.lcong]/7, [rand.eng.mers]/9, [rand.eng.sub]/7.
template <class U, class Sseq> U __cxx1_seed_words(Sseq &q, size_t k, size_t at, vector<uint_least32_t> &a) {
    (void)q;
    U v = 0;
    for (size_t j = 0; j < k; j++) v |= static_cast<U>(static_cast<unsigned long long>(a[at + j]) << (32 * j));
    return v;
}

// [rand.eng.lcong]
template <class UIntType, UIntType a, UIntType c, UIntType m> class linear_congruential_engine : public __cxx1_rand_base {
    static_assert(m == 0 || (a < m && c < m), "a and c must be less than m - [rand.eng.lcong]/3");
    UIntType x_;

public:
    typedef UIntType result_type;
    static constexpr result_type multiplier = a;
    static constexpr result_type increment = c;
    static constexpr result_type modulus = m;
    static constexpr result_type min() { return c == 0u ? 1u : 0u; }
    static constexpr result_type max() { return m - 1u; }
    static constexpr result_type default_seed = 1u;

    explicit linear_congruential_engine(result_type s = default_seed) { seed(s); }
    template <class Sseq, class = typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type>
    explicit linear_congruential_engine(Sseq &q) { seed(q); }

    void seed(result_type s = default_seed) {
        const result_type sm = m == 0 ? s : s % m;
        x_ = ((m == 0 ? c : c % m) == 0 && sm == 0) ? result_type(1) : sm;
    }
    template <class Sseq> typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type seed(Sseq &q) {
        unsigned bits = 0;
        for (unsigned long long mm = m == 0 ? 0 : static_cast<unsigned long long>(m) - 1; mm != 0; mm >>= 1) bits++;
        if (m == 0) bits = numeric_limits<result_type>::digits;
        const size_t k = (bits + 31) / 32;
        vector<uint_least32_t> arr(k + 3);
        q.generate(arr.begin(), arr.end());
        seed(__cxx1_seed_words<result_type>(q, k, 3, arr));
    }
    result_type operator()() { return x_ = __cxx1_mulmod<UIntType>(a, x_, c, m); }
    void discard(unsigned long long z) { for (; z != 0; --z) (*this)(); }

    bool __cxx1_eq(const linear_congruential_engine &r) const { const linear_congruential_engine &l = *this; return l.x_ == r.x_; }
    ostream &__cxx1_out(ostream &os) const { const linear_congruential_engine &e = *this;
        __cxx1_rand_io io(os);
        return os << static_cast<unsigned long long>(e.x_);
    }
    istream &__cxx1_in(istream &is) { linear_congruential_engine &e = *this;
        __cxx1_rand_io io(is);
        unsigned long long v = 0;
        if (is >> v) e.x_ = static_cast<UIntType>(v);
        return is;
    }
};
template <class U, U a, U c, U m> constexpr U linear_congruential_engine<U, a, c, m>::multiplier;
template <class U, U a, U c, U m> constexpr U linear_congruential_engine<U, a, c, m>::increment;
template <class U, U a, U c, U m> constexpr U linear_congruential_engine<U, a, c, m>::modulus;
template <class U, U a, U c, U m> constexpr U linear_congruential_engine<U, a, c, m>::default_seed;

// [rand.eng.mers], one value at a time over a circular buffer: X(i-n) is x_[i_].
template <class UIntType, size_t w, size_t n, size_t m, size_t r, UIntType a, size_t u, UIntType d, size_t s,
          UIntType b, size_t t, UIntType c, size_t l, UIntType f>
