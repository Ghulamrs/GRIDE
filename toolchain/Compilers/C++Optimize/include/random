// <random> - [rand]: engines, engine adaptors, seed_seq, random_device, generate_canonical and the twenty
// distributions.
//
// The engines are the standard's recurrences and give its sequences to the bit ([rand.predef] fixes the
// 10000th value of each). The distributions' algorithms are this library's own, as [rand.dist]/3 allows:
// uniform_int by rejection, normal by Marsaglia's polar method, gamma by Marsaglia and Tsang, poisson by
// multiplication below a mean of 12 and Hormann's PTRS above. default_random_engine is mt19937, as cl's is.
// random_device reads rand_s on Windows, /dev/urandom elsewhere; on a target with neither (the C6747) it is
// a time-seeded engine, and entropy() says 0.
#ifndef _CXX1_RANDOM
#define _CXX1_RANDOM

#include <cmath>
#include <cstddef>
#include <cstdint>
#include <cstdio>
#include <ctime>
#include <initializer_list>
#include <istream>
#include <limits>
#include <ostream>
#include <stdexcept>
#include <string>
#include <type_traits>
