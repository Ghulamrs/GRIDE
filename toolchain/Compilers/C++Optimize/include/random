// [rand.util.canonical]
template <class RealType, size_t bits, class URNG> RealType generate_canonical(URNG &g) {
    const size_t digits = static_cast<size_t>(numeric_limits<RealType>::digits);
    const size_t b = digits < bits ? digits : bits;
    const long double R = static_cast<long double>(g.max()) - static_cast<long double>(g.min()) + 1.0L;
    const size_t log2r = static_cast<size_t>(std::log(R) / std::log(2.0L));
    size_t k = (b + log2r - 1) / (log2r == 0 ? 1 : log2r);
    if (k == 0) k = 1;
    RealType sum = 0, mult = 1;
    for (; k != 0; --k) {
        sum += static_cast<RealType>(g() - g.min()) * mult;
        mult *= static_cast<RealType>(R);
    }
    RealType r = sum / mult;
    if (r >= RealType(1)) r = std::nextafter(RealType(1), RealType(0));
    return r;
}

template <class R, class G> R __cxx1_canonical(G &g) { return generate_canonical<R, numeric_limits<R>::digits>(g); }

