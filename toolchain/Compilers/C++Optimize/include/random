// [rand.dist.norm.f]
template <class RealType = double> class fisher_f_distribution : public __cxx1_rand_base {
    gamma_distribution<RealType> gm_, gn_;
    _CXX1_RAND_PARAMS2(fisher_f_distribution, RealType, RealType, m, RealType(1), RealType, n, RealType(1))
    void reset() { gm_.reset(); gn_.reset(); }
    template <class G> result_type operator()(G &g, const param_type &q) {
        typedef typename gamma_distribution<RealType>::param_type gp;
        const RealType x = gm_(g, gp(q.m() / RealType(2), RealType(1))), y = gn_(g, gp(q.n() / RealType(2), RealType(1)));
        return (x * q.n()) / (y * q.m());
    }
    result_type min() const { return 0; }
    result_type max() const { return numeric_limits<RealType>::infinity(); }
};

// [rand.dist.norm.t]
template <class RealType = double> class student_t_distribution : public __cxx1_rand_base {
    normal_distribution<RealType> nd_;
    gamma_distribution<RealType> gm_;
    _CXX1_RAND_PARAMS1(student_t_distribution, RealType, RealType, n, RealType(1))
    void reset() { nd_.reset(); gm_.reset(); }
    template <class G> result_type operator()(G &g, const param_type &q) {
        const RealType z = nd_(g);
        const RealType chi = RealType(2) * gm_(g, typename gamma_distribution<RealType>::param_type(q.n() / RealType(2), RealType(1)));
        return static_cast<RealType>(z / std::sqrt(static_cast<double>(chi / q.n())));
    }
    result_type min() const { return -numeric_limits<RealType>::infinity(); }
    result_type max() const { return numeric_limits<RealType>::infinity(); }
};

