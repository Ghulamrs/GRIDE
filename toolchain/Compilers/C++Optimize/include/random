template <class RealType = double> class weibull_distribution : public __cxx1_rand_base {
    _CXX1_RAND_PARAMS2(weibull_distribution, RealType, RealType, a, RealType(1), RealType, b, RealType(1))
    void reset() {}
    template <class G> result_type operator()(G &g, const param_type &q) {
        return static_cast<RealType>(q.b() * std::pow(-std::log(1.0 - static_cast<double>(__cxx1_canonical<RealType>(g))), 1.0 / q.a()));
    }
    result_type min() const { return 0; }
    result_type max() const { return numeric_limits<RealType>::infinity(); }
};

// [rand.dist.pois.extreme]
template <class RealType = double> class extreme_value_distribution : public __cxx1_rand_base {
    _CXX1_RAND_PARAMS2(extreme_value_distribution, RealType, RealType, a, RealType(0), RealType, b, RealType(1))
