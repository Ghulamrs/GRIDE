// [rand.dist.samp.discrete]
template <class IntType = int> class discrete_distribution : public __cxx1_rand_base {
public:
    typedef IntType result_type;
    class param_type : public __cxx1_rand_base {
        vector<double> p_, cum_;
        void normalise() {
            if (p_.empty()) p_.push_back(1.0);
            double sum = 0;
            for (size_t i = 0; i < p_.size(); i++) sum += p_[i];
            cum_.assign(p_.size(), 0.0);
            double run = 0;
            for (size_t i = 0; i < p_.size(); i++) {
                p_[i] /= sum;
                run += p_[i];
                cum_[i] = run;
            }
            cum_.back() = 1.0;
        }
    public:
        typedef discrete_distribution distribution_type;
        param_type() { normalise(); }
        template <class InputIt> param_type(InputIt first, InputIt last) {
            for (; first != last; ++first) p_.push_back(static_cast<double>(*first));
            normalise();
        }
        param_type(initializer_list<double> wl) : p_(wl.begin(), wl.end()) { normalise(); }
        template <class UnaryOperation> param_type(size_t nw, double xmin, double xmax, UnaryOperation fw) {
            if (nw == 0) nw = 1;
            const double delta = (xmax - xmin) / static_cast<double>(nw);
            for (size_t k = 0; k < nw; k++) p_.push_back(fw(xmin + static_cast<double>(k) * delta + delta / 2));
            normalise();
        }
        vector<double> probabilities() const { return p_; }
        const vector<double> &__cxx1_cumulative() const { return cum_; }
        bool __cxx1_eq(const param_type &y) const { const param_type &x = *this; return x.p_ == y.p_; }
    };

    discrete_distribution() {}
    template <class InputIt> discrete_distribution(InputIt first, InputIt last) : p_(first, last) {}
    discrete_distribution(initializer_list<double> wl) : p_(wl) {}
    template <class UnaryOperation> discrete_distribution(size_t nw, double xmin, double xmax, UnaryOperation fw) : p_(nw, xmin, xmax, fw) {}
    explicit discrete_distribution(const param_type &p) : p_(p) {}
    void reset() {}
    template <class G> result_type operator()(G &g) { return (*this)(g, p_); }
    template <class G> result_type operator()(G &g, const param_type &p) {
        const double u = __cxx1_canonical<double>(g);
        const vector<double> &cum = p.__cxx1_cumulative();
        size_t lo = 0, hi = cum.size() - 1;
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (u < cum[mid]) hi = mid;
            else lo = mid + 1;
        }
        return static_cast<IntType>(lo);
    }
    vector<double> probabilities() const { return p_.probabilities(); }
    param_type param() const { return p_; }
    void param(const param_type &p) { p_ = p; }
    result_type min() const { return 0; }
    result_type max() const { return static_cast<IntType>(p_.probabilities().size() - 1); }
    bool __cxx1_eq(const discrete_distribution &y) const { const discrete_distribution &x = *this; return x.p_ == y.p_; }
    ostream &__cxx1_out(ostream &os) const { const discrete_distribution &d = *this;
        __cxx1_rand_io io(os);
        const vector<double> p = d.probabilities();
        os << static_cast<unsigned long long>(p.size());
        for (size_t i = 0; i < p.size(); i++) os << ' ' << p[i];
        return os;
    }
    istream &__cxx1_in(istream &is) { discrete_distribution &d = *this;
        __cxx1_rand_io io(is);
        unsigned long long n = 0;
        if (!(is >> n)) return is;
        vector<double> p(static_cast<size_t>(n));
        for (size_t i = 0; i < p.size(); i++) if (!(is >> p[i])) return is;
        d.p_ = param_type(p.begin(), p.end());
        return is;
    }

private:
    param_type p_;
};

// [rand.dist.samp.pconst] and [rand.dist.samp.plinear]: an interval chosen by its share of the area, then a
// point in it - uniformly for constant density, by inverting the trapezoid's distribution for linear.
template <class RealType, bool Linear> class __cxx1_piecewise_param : public __cxx1_rand_base {
    vector<RealType> b_, d_;
    vector<double> cum_;

    void finish() {
        if (b_.size() < 2) {
            b_.assign(1, RealType(0));
            b_.push_back(RealType(1));
            d_.assign(Linear ? 2 : 1, RealType(1));
        }
        const size_t n = b_.size() - 1;
        vector<double> area(n);
        double total = 0;
        // [rand.dist.samp.pconst]/1: a constant distribution's weights are its intervals' probabilities, the
        // density each over its width; [rand.dist.samp.plinear]/1: a linear one's are densities at the bounds.
        for (size_t i = 0; i < n; i++) {
            const double w = static_cast<double>(b_[i + 1] - b_[i]);
            area[i] = Linear ? w * (static_cast<double>(d_[i]) + static_cast<double>(d_[i + 1])) / 2 : static_cast<double>(d_[i]);
            total += area[i];
        }
        for (size_t i = 0; i < d_.size(); i++)
            d_[i] = static_cast<RealType>(static_cast<double>(d_[i]) /
                                          (Linear ? total : total * static_cast<double>(b_[i + 1] - b_[i])));
        cum_.assign(n, 0.0);
        double run = 0;
        for (size_t i = 0; i < n; i++) { run += area[i] / total; cum_[i] = run; }
        cum_.back() = 1.0;
    }

public:
    __cxx1_piecewise_param() { finish(); }
    template <class InputItB, class InputItW> __cxx1_piecewise_param(InputItB fb, InputItB lb, InputItW fw) {
        for (; fb != lb; ++fb) b_.push_back(static_cast<RealType>(*fb));
        if (b_.size() >= 2)
            for (size_t i = 0; i < b_.size() - (Linear ? 0 : 1); i++, ++fw) d_.push_back(static_cast<RealType>(*fw));
        finish();
    }
    template <class UnaryOperation> __cxx1_piecewise_param(initializer_list<RealType> bl, UnaryOperation fw) {
        b_.assign(bl.begin(), bl.end());
        if (b_.size() >= 2) {
            for (size_t i = 0; i + 1 < b_.size(); i++)
                d_.push_back(static_cast<RealType>(Linear ? fw(b_[i]) : fw((b_[i] + b_[i + 1]) / 2)));
            if (Linear) d_.push_back(static_cast<RealType>(fw(b_.back())));
        }
        finish();
    }
    template <class UnaryOperation> __cxx1_piecewise_param(size_t nw, RealType xmin, RealType xmax, UnaryOperation fw) {
        if (nw == 0) nw = 1;
        const RealType delta = (xmax - xmin) / static_cast<RealType>(nw);
        for (size_t k = 0; k <= nw; k++) b_.push_back(xmin + static_cast<RealType>(k) * delta);
        for (size_t k = 0; k < nw; k++) d_.push_back(static_cast<RealType>(Linear ? fw(b_[k]) : fw(b_[k] + delta / 2)));
        if (Linear) d_.push_back(static_cast<RealType>(fw(b_[nw])));
        finish();
    }
    vector<RealType> intervals() const { return b_; }
    vector<RealType> densities() const { return d_; }
    bool operator==(const __cxx1_piecewise_param &o) const { return b_ == o.b_ && d_ == o.d_; }

    template <class G> RealType draw(G &g) const {
        const double u = __cxx1_canonical<double>(g);
        size_t lo = 0, hi = cum_.size() - 1;
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (u < cum_[mid]) hi = mid;
            else lo = mid + 1;
        }
        const double x0 = static_cast<double>(b_[lo]), x1 = static_cast<double>(b_[lo + 1]);
        const double v = __cxx1_canonical<double>(g);
        if (!Linear) return static_cast<RealType>(x0 + (x1 - x0) * v);
        const double p0 = static_cast<double>(d_[lo]), p1 = static_cast<double>(d_[lo + 1]), w = x1 - x0;
        if (std::fabs(p1 - p0) < 1e-12 * (p0 + p1)) return static_cast<RealType>(x0 + w * v);
        // The share s of the interval's area solves p0 s + (p1 - p0) s^2 / 2 = v (p0 + p1) / 2.
        const double s = (-p0 + std::sqrt(p0 * p0 + v * (p1 * p1 - p0 * p0))) / (p1 - p0);
        return static_cast<RealType>(x0 + w * s);
    }
};

#define _CXX1_PIECEWISE(Dist, Linear)                                                                           \
template <class RealType = double> class Dist {                                                                 \
public:                                                                                                         \
    typedef RealType result_type;                                                                               \
    class param_type : public __cxx1_piecewise_param<RealType, Linear> {                                        \
        typedef __cxx1_piecewise_param<RealType, Linear> base;                                                  \
    public:                                                                                                     \
        typedef Dist distribution_type;                                                                         \
        param_type() {}                                                                                         \
        template <class InputItB, class InputItW> param_type(InputItB fb, InputItB lb, InputItW fw) : base(fb, lb, fw) {} \
        template <class UnaryOperation> param_type(initializer_list<RealType> bl, UnaryOperation fw) : base(bl, fw) {} \
        template <class UnaryOperation> param_type(size_t nw, RealType xmin, RealType xmax, UnaryOperation fw)  \
            : base(nw, xmin, xmax, fw) {}                                                                       \
        bool __cxx1_eq(const param_type &y) const { const param_type &x = *this; return static_cast<const base &>(x) == static_cast<const base &>(y); }     \
    \
    };                                                                                                          \
    Dist() {}                                                                                                   \
    template <class InputItB, class InputItW> Dist(InputItB fb, InputItB lb, InputItW fw) : p_(fb, lb, fw) {}   \
    template <class UnaryOperation> Dist(initializer_list<RealType> bl, UnaryOperation fw) : p_(bl, fw) {}      \
    template <class UnaryOperation> Dist(size_t nw, RealType xmin, RealType xmax, UnaryOperation fw)            \
        : p_(nw, xmin, xmax, fw) {}                                                                             \
    explicit Dist(const param_type &p) : p_(p) {}                                                               \
    void reset() {}                                                                                             \
    template <class G> result_type operator()(G &g) { return p_.draw(g); }                                      \
    template <class G> result_type operator()(G &g, const param_type &p) { return p.draw(g); }                  \
    vector<RealType> intervals() const { return p_.intervals(); }                                               \
    vector<RealType> densities() const { return p_.densities(); }                                               \
    param_type param() const { return p_; }                                                                     \
    void param(const param_type &p) { p_ = p; }                                                                 \
    result_type min() const { return p_.intervals().front(); }                                                  \
    result_type max() const { return p_.intervals().back(); }                                                   \
    bool __cxx1_eq(const Dist &y) const { const Dist &x = *this; return x.p_ == y.p_; }                               \
    \
    ostream &__cxx1_out(ostream &os) const { const Dist &d = *this;                                                    \
        __cxx1_rand_io io(os);                                                                                  \
        const vector<RealType> b = d.intervals(), w = d.densities();                                            \
        os << static_cast<unsigned long long>(b.size() - 1);                                                    \
        for (size_t i = 0; i < b.size(); i++) os << ' ' << b[i];                                                \
        for (size_t i = 0; i < w.size(); i++) os << ' ' << w[i];                                                \
        return os;                                                                                              \
    }                                                                                                           \
    istream &__cxx1_in(istream &is) { Dist &d = *this;                                                          \
        __cxx1_rand_io io(is);                                                                                  \
        unsigned long long n = 0;                                                                               \
        if (!(is >> n)) return is;                                                                              \
        vector<RealType> b(static_cast<size_t>(n) + 1), w(static_cast<size_t>(n) + (Linear ? 1 : 0));          \
        for (size_t i = 0; i < b.size(); i++) if (!(is >> b[i])) return is;                                     \
        for (size_t i = 0; i < w.size(); i++) if (!(is >> w[i])) return is;                                     \
        d.p_ = param_type(b.begin(), b.end(), w.begin());                                                       \
        return is;                                                                                              \
    }                                                                                                           \
                                                                                                                \
private:                                                                                                        \
    param_type p_;                                                                                              \
};
