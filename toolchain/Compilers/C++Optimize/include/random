public:
    typedef UIntType result_type;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return mask(); }

    independent_bits_engine() : e_() {}
    explicit independent_bits_engine(const Engine &e) : e_(e) {}
    explicit independent_bits_engine(Engine &&e) : e_(std::move(e)) {}
    explicit independent_bits_engine(result_type s) : e_(static_cast<typename Engine::result_type>(s)) {}
    template <class Sseq, class = typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value &&
                                                     !is_same<Sseq, Engine>::value>::type>
    explicit independent_bits_engine(Sseq &q) : e_(q) {}
