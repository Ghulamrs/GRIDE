    bool __cxx1_eq(const discard_block_engine &y) const { const discard_block_engine &x = *this; return x.n_ == y.n_ && x.e_ == y.e_; }
    ostream &__cxx1_out(ostream &os) const { const discard_block_engine &x = *this;
        __cxx1_rand_io io(os);
        return os << x.e_ << ' ' << static_cast<unsigned long long>(x.n_);
