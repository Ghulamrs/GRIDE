// [rand.dist.norm.cauchy]
template <class RealType = double> class cauchy_distribution : public __cxx1_rand_base {
    _CXX1_RAND_PARAMS2(cauchy_distribution, RealType, RealType, a, RealType(0), RealType, b, RealType(1))
    void reset() {}
    template <class G> result_type operator()(G &g, const param_type &q) {
        double u;
        do u = static_cast<double>(__cxx1_canonical<RealType>(g));
        while (u == 0.5 || u == 0.0);
        return static_cast<RealType>(q.a() + q.b() * std::tan(3.14159265358979323846 * (u - 0.5)));
    }
