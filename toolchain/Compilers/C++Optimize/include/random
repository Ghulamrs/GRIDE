    static_assert(0 < m && m <= n && r <= w && w <= static_cast<size_t>(numeric_limits<UIntType>::digits) &&
                  u <= w && s <= w && t <= w && l <= w, "mersenne_twister_engine's parameters - [rand.eng.mers]/4");
    UIntType x_[n];
    size_t i_;

    static constexpr UIntType mask() { return w == static_cast<size_t>(numeric_limits<UIntType>::digits) ? ~UIntType(0) : (UIntType(1) << w) - 1; }

public:
    typedef UIntType result_type;
    static constexpr size_t word_size = w;
    static constexpr size_t state_size = n;
    static constexpr size_t shift_size = m;
    static constexpr size_t mask_bits = r;
    static constexpr UIntType xor_mask = a;
    static constexpr size_t tempering_u = u;
    static constexpr UIntType tempering_d = d;
    static constexpr size_t tempering_s = s;
    static constexpr UIntType tempering_b = b;
    static constexpr size_t tempering_t = t;
    static constexpr UIntType tempering_c = c;
    static constexpr size_t tempering_l = l;
    static constexpr UIntType initialization_multiplier = f;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return mask(); }
    static constexpr result_type default_seed = 5489u;

    explicit mersenne_twister_engine(result_type value = default_seed) { seed(value); }
    template <class Sseq, class = typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type>
    explicit mersenne_twister_engine(Sseq &q) { seed(q); }

    void seed(result_type value = default_seed) {
        x_[0] = value & mask();
        for (size_t i = 1; i < n; i++)
            x_[i] = (f * (x_[i - 1] ^ (x_[i - 1] >> (w - 2))) + static_cast<UIntType>(i)) & mask();
        i_ = 0;
    }
    template <class Sseq> typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type seed(Sseq &q) {
        const size_t k = (w + 31) / 32;
        vector<uint_least32_t> arr(n * k);
        q.generate(arr.begin(), arr.end());
        bool zero = true;
        for (size_t i = 0; i < n; i++) {
            x_[i] = __cxx1_seed_words<result_type>(q, k, i * k, arr) & mask();
            if (i == 0) zero = (x_[0] >> r) == 0;
            else zero = zero && x_[i] == 0;
        }
        if (zero) x_[0] = UIntType(1) << (w - 1);
        i_ = 0;
    }
    result_type operator()() {
        const UIntType upper = (~UIntType(0) << r) & mask(), lower = ~upper & mask();
        const size_t j1 = i_ + 1 == n ? 0 : i_ + 1, jm = i_ + m >= n ? i_ + m - n : i_ + m;
        const UIntType y = (x_[i_] & upper) | (x_[j1] & lower);
        const UIntType xi = x_[jm] ^ (y >> 1) ^ ((y & 1) != 0 ? a : UIntType(0));
        x_[i_] = xi;
        i_ = j1;
        UIntType z = xi ^ ((xi >> u) & d);
        z ^= (z << s) & b;
        z ^= (z << t) & c;
        z ^= z >> l;
        return z & mask();
    }
    void discard(unsigned long long z) { for (; z != 0; --z) (*this)(); }

    bool __cxx1_eq(const mersenne_twister_engine &y) const { const mersenne_twister_engine &x = *this;
        for (size_t k = 0; k < n; k++)
            if (x.x_[(x.i_ + k) % n] != y.x_[(y.i_ + k) % n]) return false;
        return true;
    }
    ostream &__cxx1_out(ostream &os) const { const mersenne_twister_engine &e = *this;
        __cxx1_rand_io io(os);
        for (size_t k = 0; k < n; k++) {
            if (k != 0) os << ' ';
            os << static_cast<unsigned long long>(e.x_[(e.i_ + k) % n]);
        }
        return os;
    }
    istream &__cxx1_in(istream &is) { mersenne_twister_engine &e = *this;
        __cxx1_rand_io io(is);
        UIntType v[n];
        for (size_t k = 0; k < n; k++) {
            unsigned long long x = 0;
            if (!(is >> x)) return is;
            v[k] = static_cast<UIntType>(x);
        }
        for (size_t k = 0; k < n; k++) e.x_[k] = v[k];
        e.i_ = 0;
        return is;
    }
};
template <class U, size_t w, size_t n, size_t m, size_t r, U a, size_t u, U d, size_t s, U b, size_t t, U c, size_t l, U f>
constexpr U mersenne_twister_engine<U, w, n, m, r, a, u, d, s, b, t, c, l, f>::default_seed;

// [rand.eng.sub]
template <class UIntType, size_t w, size_t s, size_t r> class subtract_with_carry_engine : public __cxx1_rand_base {
    static_assert(0 < s && s < r && 0 < w && w <= static_cast<size_t>(numeric_limits<UIntType>::digits),
                  "subtract_with_carry_engine's parameters - [rand.eng.sub]/3");
    UIntType x_[r];
    UIntType carry_;
    size_t i_;

    static constexpr UIntType mask() { return w == static_cast<size_t>(numeric_limits<UIntType>::digits) ? ~UIntType(0) : (UIntType(1) << w) - 1; }

public:
    typedef UIntType result_type;
    static constexpr size_t word_size = w;
    static constexpr size_t short_lag = s;
    static constexpr size_t long_lag = r;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return mask(); }
    static constexpr result_type default_seed = 19780503u;

    explicit subtract_with_carry_engine(result_type value = default_seed) { seed(value); }
    template <class Sseq, class = typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type>
    explicit subtract_with_carry_engine(Sseq &q) { seed(q); }

    void seed(result_type value = default_seed) {
        linear_congruential_engine<UIntType, 40014u, 0u, 2147483563u> e(value == 0u ? default_seed : value);
        const size_t n = (w + 31) / 32;
        for (size_t i = 0; i < r; i++) {
            unsigned long long v = 0;
            for (size_t j = 0; j < n; j++) v |= static_cast<unsigned long long>(e()) << (32 * j);
            x_[i] = static_cast<UIntType>(v) & mask();
        }
        carry_ = x_[r - 1] == 0 ? 1 : 0;
        i_ = 0;
    }
    template <class Sseq> typename enable_if<__cxx1_is_seed_seq<Sseq, result_type>::value>::type seed(Sseq &q) {
        const size_t k = (w + 31) / 32;
        vector<uint_least32_t> arr(r * k);
        q.generate(arr.begin(), arr.end());
        for (size_t i = 0; i < r; i++) x_[i] = __cxx1_seed_words<result_type>(q, k, i * k, arr) & mask();
        carry_ = x_[r - 1] == 0 ? 1 : 0;
        i_ = 0;
    }
    result_type operator()() {
        const size_t js = i_ + (r - s) >= r ? i_ + (r - s) - r : i_ + (r - s);   // X(i-s); x_[i_] is X(i-r)
        const UIntType xs = x_[js], xr = x_[i_];
        UIntType y;
        if (xs >= xr + carry_ && !(carry_ != 0 && xr == mask())) {
            y = xs - xr - carry_;
            carry_ = 0;
        } else {
            y = (xs + (mask() - xr) + 1 - carry_) & mask();
            carry_ = 1;
        }
        x_[i_] = y;
        i_ = i_ + 1 == r ? 0 : i_ + 1;
        return y;
    }
    void discard(unsigned long long z) { for (; z != 0; --z) (*this)(); }

    bool __cxx1_eq(const subtract_with_carry_engine &y) const { const subtract_with_carry_engine &x = *this;
        if (x.carry_ != y.carry_) return false;
        for (size_t k = 0; k < r; k++)
            if (x.x_[(x.i_ + k) % r] != y.x_[(y.i_ + k) % r]) return false;
        return true;
    }
    ostream &__cxx1_out(ostream &os) const { const subtract_with_carry_engine &e = *this;
        __cxx1_rand_io io(os);
        for (size_t k = 0; k < r; k++) os << static_cast<unsigned long long>(e.x_[(e.i_ + k) % r]) << ' ';
        return os << static_cast<unsigned long long>(e.carry_);
    }
    istream &__cxx1_in(istream &is) { subtract_with_carry_engine &e = *this;
        __cxx1_rand_io io(is);
        UIntType v[r];
        unsigned long long x = 0;
        for (size_t k = 0; k < r; k++) {
            if (!(is >> x)) return is;
            v[k] = static_cast<UIntType>(x);
        }
        if (!(is >> x)) return is;
        for (size_t k = 0; k < r; k++) e.x_[k] = v[k];
        e.carry_ = static_cast<UIntType>(x);
        e.i_ = 0;
        return is;
    }
