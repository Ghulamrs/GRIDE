        size_t n = w / m + (w % m != 0 ? 1 : 0);
        size_t w0 = w / n;
        W y0 = (R >> w0) << w0;
        if (R - y0 > y0 / n) {
            n++;
            w0 = w / n;
            y0 = (R >> w0) << w0;
        }
        const size_t n0 = n - w % n;
