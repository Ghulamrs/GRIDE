// [basic.string.hash]: the four strings' hashes, FNV-1a over the bytes of the
// units, as cl's own is. The primary template is <functional>'s; declaring it
// here as well is what lets a program hash a string with <string> alone.
template <class T> struct hash;
template <class C, class Tr, class A> inline std::size_t __cxx1_hash_units(const basic_string<C, Tr, A> &s) {
    const unsigned char *b = (const unsigned char *)s.data();
    const std::size_t n = s.size() * sizeof(C);
#if defined(__TMS320C6X__)
    std::size_t h = 2166136261u;
    for (std::size_t i = 0; i < n; i++) { h ^= b[i]; h *= 16777619u; }
#else
    unsigned long long h = 14695981039346656037ULL;
    for (std::size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }
#endif
    return (std::size_t)h;
}
// [string.io]: written as one field; read as a word - whitespace skipped while `skipws` is set, then up to the
// next whitespace or `width()` characters, a failure if that is nothing; getline up to the delimiter, taken
// and not stored. The streams are only declared here: these are instantiated where they are complete.
template <class C, class Tr, class A>
basic_ostream<C, Tr> &operator<<(basic_ostream<C, Tr> &os, const basic_string<C, Tr, A> &s) {
    return os.__cxx1_field(s.data(), s.size(), 0);
}
template <class C, class Tr, class A>
basic_istream<C, Tr> &operator>>(basic_istream<C, Tr> &in, basic_string<C, Tr, A> &s) {
    typename basic_istream<C, Tr>::sentry ok(in);
    if (!ok) return in;
    s.clear();
    const std::size_t most = in.width() > 0 ? static_cast<std::size_t>(in.width()) : s.max_size();
    while (s.size() < most) {
        const typename Tr::int_type c = in.__cxx1_get();
        if (Tr::eq_int_type(c, Tr::eof())) { in.setstate(ios_base::eofbit); break; }
        if (in.__cxx1_space(Tr::to_char_type(c))) { in.__cxx1_unget(); break; }
        s.push_back(Tr::to_char_type(c));
    }
    in.width(0);
    if (s.empty()) in.setstate(ios_base::failbit);
    return in;
}
template <class C, class Tr, class A>
basic_istream<C, Tr> &getline(basic_istream<C, Tr> &in, basic_string<C, Tr, A> &s, C delim) {
    typename basic_istream<C, Tr>::sentry ok(in, true);
    if (!ok) return in;
    s.clear();
    std::size_t taken = 0;
    for (;;) {
        const typename Tr::int_type c = in.__cxx1_get();
        if (Tr::eq_int_type(c, Tr::eof())) { in.setstate(ios_base::eofbit); break; }
        taken++;
        if (Tr::eq(Tr::to_char_type(c), delim)) break;
        if (s.size() == s.max_size()) { in.setstate(ios_base::failbit); break; }
        s.push_back(Tr::to_char_type(c));
    }
    if (taken == 0) in.setstate(ios_base::failbit);
    return in;
}
template <class C, class Tr, class A> basic_istream<C, Tr> &getline(basic_istream<C, Tr> &in, basic_string<C, Tr, A> &s) {
    return getline(in, s, in.widen('\n'));
}
template <class C, class Tr, class A>
basic_istream<C, Tr> &getline(basic_istream<C, Tr> &&in, basic_string<C, Tr, A> &s, C delim) {
    return getline(in, s, delim);
}
template <class C, class Tr, class A> basic_istream<C, Tr> &getline(basic_istream<C, Tr> &&in, basic_string<C, Tr, A> &s) {
    return getline(in, s, in.widen('\n'));
}

