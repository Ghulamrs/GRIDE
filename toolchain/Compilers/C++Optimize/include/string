    size_type rfind(const C *s, size_type pos, size_type n) const noexcept {
        if (n > len_) return npos;
        size_type i = len_ - n < pos ? len_ - n : pos;
        for (++i; i-- > 0; )
            if (Tr::compare(p() + i, s, n) == 0) return i;
        return npos;
    }
    size_type rfind(const basic_string &s, size_type pos = npos) const noexcept { return rfind(s.p(), pos, s.len_); }
    size_type rfind(const C *s, size_type pos = npos) const noexcept { return rfind(s, pos, Tr::length(s)); }
    size_type rfind(C c, size_type pos = npos) const noexcept { return rfind(&c, pos, 1); }

    size_type find_first_of(const C *s, size_type pos, size_type n) const noexcept {
        for (size_type i = pos; i < len_; i++)
            if (Tr::find(s, n, p()[i]) != 0) return i;
        return npos;
    }
    size_type find_first_of(const basic_string &s, size_type pos = 0) const noexcept { return find_first_of(s.p(), pos, s.len_); }
    size_type find_first_of(const C *s, size_type pos = 0) const noexcept { return find_first_of(s, pos, Tr::length(s)); }
    size_type find_first_of(C c, size_type pos = 0) const noexcept { return find(c, pos); }

    size_type find_last_of(const C *s, size_type pos, size_type n) const noexcept {
        if (len_ == 0) return npos;
        for (size_type i = (pos < len_ ? pos : len_ - 1) + 1; i-- > 0; )
            if (Tr::find(s, n, p()[i]) != 0) return i;
        return npos;
    }
    size_type find_last_of(const basic_string &s, size_type pos = npos) const noexcept { return find_last_of(s.p(), pos, s.len_); }
    size_type find_last_of(const C *s, size_type pos = npos) const noexcept { return find_last_of(s, pos, Tr::length(s)); }
    size_type find_last_of(C c, size_type pos = npos) const noexcept { return rfind(c, pos); }

    size_type find_first_not_of(const C *s, size_type pos, size_type n) const noexcept {
        for (size_type i = pos; i < len_; i++)
            if (Tr::find(s, n, p()[i]) == 0) return i;
        return npos;
    }
    size_type find_first_not_of(const basic_string &s, size_type pos = 0) const noexcept {
        return find_first_not_of(s.p(), pos, s.len_);
    }
    size_type find_first_not_of(const C *s, size_type pos = 0) const noexcept { return find_first_not_of(s, pos, Tr::length(s)); }
    size_type find_first_not_of(C c, size_type pos = 0) const noexcept { return find_first_not_of(&c, pos, 1); }

    size_type find_last_not_of(const C *s, size_type pos, size_type n) const noexcept {
        if (len_ == 0) return npos;
        for (size_type i = (pos < len_ ? pos : len_ - 1) + 1; i-- > 0; )
            if (Tr::find(s, n, p()[i]) == 0) return i;
        return npos;
    }
    size_type find_last_not_of(const basic_string &s, size_type pos = npos) const noexcept {
        return find_last_not_of(s.p(), pos, s.len_);
    }
    size_type find_last_not_of(const C *s, size_type pos = npos) const noexcept { return find_last_not_of(s, pos, Tr::length(s)); }
    size_type find_last_not_of(C c, size_type pos = npos) const noexcept { return find_last_not_of(&c, pos, 1); }

    basic_string substr(size_type pos = 0, size_type n = npos) const {
        if (pos > len_) std::__throw_out_of_range("basic_string::substr");
        return basic_string(p() + pos, clamp(n, len_ - pos));
    }

    // [string.compare]: traits_type::compare over the shorter length, then the lengths.
    int compare(const basic_string &o) const noexcept { return compareUnits(p(), len_, o.p(), o.len_); }
    int compare(size_type pos, size_type n1, const basic_string &o) const {
        if (pos > len_) std::__throw_out_of_range("basic_string::compare");
        return compareUnits(p() + pos, clamp(n1, len_ - pos), o.p(), o.len_);
    }
    int compare(size_type pos, size_type n1, const basic_string &o, size_type pos2, size_type n2) const {
        if (pos > len_ || pos2 > o.len_) std::__throw_out_of_range("basic_string::compare");
        return compareUnits(p() + pos, clamp(n1, len_ - pos), o.p() + pos2, clamp(n2, o.len_ - pos2));
    }
    int compare(const C *s) const { return compareUnits(p(), len_, s, Tr::length(s)); }
    int compare(size_type pos, size_type n1, const C *s) const { return compare(pos, n1, s, Tr::length(s)); }
    int compare(size_type pos, size_type n1, const C *s, size_type n2) const {
        if (pos > len_) std::__throw_out_of_range("basic_string::compare");
        return compareUnits(p() + pos, clamp(n1, len_ - pos), s, n2);
    }

private:
    static size_type clamp(size_type n, size_type most) { return n < most ? n : most; }
    static int compareUnits(const C *a, size_type na, const C *b, size_type nb) {
        const int r = Tr::compare(a, b, na < nb ? na : nb);
        return r != 0 ? (r < 0 ? -1 : 1) : na < nb ? -1 : na > nb ? 1 : 0;
    }
    template <class It> basic_string &appendRange(It first, It last, __cxx1_range_tag<false>) {
        for (; first != last; ++first) push_back(*first);
        return *this;
    }
    template <class It> basic_string &appendRange(It n, It c, __cxx1_range_tag<true>) {
        return append(static_cast<size_type>(n), static_cast<C>(c));
    }
    // **Up to fifteen units live inside the object** - TI's and Dinkumware's layout,
    // chosen per access rather than by a pointer into the object, because cxx1 hands
    // a returned local to its caller as bytes and a self-pointer would dangle.
    enum { small = 15 };
    C *p() { return heap_ != 0 ? heap_ : small_; }
    const C *p() const { return heap_ != 0 ? static_cast<const C *>(heap_) : small_; }
    // A heap buffer holds `units` and the terminator, from the allocator, [string.require]/3.
    C *grab(size_type units) { return alloc_traits_::allocate(alloc_, units + 1); }
    void drop(C *h, size_type units) { alloc_traits_::deallocate(alloc_, h, units + 1); }
    void release() { if (heap_ != 0) drop(heap_, cap_); }
    void empty0() { heap_ = 0; len_ = 0; cap_ = 0; Tr::assign(small_[0], C()); }
    void takeFrom(basic_string &o) {
        if (o.heap_ != 0) {
            heap_ = o.heap_;
            cap_ = o.cap_;
        } else {
            Tr::copy(small_, o.small_, o.len_ + 1);
        }
        len_ = o.len_;
        o.empty0();
    }
    void init(const C *s, size_type n) {
        empty0();
        reserve(n);
        C *d = p();
        Tr::copy(d, s, n);
        len_ = n;
        Tr::assign(d[len_], C());
    }
    // **Every change in the middle is this one**: the n units at pos give way to n2 from s. A source
    // inside this string is copied out first, since what follows moves it, or frees it in a grow.
    basic_string &replaceUnits(size_type pos, size_type n, const C *s, size_type n2) {
        if (n2 != 0 && s >= p() && s <= p() + len_) {
            basic_string held(s, n2, alloc_);
            return replaceUnits(pos, n, held.p(), n2);
        }
        if (len_ - n > max_size() - n2) std::__throw_length_error("basic_string");
        const size_type tail = len_ - pos - n;
        const size_type wanted = len_ - n + n2;
        reserve(wanted);
        C *d = p();
        if (n2 != n && tail != 0) Tr::move(d + pos + n2, d + pos + n, tail);
        Tr::copy(d + pos, s, n2);
        len_ = wanted;
        Tr::assign(d[len_], C());
        return *this;
    }
    // Room for `want` units plus the terminator, keeping the text; `s`/`n` are
    // appended before the old buffer is freed, so an append of this string survives.
    void grow(size_type want, const C *s, size_type n) {
        C *fresh = grab(want);
        Tr::copy(fresh, p(), len_);
        Tr::copy(fresh + len_, s, n);
        len_ += n;
        Tr::assign(fresh[len_], C());
        release();
        heap_ = fresh;
        cap_ = want;
    }
    void assignFrom(const C *s, size_type n) {
        if (n > capacity()) { len_ = 0; grow(n, s, n); return; }
        C *d = p();
        Tr::move(d, s, n);
        len_ = n;
        Tr::assign(d[len_], C());
    }
    basic_string &appendUnits(const C *s, size_type n) {
        if (n == 0) return *this;
        if (n > max_size() - len_) std::__throw_length_error("basic_string::append");
        const size_type have = capacity();
        // Grown by doubling, so that building a string one unit at a time is not quadratic.
        if (len_ + n > have) { grow(len_ + n > have * 2 ? len_ + n : have * 2, s, n); return *this; }
        C *d = p();
        Tr::copy(d + len_, s, n);
        len_ += n;
        Tr::assign(d[len_], C());
        return *this;
    }

    C *heap_;
    size_type len_;
    size_type cap_;
    C small_[small + 1];
    A alloc_;
};

