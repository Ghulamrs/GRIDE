// <string> - one class template, and the operators around it.
//
// **Not `<cstring>`**, which is C's `string.h` under `std::`. This is the
// class; that is the byte functions. The two names are one letter apart and a
// program that reaches for the wrong one gets no error, so it is worth saying
// twice.
//
// **[basic.string] as C++11 writes it** (1.51, 2026-11-03): `basic_string<charT, traits, Allocator>`,
// whose units are compared, searched, copied and measured through `traits` - a case-blind
// char_traits makes a case-blind string - and whose heap buffer comes from the allocator through
// allocator_traits. Up to fifteen units are held inside the object, as TI's library does, and only
// a longer string owns a heap buffer.
//
// **The class owns memory, which is why it defines all four of the special
// members** rather than letting the compiler copy its bytes: two strings
// sharing a buffer would free it twice, and that is the failure that prints the
// right answer first.
#ifndef _CXX1_STRING
#define _CXX1_STRING

#include <cstddef>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cctype>     // as libstdc++'s <string> reaches it, so `isupper` is declared beside a string
#include <initializer_list>
#include <iosfwd>
#include <__allocator>
#include <__iterator_base>

namespace std {

// [char.traits.specializations]: the four units' traits - char's spelled out,
// since it compares as unsigned char and goes to the C library, and the other
// three from one template, comparing as their own unsigned values. int_type is
// wide enough for every unit and eof(), which is -1 converted: cl's WEOF for
// wchar_t on Windows, glibc's and Darwin's elsewhere. state_type stands in for
// mbstate_t until <cwchar> is written.
struct __cxx1_mbstate { int __count; unsigned int __value; };

template <class C> struct __cxx1_int_type { typedef unsigned int type; };
template <> struct __cxx1_int_type<char16_t> { typedef unsigned short type; };
#if defined(_WIN32)
template <> struct __cxx1_int_type<wchar_t> { typedef unsigned short type; };
#elif defined(__APPLE__)
template <> struct __cxx1_int_type<wchar_t> { typedef int type; };
#endif

template <class C> struct char_traits {
    typedef C char_type;
    typedef typename __cxx1_int_type<C>::type int_type;
    typedef streamoff off_type;
    typedef streampos pos_type;
    typedef __cxx1_mbstate state_type;
    static void assign(char_type &c1, const char_type &c2) { c1 = c2; }
    static bool eq(char_type a, char_type b) { return a == b; }
    static bool lt(char_type a, char_type b) { return a < b; }
    static int compare(const char_type *a, const char_type *b, std::size_t n) {
        for (std::size_t i = 0; i < n; i++)
            if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;
        return 0;
    }
    static std::size_t length(const char_type *s) {
        std::size_t n = 0;
        while (s[n] != char_type()) n++;
        return n;
    }
    static const char_type *find(const char_type *s, std::size_t n, const char_type &c) {
        for (std::size_t i = 0; i < n; i++)
            if (s[i] == c) return s + i;
        return 0;
    }
    static char_type *move(char_type *to, const char_type *from, std::size_t n) {
        if (n != 0) std::memmove(to, from, n * sizeof(char_type));
        return to;
    }
    static char_type *copy(char_type *to, const char_type *from, std::size_t n) {
        if (n != 0) std::memcpy(to, from, n * sizeof(char_type));
        return to;
    }
    static char_type *assign(char_type *s, std::size_t n, char_type c) {
        for (std::size_t i = 0; i < n; i++) s[i] = c;
        return s;
    }
    static int_type not_eof(int_type c) { return c != eof() ? c : 0; }
    static char_type to_char_type(int_type c) { return (char_type)c; }
    static int_type to_int_type(char_type c) { return (int_type)c; }
    static bool eq_int_type(int_type a, int_type b) { return a == b; }
    static int_type eof() { return (int_type)-1; }
};

template <> struct char_traits<char> {
    typedef char char_type;
    typedef int int_type;
    typedef streamoff off_type;
    typedef streampos pos_type;
    typedef __cxx1_mbstate state_type;
    static void assign(char_type &c1, const char_type &c2) { c1 = c2; }
    static bool eq(char_type a, char_type b) { return a == b; }
    static bool lt(char_type a, char_type b) { return (unsigned char)a < (unsigned char)b; }
    static int compare(const char_type *a, const char_type *b, std::size_t n) { return n == 0 ? 0 : std::memcmp(a, b, n); }
    static std::size_t length(const char_type *s) { return std::strlen(s); }
    static const char_type *find(const char_type *s, std::size_t n, const char_type &c) {
        return n == 0 ? 0 : (const char_type *)std::memchr(s, (unsigned char)c, n);
    }
    static char_type *move(char_type *to, const char_type *from, std::size_t n) {
        if (n != 0) std::memmove(to, from, n);
        return to;
    }
    static char_type *copy(char_type *to, const char_type *from, std::size_t n) {
        if (n != 0) std::memcpy(to, from, n);
        return to;
    }
    static char_type *assign(char_type *s, std::size_t n, char_type c) {
        if (n != 0) std::memset(s, (unsigned char)c, n);
        return s;
    }
    static int_type not_eof(int_type c) { return c != eof() ? c : 0; }
    static char_type to_char_type(int_type c) { return (char_type)c; }
    static int_type to_int_type(char_type c) { return (unsigned char)c; }
    static bool eq_int_type(int_type a, int_type b) { return a == b; }
    static int_type eof() { return -1; }
};

// **`at` throws `out_of_range`, and `out_of_range` holds a `string`**, so the
// class cannot be named here. What `at` calls is declared here and defined at
// the end of <stdexcept>, which the end of this header includes: the same
// shape libstdc++ gives it, with the definition in every unit rather than in
// a library, as the operators below are.
inline void __throw_out_of_range(const char *what);
inline void __throw_length_error(const char *what);

// [string.cons]/15: an iterator pair of an integral type is a count and a unit, as (n, c) is.
