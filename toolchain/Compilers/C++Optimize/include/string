// **[string.conversions] to_string, and the digits come off the negative
// side.** `-v` is undefined for the most negative value of a signed type -
// there is no positive counterpart - so the loop runs on `x <= 0` and turns
// each remainder round with `'0' - x % 10`. C++11 fixed `%` to truncate toward
// zero, so a negative dividend gives a non-positive remainder and the
// subtraction is the digit.
inline string to_string(long long v) {
    char buf[24];
    int n = 0;
    bool neg = v < 0;
    long long x = neg ? v : -v;
    do {
        buf[n] = (char)('0' - (int)(x % 10));
        n++;
        x /= 10;
    } while (x != 0);
    if (neg) { buf[n] = '-'; n++; }
    string r;
    for (int i = n; i-- > 0; ) r += buf[i];
    return r;
}

inline string to_string(unsigned long long v) {
    char buf[24];
    int n = 0;
    do {
        buf[n] = (char)('0' + (int)(v % 10));
        n++;
        v /= 10;
    } while (v != 0);
    string r;
    for (int i = n; i-- > 0; ) r += buf[i];
    return r;
}
inline string to_string(int v) { return to_string((long long)v); }
inline string to_string(long v) { return to_string((long long)v); }
inline string to_string(unsigned v) { return to_string((unsigned long long)v); }
inline string to_string(unsigned long v) { return to_string((unsigned long long)v); }

// The floating forms are `sprintf`'s "%f" and "%Lf", [string.conversions]/7 -
// asked twice, since a double near DBL_MAX is three hundred digits before the point.
inline string __cxx1_to_string(const char *how, long double v, bool isLong) {
    char small[64];
    int n = isLong ? std::snprintf(small, sizeof small, how, v) : std::snprintf(small, sizeof small, how, (double)v);
    if (n < 0) return string();
    if (n < (int)sizeof small) return string(small, (std::size_t)n);
    string r((std::size_t)n + 1, '\0');
    if (isLong) std::snprintf(&r[0], (std::size_t)n + 1, how, v);
    else std::snprintf(&r[0], (std::size_t)n + 1, how, (double)v);
    r.resize((std::size_t)n);
    return r;
}
inline string to_string(float v) { return __cxx1_to_string("%f", v, false); }
inline string to_string(double v) { return __cxx1_to_string("%f", v, false); }
inline string to_string(long double v) { return __cxx1_to_string("%Lf", v, true); }

// [string.conversions]/14: the same digits, widened.
inline wstring __cxx1_widen(const string &s) {
    wstring r;
    for (std::size_t i = 0; i < s.size(); i++) r += (wchar_t)s[i];
    return r;
}
inline wstring to_wstring(int v) { return __cxx1_widen(to_string(v)); }
