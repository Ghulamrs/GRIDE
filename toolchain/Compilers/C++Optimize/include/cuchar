// <cuchar> - [c.strings] Table 75: <uchar.h>'s conversions under std::, between the narrow execution character
// set, UTF-8, and char16_t or char32_t. The UCRT's and glibc's are taken where they are; Darwin's C library and
// the C6747's RTS6x have none, so there the four are this header's own - the UTF-8 is the same - with the
// second unit of a UTF-16 pair kept in the mbstate_t between calls.
#ifndef _CXX1_CUCHAR
#define _CXX1_CUCHAR

#include <cwchar>

#if defined(__APPLE__) || defined(__TMS320C6X__)
#include <cerrno>
#include <cstring>
#else
#include <uchar.h>
#endif

namespace std {
using ::mbstate_t;
using ::size_t;

#if defined(__APPLE__) || defined(__TMS320C6X__)
// One code point from UTF-8: the bytes taken, 0 for a NUL, -1 for an ill-formed sequence, -2 for one cut short.
inline long __cxx1_cuchar_read(const char *s, size_t n, unsigned long &cp) {
    const unsigned char *p = reinterpret_cast<const unsigned char *>(s);
    if (n == 0) return -2;
    const unsigned char c = p[0];
    int extra;
    if (c < 0x80) { cp = c; return c == 0 ? 0 : 1; }
    else if (c < 0xC2) return -1;
    else if (c < 0xE0) { cp = c & 0x1F; extra = 1; }
    else if (c < 0xF0) { cp = c & 0x0F; extra = 2; }
    else if (c < 0xF5) { cp = c & 0x07; extra = 3; }
    else return -1;
    for (int i = 1; i <= extra; i++) {
        if (static_cast<size_t>(i) >= n) return -2;
        if ((p[i] & 0xC0) != 0x80) return -1;
        cp = (cp << 6) | (p[i] & 0x3F);
    }
    if ((extra == 2 && cp < 0x800) || (extra == 3 && cp < 0x10000) || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF)
        return -1;
    return extra + 1;
}
// One code point to UTF-8: the bytes written, or 0 for no code point.
inline size_t __cxx1_cuchar_write(char *s, unsigned long cp) {
    unsigned char *q = reinterpret_cast<unsigned char *>(s);
    if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) return 0;
    if (cp < 0x80) { q[0] = static_cast<unsigned char>(cp); return 1; }
    if (cp < 0x800) { q[0] = static_cast<unsigned char>(0xC0 | (cp >> 6)); q[1] = static_cast<unsigned char>(0x80 | (cp & 0x3F)); return 2; }
    if (cp < 0x10000) {
        q[0] = static_cast<unsigned char>(0xE0 | (cp >> 12));
        q[1] = static_cast<unsigned char>(0x80 | ((cp >> 6) & 0x3F));
        q[2] = static_cast<unsigned char>(0x80 | (cp & 0x3F));
        return 3;
    }
    q[0] = static_cast<unsigned char>(0xF0 | (cp >> 18));
    q[1] = static_cast<unsigned char>(0x80 | ((cp >> 12) & 0x3F));
    q[2] = static_cast<unsigned char>(0x80 | ((cp >> 6) & 0x3F));
    q[3] = static_cast<unsigned char>(0x80 | (cp & 0x3F));
    return 4;
}
// The unit a conversion keeps between calls, in the state's first two bytes; 0 is none.
inline unsigned short __cxx1_cuchar_kept(const mbstate_t *ps) { unsigned short k; std::memcpy(&k, ps, sizeof k); return k; }
inline void __cxx1_cuchar_keep(mbstate_t *ps, unsigned short k) { std::memcpy(ps, &k, sizeof k); }

inline size_t mbrtoc16(char16_t *pc16, const char *s, size_t n, mbstate_t *ps) {
    static mbstate_t own;
    if (ps == 0) ps = &own;
    if (s == 0) { pc16 = 0; s = ""; n = 1; }
    const unsigned short low = __cxx1_cuchar_kept(ps);
    if (low != 0) {
        if (pc16 != 0) *pc16 = static_cast<char16_t>(low);
        __cxx1_cuchar_keep(ps, 0);
        return static_cast<size_t>(-3);
    }
    unsigned long cp = 0;
    const long k = __cxx1_cuchar_read(s, n, cp);
    if (k == -1) { errno = EILSEQ; return static_cast<size_t>(-1); }
    if (k == -2) return static_cast<size_t>(-2);
    if (cp >= 0x10000) {
        if (pc16 != 0) *pc16 = static_cast<char16_t>(0xD800 + ((cp - 0x10000) >> 10));
        __cxx1_cuchar_keep(ps, static_cast<unsigned short>(0xDC00 + ((cp - 0x10000) & 0x3FF)));
    } else if (pc16 != 0) {
        *pc16 = static_cast<char16_t>(cp);
    }
    return static_cast<size_t>(k);
}
inline size_t c16rtomb(char *s, char16_t c16, mbstate_t *ps) {
    static mbstate_t own;
    char buf[8];
    if (ps == 0) ps = &own;
    if (s == 0) { __cxx1_cuchar_keep(ps, 0); return 1; }
    const unsigned short high = __cxx1_cuchar_kept(ps);
    unsigned long cp = c16;
    if (cp >= 0xD800 && cp <= 0xDBFF) {
        if (high != 0) { errno = EILSEQ; return static_cast<size_t>(-1); }
        __cxx1_cuchar_keep(ps, static_cast<unsigned short>(cp));
        return 0;
    }
    if (cp >= 0xDC00 && cp <= 0xDFFF) {
        if (high == 0) { errno = EILSEQ; return static_cast<size_t>(-1); }
        __cxx1_cuchar_keep(ps, 0);
        cp = 0x10000 + ((static_cast<unsigned long>(high) - 0xD800) << 10) + (cp - 0xDC00);
    } else if (high != 0) {
        errno = EILSEQ;
        return static_cast<size_t>(-1);
    }
    const size_t k = __cxx1_cuchar_write(s == 0 ? buf : s, cp);
    if (k == 0) { errno = EILSEQ; return static_cast<size_t>(-1); }
    return k;
}
inline size_t mbrtoc32(char32_t *pc32, const char *s, size_t n, mbstate_t *) {
    if (s == 0) { pc32 = 0; s = ""; n = 1; }
    unsigned long cp = 0;
    const long k = __cxx1_cuchar_read(s, n, cp);
    if (k == -1) { errno = EILSEQ; return static_cast<size_t>(-1); }
    if (k == -2) return static_cast<size_t>(-2);
    if (pc32 != 0) *pc32 = static_cast<char32_t>(cp);
    return static_cast<size_t>(k);
}
inline size_t c32rtomb(char *s, char32_t c32, mbstate_t *) {
    char buf[8];
    if (s == 0) return 1;
    const size_t k = __cxx1_cuchar_write(s == 0 ? buf : s, static_cast<unsigned long>(c32));
    if (k == 0) { errno = EILSEQ; return static_cast<size_t>(-1); }
    return k;
}
#else
using ::mbrtoc16;
using ::c16rtomb;
using ::mbrtoc32;
using ::c32rtomb;
#endif
}  // namespace std

#endif
