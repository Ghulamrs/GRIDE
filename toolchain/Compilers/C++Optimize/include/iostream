// <iostream> - the three streams every program starts with.
//
// **They are objects at file scope, built by the constructor that names the
// standard stream each one writes or reads** - before anything declared after
// this header in the same unit, which is everything that could use them. The
// `FILE *` is resolved at the point of use. See the comment at the top of
// <ostream>.
//
// **`static`, so each translation unit gets its own.** A header-only library
// has no other choice: an `extern` object would need a definition in some
// object file, and there is none to put it in, and an `inline` variable is
// C++17. The functions moved to `inline` on 2026-09-19; these cannot follow.
// The observable difference is nil for a program compiled as one unit, and
// for one compiled as several it is a `width`/`precision` per unit.
#ifndef _CXX1_IOSTREAM
#define _CXX1_IOSTREAM

#include <istream>
#include <ostream>

namespace std {

// The number says which standard stream to resolve to: 1 is stdout (and
// stdin), 2 is stderr. [narrow.stream.objects]/2-4: cin and cerr are tied to
// cout, which is flushed before either is used; cerr is unit-buffered - it
// flushes after every output operation - and clog, on the same file, is neither.
static ostream cout(1);
static ostream cerr(2, ios_base::unitbuf, &cout);
static ostream clog(2);

static istream cin(1, &cout);

}  // namespace std

#endif
