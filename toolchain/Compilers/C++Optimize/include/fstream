// <fstream> - [file.streams]: basic_filebuf over the C library's FILE, and the streams that read and write a
// named file through it.
//
// A narrow buffer moves bytes with fgetc, ungetc and fwrite, so the C library's own buffering is the only one
// and a stream and stdio stay in step; a wide one converts each character through the "C" locale's multibyte
// encoding ([filebuf]/2's codecvt), wcrtomb out and mbrtowc in. The standard streams are filebufs over stdin,
// stdout and stderr that do not close them.
#ifndef _CXX1_FSTREAM
#define _CXX1_FSTREAM

#include <cstdio>
#include <cstring>
#include <cwchar>
#include <istream>
#include <ostream>
#include <streambuf>
#include <string>

namespace std {

// [filebuf.members]/4, Table 132: the fopen mode for each openmode; null for a combination it does not list.
inline const char *__cxx1_fopen_mode(ios_base::openmode m) {
    const bool b = (m & ios_base::binary) != 0;
    switch (m & ~(ios_base::binary | ios_base::ate)) {
    case ios_base::out:
    case ios_base::out | ios_base::trunc: return b ? "wb" : "w";
    case ios_base::out | ios_base::app:
    case ios_base::app: return b ? "ab" : "a";
    case ios_base::in: return b ? "rb" : "r";
    case ios_base::in | ios_base::out: return b ? "r+b" : "r+";
    case ios_base::in | ios_base::out | ios_base::trunc: return b ? "w+b" : "w+";
    case ios_base::in | ios_base::out | ios_base::app:
    case ios_base::in | ios_base::app: return b ? "a+b" : "a+";
    }
    return 0;
}

// The one character's bytes in and out: identity for char, the multibyte encoding for wider types.
template <class C> struct __cxx1_file_chars {
    static bool put(FILE *f, C c) {
        char bytes[8];
        mbstate_t st;
        std::memset(&st, 0, sizeof st);
        const size_t n = std::wcrtomb(bytes, static_cast<wchar_t>(c), &st);
        if (n == static_cast<size_t>(-1)) return false;
        return std::fwrite(bytes, 1, n, f) == n;
    }
    static long get(FILE *f, long *bytesRead) {
        mbstate_t st;
        std::memset(&st, 0, sizeof st);
        char b;
        wchar_t w = 0;
        *bytesRead = 0;
        for (;;) {
            const int c = std::fgetc(f);
            if (c == EOF) return -1;
            b = static_cast<char>(c);
            ++*bytesRead;
            const size_t r = std::mbrtowc(&w, &b, 1, &st);
            if (r == static_cast<size_t>(-2)) continue;
            if (r == static_cast<size_t>(-1)) return static_cast<unsigned char>(b);
            return static_cast<long>(w);
        }
    }
};
template <> struct __cxx1_file_chars<char> {
    static bool put(FILE *f, char c) { return std::fputc(static_cast<unsigned char>(c), f) != EOF; }
    static long get(FILE *f, long *bytesRead) {
        const int c = std::fgetc(f);
        *bytesRead = c == EOF ? 0 : 1;
        return c == EOF ? -1 : c;
    }
};

template <class C, class Tr> class basic_filebuf : public basic_streambuf<C, Tr> {
public:
    typedef C char_type;
    typedef typename Tr::int_type int_type;
    typedef typename Tr::pos_type pos_type;
    typedef typename Tr::off_type off_type;
    typedef Tr traits_type;

    basic_filebuf() : f_(0), owns_(false), mode_(0), held_(false), last_(0), lastBytes_(0) {}
    basic_filebuf(const basic_filebuf &) = delete;
    basic_filebuf(basic_filebuf &&rhs)
        : basic_streambuf<C, Tr>(), f_(rhs.f_), owns_(rhs.owns_), mode_(rhs.mode_), held_(rhs.held_), last_(rhs.last_),
          lastBytes_(rhs.lastBytes_) {
        rhs.f_ = 0;
        rhs.owns_ = false;
    }
    virtual ~basic_filebuf() { close(); }
    basic_filebuf &operator=(const basic_filebuf &) = delete;
    basic_filebuf &operator=(basic_filebuf &&rhs) {
        close();
        swap(rhs);
        return *this;
    }
    void swap(basic_filebuf &rhs) {
        std::swap(f_, rhs.f_);
        std::swap(owns_, rhs.owns_);
        std::swap(mode_, rhs.mode_);
        std::swap(held_, rhs.held_);
        std::swap(last_, rhs.last_);
        std::swap(lastBytes_, rhs.lastBytes_);
    }

    bool is_open() const { return f_ != 0; }
    basic_filebuf *open(const char *name, ios_base::openmode mode) {
        if (f_ != 0) return 0;
        const char *how = __cxx1_fopen_mode(mode);
        if (how == 0) return 0;
        f_ = std::fopen(name, how);
        if (f_ == 0) return 0;
        owns_ = true;
        mode_ = mode;
        held_ = false;
        if ((mode & ios_base::ate) != 0 && std::fseek(f_, 0, SEEK_END) != 0) { close(); return 0; }
        return this;
    }
    basic_filebuf *open(const string &name, ios_base::openmode mode) { return open(name.c_str(), mode); }
    basic_filebuf *close() {
        if (f_ == 0) return 0;
        const bool ok = !owns_ || std::fclose(f_) == 0;
        if (!owns_) std::fflush(f_);
        f_ = 0;
        owns_ = false;
        held_ = false;
        return ok ? this : 0;
    }
    // The standard streams' buffers: over a FILE this does not own.
    void __cxx1_attach(FILE *f, ios_base::openmode mode) {
        f_ = f;
        owns_ = false;
        mode_ = mode;
        held_ = false;
    }

protected:
    // [filebuf.virtuals]: one character at a time through the C library.
    virtual int_type underflow() {
        if (f_ == 0) return Tr::eof();
        if (!held_) {
            long bytes = 0;
            const long c = __cxx1_file_chars<C>::get(f_, &bytes);
            if (c < 0) return Tr::eof();
            last_ = Tr::to_char_type(static_cast<int_type>(c));
            lastBytes_ = bytes;
            held_ = true;
        }
        return Tr::to_int_type(last_);
    }
    virtual int_type uflow() {
        const int_type c = underflow();
        held_ = false;
        return c;
    }
    virtual int_type pbackfail(int_type c = Tr::eof()) {
        if (f_ == 0 || held_) return Tr::eof();
        held_ = true;
        if (!Tr::eq_int_type(c, Tr::eof())) last_ = Tr::to_char_type(c);
        return Tr::to_int_type(last_);
    }
    virtual streamsize showmanyc() { return held_ ? 1 : 0; }
    virtual int_type overflow(int_type c = Tr::eof()) {
        if (f_ == 0) return Tr::eof();
        if (Tr::eq_int_type(c, Tr::eof())) return Tr::not_eof(c);
        unread();
        return __cxx1_file_chars<C>::put(f_, Tr::to_char_type(c)) ? c : Tr::eof();
    }
    virtual streamsize xsputn(const char_type *s, streamsize n) {
        if (f_ == 0) return 0;
        unread();
        streamsize i = 0;
        while (i < n && __cxx1_file_chars<C>::put(f_, s[i])) i++;
        return i;
    }
    virtual int sync() {
        if (f_ == 0) return 0;
        unread();
        return std::fflush(f_) == 0 ? 0 : -1;
    }
    virtual pos_type seekoff(off_type off, ios_base::seekdir way, ios_base::openmode = ios_base::in | ios_base::out) {
        if (f_ == 0) return pos_type(off_type(-1));
        unread();
        if (std::fseek(f_, static_cast<long>(off), way == ios_base::beg ? SEEK_SET : way == ios_base::cur ? SEEK_CUR : SEEK_END) != 0)
            return pos_type(off_type(-1));
        const long at = std::ftell(f_);
        return at < 0 ? pos_type(off_type(-1)) : pos_type(off_type(at));
    }
    virtual pos_type seekpos(pos_type sp, ios_base::openmode which = ios_base::in | ios_base::out) {
        return seekoff(off_type(sp), ios_base::beg, which);
    }

private:
    FILE *f_;
    bool owns_;
    ios_base::openmode mode_;
    bool held_;          // a character looked at and not taken
    char_type last_;
    long lastBytes_;

    // A character looked at and not taken goes back to the file before anything else happens to it.
    void unread() {
        if (!held_) return;
        held_ = false;
        if (lastBytes_ == 1) std::ungetc(static_cast<unsigned char>(static_cast<char>(last_)), f_);
        else std::fseek(f_, -lastBytes_, SEEK_CUR);
    }
};
template <class C, class Tr> void swap(basic_filebuf<C, Tr> &x, basic_filebuf<C, Tr> &y) { x.swap(y); }

template <class C, class Tr> class basic_ifstream : public basic_istream<C, Tr> {
    basic_filebuf<C, Tr> sb_;

public:
    basic_ifstream() : basic_istream<C, Tr>(&sb_) {}
    explicit basic_ifstream(const char *s, ios_base::openmode mode = ios_base::in) : basic_istream<C, Tr>(&sb_) { open(s, mode); }
    explicit basic_ifstream(const string &s, ios_base::openmode mode = ios_base::in) : basic_istream<C, Tr>(&sb_) { open(s, mode); }
    basic_ifstream(const basic_ifstream &) = delete;
    basic_ifstream(basic_ifstream &&rhs) : basic_istream<C, Tr>(std::move(rhs)), sb_(std::move(rhs.sb_)) {
        this->set_rdbuf(&sb_);
    }
    basic_ifstream &operator=(const basic_ifstream &) = delete;
    basic_ifstream &operator=(basic_ifstream &&rhs) { swap(rhs); return *this; }
    void swap(basic_ifstream &rhs) { basic_istream<C, Tr>::swap(rhs); sb_.swap(rhs.sb_); }
    basic_filebuf<C, Tr> *rdbuf() const { return const_cast<basic_filebuf<C, Tr> *>(&sb_); }
    bool is_open() const { return sb_.is_open(); }
    void open(const char *s, ios_base::openmode mode = ios_base::in) {
        if (sb_.open(s, mode | ios_base::in) == 0) this->setstate(ios_base::failbit);
        else this->clear();
    }
    void open(const string &s, ios_base::openmode mode = ios_base::in) { open(s.c_str(), mode); }
    void close() { if (sb_.close() == 0) this->setstate(ios_base::failbit); }
};

template <class C, class Tr> class basic_ofstream : public basic_ostream<C, Tr> {
    basic_filebuf<C, Tr> sb_;

public:
    basic_ofstream() : basic_ostream<C, Tr>(&sb_) {}
    explicit basic_ofstream(const char *s, ios_base::openmode mode = ios_base::out) : basic_ostream<C, Tr>(&sb_) { open(s, mode); }
    explicit basic_ofstream(const string &s, ios_base::openmode mode = ios_base::out) : basic_ostream<C, Tr>(&sb_) { open(s, mode); }
    basic_ofstream(const basic_ofstream &) = delete;
    basic_ofstream(basic_ofstream &&rhs) : basic_ostream<C, Tr>(std::move(rhs)), sb_(std::move(rhs.sb_)) {
        this->set_rdbuf(&sb_);
    }
    basic_ofstream &operator=(const basic_ofstream &) = delete;
    basic_ofstream &operator=(basic_ofstream &&rhs) { swap(rhs); return *this; }
    void swap(basic_ofstream &rhs) { basic_ostream<C, Tr>::swap(rhs); sb_.swap(rhs.sb_); }
    basic_filebuf<C, Tr> *rdbuf() const { return const_cast<basic_filebuf<C, Tr> *>(&sb_); }
    bool is_open() const { return sb_.is_open(); }
    void open(const char *s, ios_base::openmode mode = ios_base::out) {
        if (sb_.open(s, mode | ios_base::out) == 0) this->setstate(ios_base::failbit);
        else this->clear();
    }
    void open(const string &s, ios_base::openmode mode = ios_base::out) { open(s.c_str(), mode); }
    void close() { if (sb_.close() == 0) this->setstate(ios_base::failbit); }
};

template <class C, class Tr> class basic_fstream : public basic_iostream<C, Tr> {
    basic_filebuf<C, Tr> sb_;

public:
    basic_fstream() : basic_iostream<C, Tr>(&sb_) {}
    explicit basic_fstream(const char *s, ios_base::openmode mode = ios_base::in | ios_base::out) : basic_iostream<C, Tr>(&sb_) {
        open(s, mode);
    }
    explicit basic_fstream(const string &s, ios_base::openmode mode = ios_base::in | ios_base::out) : basic_iostream<C, Tr>(&sb_) {
        open(s, mode);
    }
    basic_fstream(const basic_fstream &) = delete;
    basic_fstream(basic_fstream &&rhs) : basic_iostream<C, Tr>(std::move(rhs)), sb_(std::move(rhs.sb_)) {
        this->set_rdbuf(&sb_);
    }
    basic_fstream &operator=(const basic_fstream &) = delete;
    basic_fstream &operator=(basic_fstream &&rhs) { swap(rhs); return *this; }
    void swap(basic_fstream &rhs) { basic_iostream<C, Tr>::swap(rhs); sb_.swap(rhs.sb_); }
    basic_filebuf<C, Tr> *rdbuf() const { return const_cast<basic_filebuf<C, Tr> *>(&sb_); }
    bool is_open() const { return sb_.is_open(); }
    void open(const char *s, ios_base::openmode mode = ios_base::in | ios_base::out) {
        if (sb_.open(s, mode) == 0) this->setstate(ios_base::failbit);
        else this->clear();
    }
    void open(const string &s, ios_base::openmode mode = ios_base::in | ios_base::out) { open(s.c_str(), mode); }
    void close() { if (sb_.close() == 0) this->setstate(ios_base::failbit); }
};

template <class C, class Tr> void swap(basic_ifstream<C, Tr> &x, basic_ifstream<C, Tr> &y) { x.swap(y); }
template <class C, class Tr> void swap(basic_ofstream<C, Tr> &x, basic_ofstream<C, Tr> &y) { x.swap(y); }
template <class C, class Tr> void swap(basic_fstream<C, Tr> &x, basic_fstream<C, Tr> &y) { x.swap(y); }

