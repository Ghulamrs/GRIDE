// [unique.ptr.single]
template <class T, class D = default_delete<T> >
class unique_ptr {
public:
    typedef T *pointer;
    typedef T element_type;
    typedef D deleter_type;

    unique_ptr() noexcept : s_() {}
    unique_ptr(std::nullptr_t) noexcept : s_() {}
    explicit unique_ptr(pointer p) noexcept : s_(p) {}
    unique_ptr(pointer p, const typename remove_reference<D>::type &d) noexcept : s_(p, d) {}
    unique_ptr(pointer p, typename remove_reference<D>::type &&d) noexcept : s_(p, std::move(d)) {}
    unique_ptr(unique_ptr &&u) noexcept : s_(u.release(), std::forward<D>(u.get_deleter())) {}
    // Unconstrained, as this compiler cannot constrain it yet, and instantiated by it for
    // conversions nothing chose - so the pointer goes by a cast that compiles for any U, and is
    // the implicit conversion for every U* that has one. It takes the source by value, which a
    // move gives it: instantiated for U = T as `unique_ptr<U, E> &&` it was taken for a second
    // move constructor.
    template <class U, class E>
    unique_ptr(unique_ptr<U, E> u) noexcept : s_((T *)u.release(), std::forward<E>(u.get_deleter())) {}
    unique_ptr(const unique_ptr &) = delete;
    unique_ptr &operator=(const unique_ptr &) = delete;
    ~unique_ptr() { if (s_.ptr() != pointer()) s_.deleter()(s_.ptr()); }

    unique_ptr &operator=(unique_ptr &&u) noexcept {
        reset(u.release());
        s_.assignDeleter(std::forward<D>(u.get_deleter()));
        return *this;
    }
    unique_ptr &operator=(std::nullptr_t) noexcept { reset(); return *this; }

    typename __cxx1_lref<T>::type operator*() const { return *s_.ptr(); }
    pointer operator->() const noexcept { return s_.ptr(); }
    pointer get() const noexcept { return s_.ptr(); }
    deleter_type &get_deleter() noexcept { return s_.deleter(); }
    const deleter_type &get_deleter() const noexcept { return s_.deleter(); }
    explicit operator bool() const noexcept { return s_.ptr() != pointer(); }

    pointer release() noexcept {
        pointer was = s_.ptr();
        s_.ptr() = pointer();
        return was;
    }
    void reset(pointer p = pointer()) noexcept {
        pointer old = s_.ptr();
        s_.ptr() = p;
        if (old != pointer()) s_.deleter()(old);
    }
    void swap(unique_ptr &u) noexcept {
        std::__cxx1_swap_adl(s_.ptr(), u.s_.ptr());
        s_.swapDeleter(u.s_);
    }

private:
    __cxx1_ptr_and_deleter<T *, D> s_;
};

