// [temporary.buffer]: as much of n as can be had, halving until an allocation succeeds.
template <class T>
pair<T *, std::ptrdiff_t> get_temporary_buffer(std::ptrdiff_t n) noexcept {
    const std::ptrdiff_t most = (std::ptrdiff_t)((std::size_t)-1 / 2 / sizeof(T));
    if (n > most) n = most;
    for (; n > 0; n /= 2) {
        T *p = static_cast<T *>(operator new((std::size_t)n * sizeof(T), std::nothrow));
        if (p != 0) return pair<T *, std::ptrdiff_t>(p, n);
    }
    return pair<T *, std::ptrdiff_t>((T *)0, 0);
}

template <class T>
void return_temporary_buffer(T *p) {
    operator delete(p);
}

// [util.dynamic.safety]: collection is not done here, so every pointer is safe and there is
// nothing to declare.
enum class pointer_safety { relaxed, preferred, strict };
inline void declare_reachable(void *) {}
template <class T> T *undeclare_reachable(T *p) { return p; }
inline void declare_no_pointers(char *, std::size_t) {}
inline void undeclare_no_pointers(char *, std::size_t) {}
inline pointer_safety get_pointer_safety() noexcept { return pointer_safety::relaxed; }

// [ptr.align]
inline void *align(std::size_t alignment, std::size_t size, void *&ptr, std::size_t &space) {
    const std::size_t at = (std::size_t)ptr;
    const std::size_t skip = (alignment - at % alignment) % alignment;
    if (space < size || space - size < skip) return 0;
    ptr = (void *)(at + skip);
    space -= skip;
    return ptr;
}

