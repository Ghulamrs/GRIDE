    template <class E> __cxx1_ptr_and_deleter(P p, E &&d) : p_(p), d_(std::forward<E>(d)) {}
    P &ptr() { return p_; }
    const P &ptr() const { return p_; }
    D &deleter() { return d_; }
    const D &deleter() const { return d_; }
    template <class E> void assignDeleter(E &&d) { d_ = std::forward<E>(d); }
    void swapDeleter(__cxx1_ptr_and_deleter &o) { std::__cxx1_swap_adl(d_, o.d_); }

