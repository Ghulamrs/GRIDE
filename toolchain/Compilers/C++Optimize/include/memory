// The control block: the owners counted in uses_, and in weaks_ every weak_ptr plus one for the
// owners together, so the block goes when the last of either does.
class __cxx1_shared_count {
public:
    __cxx1_shared_count() : uses_(1), weaks_(1) {}
    virtual ~__cxx1_shared_count() {}
    virtual void dispose() noexcept = 0;
    virtual void *deleter(const type_info &) noexcept { return 0; }
    void addUse() noexcept { ++uses_; }
    bool addUseIfAlive() noexcept {
        if (uses_ == 0) return false;
        ++uses_;
        return true;
    }
    void releaseUse() noexcept {
        if (--uses_ == 0) {
            dispose();
            releaseWeak();
        }
    }
    void addWeak() noexcept { ++weaks_; }
    void releaseWeak() noexcept { if (--weaks_ == 0) delete this; }
    long uses() const noexcept { return uses_; }

private:
    long uses_;
    long weaks_;
};

template <class P, class D>
class __cxx1_shared_block : public __cxx1_shared_count {
public:
    __cxx1_shared_block(P p, D d) : p_(p), d_(d) {}
    virtual void dispose() noexcept { d_(p_); }
    virtual void *deleter(const type_info &t) noexcept {
        if (t == typeid(D)) return &d_;
        return 0;
    }

private:
    P p_;
    D d_;
};

