// [specialized.algorithms]: what was built is destroyed again if a constructor throws.
template <class In, class For>
For uninitialized_copy(In first, In last, For result) {
    For built = result;
    try {
        for (; first != last; ++first, ++built) std::__cxx1_construct_at(std::addressof(*built), *first);
    } catch (...) {
        for (; result != built; ++result) std::__cxx1_destroy_at(std::addressof(*result));
        throw;
    }
    return built;
}

template <class In, class Size, class For>
For uninitialized_copy_n(In first, Size n, For result) {
    For built = result;
    try {
        for (; n > 0; ++first, ++built, --n) std::__cxx1_construct_at(std::addressof(*built), *first);
    } catch (...) {
        for (; result != built; ++result) std::__cxx1_destroy_at(std::addressof(*result));
        throw;
    }
    return built;
}

template <class For, class T>
void uninitialized_fill(For first, For last, const T &value) {
    For built = first;
    try {
        for (; built != last; ++built) std::__cxx1_construct_at(std::addressof(*built), value);
    } catch (...) {
        for (; first != built; ++first) std::__cxx1_destroy_at(std::addressof(*first));
        throw;
    }
}

template <class For, class Size, class T>
void uninitialized_fill_n(For first, Size n, const T &value) {
    For built = first;
    try {
        for (; n > 0; ++built, --n) std::__cxx1_construct_at(std::addressof(*built), value);
    } catch (...) {
        for (; first != built; ++first) std::__cxx1_destroy_at(std::addressof(*first));
        throw;
    }
}

