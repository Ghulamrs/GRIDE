template <class T> char __cxx1_class_test(int T::*) { return 0; }
template <class T> long __cxx1_class_test(...) { return 0; }
template <class T> struct __cxx1_is_class { static const bool value = sizeof(std::__cxx1_class_test<T>(0)) == 1; };

template <class T, bool = __cxx1_is_class<T>::value> struct __cxx1_is_empty { static const bool value = false; };
template <class T> struct __cxx1_is_empty<T, true> {
    struct __probe : T { int __x; };
    static const bool value = sizeof(__probe) == sizeof(int);
};

