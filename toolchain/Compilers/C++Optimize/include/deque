// <deque> - [deque]: a double-ended queue. Elements live in fixed-size blocks that never move, hung off a map of
// block pointers; element i is at absolute place start_ + i of the map, block (place / B), slot (place % B). A push
// at either end grows the map when it runs out and moves no element, so references stay valid as [deque.modifiers]
// says, while iterators - a map pointer and a place - are invalidated with the map.
//
// The allocator is kept and handed back, as <vector>'s is: the blocks come from it and the map from it rebound
// to block pointers, and each element is made and destroyed through allocator_traits.
#ifndef _CXX1_DEQUE
#define _CXX1_DEQUE

#include <cstddef>
#include <cstring>
#include <initializer_list>
#include <new>
#include <stdexcept>
#include <utility>
#include <type_traits>
#include <__allocator>
#include <__iterator_base>

namespace std {

template <class T> struct __cxx1_deque_block {
    static const std::size_t size = sizeof(T) < 256 ? 4096 / sizeof(T) : 16;
};

template <class T, class Ref, class Ptr> class __cxx1_deque_iterator {
public:
    typedef random_access_iterator_tag iterator_category;
    typedef T value_type;
    typedef std::ptrdiff_t difference_type;
    typedef Ptr pointer;
    typedef Ref reference;
    static const std::size_t B = __cxx1_deque_block<T>::size;

    __cxx1_deque_iterator() : map(0), place(0) {}
    __cxx1_deque_iterator(T **m, std::size_t p) : map(m), place(p) {}
    // iterator to const_iterator; the copy constructor where the two are one type.
    __cxx1_deque_iterator(const __cxx1_deque_iterator<T, T &, T *> &o) : map(o.map), place(o.place) {}

    Ref operator*() const { return map[place / B][place % B]; }
    Ptr operator->() const { return &map[place / B][place % B]; }
    Ref operator[](difference_type n) const { return *(*this + n); }
    __cxx1_deque_iterator &operator++() { ++place; return *this; }
    __cxx1_deque_iterator operator++(int) { __cxx1_deque_iterator t = *this; ++place; return t; }
    __cxx1_deque_iterator &operator--() { --place; return *this; }
    __cxx1_deque_iterator operator--(int) { __cxx1_deque_iterator t = *this; --place; return t; }
    __cxx1_deque_iterator &operator+=(difference_type n) { place += n; return *this; }
    __cxx1_deque_iterator &operator-=(difference_type n) { place -= n; return *this; }
    __cxx1_deque_iterator operator+(difference_type n) const { return __cxx1_deque_iterator(map, place + n); }
    __cxx1_deque_iterator operator-(difference_type n) const { return __cxx1_deque_iterator(map, place - n); }

    T **map;
    std::size_t place;
};
template <class T, class R1, class P1, class R2, class P2>
inline std::ptrdiff_t operator-(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) {
    return (std::ptrdiff_t)a.place - (std::ptrdiff_t)b.place;
}
template <class T, class R, class P>
inline __cxx1_deque_iterator<T, R, P> operator+(std::ptrdiff_t n, const __cxx1_deque_iterator<T, R, P> &x) { return x + n; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator==(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place == b.place; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator!=(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place != b.place; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator<(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place < b.place; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator>(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place > b.place; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator<=(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place <= b.place; }
template <class T, class R1, class P1, class R2, class P2>
inline bool operator>=(const __cxx1_deque_iterator<T, R1, P1> &a, const __cxx1_deque_iterator<T, R2, P2> &b) { return a.place >= b.place; }

template <class T, class Alloc = allocator<T> > class deque {
    static const std::size_t B = __cxx1_deque_block<T>::size;

public:
    typedef T value_type;
    typedef Alloc allocator_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef T *pointer;
    typedef const T *const_pointer;
    typedef std::size_t size_type;
    typedef std::ptrdiff_t difference_type;
    typedef __cxx1_deque_iterator<T, T &, T *> iterator;
    typedef __cxx1_deque_iterator<T, const T &, const T *> const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    deque() { empty0(); }
    explicit deque(const Alloc &a) : alloc_(a) { empty0(); }
    explicit deque(size_type n) {
        empty0();
        for (; n > 0; --n) emplace_back();
    }
    deque(size_type n, const T &v, const Alloc &a = Alloc()) : alloc_(a) {
        empty0();
        for (; n > 0; --n) push_back(v);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    deque(It first, It last, const Alloc &a = Alloc()) : alloc_(a) {
        empty0();
        for (; first != last; ++first) push_back(*first);
    }
    deque(const deque &o) : alloc_(o.alloc_) {
        empty0();
        for (size_type i = 0; i < o.size_; i++) push_back(o[i]);
    }
    deque(deque &&o) : alloc_(o.alloc_) {
        empty0();
        take(o);
    }
    deque(const deque &o, const Alloc &a) : alloc_(a) {
        empty0();
        for (size_type i = 0; i < o.size_; i++) push_back(o[i]);
    }
    deque(deque &&o, const Alloc &a) : alloc_(a) {
        empty0();
        take(o);
    }
    deque(initializer_list<T> il, const Alloc &a = Alloc()) : alloc_(a) {
        empty0();
        for (const T *p = il.begin(); p != il.end(); ++p) push_back(*p);
    }
    ~deque() {
        clear();
        release();
    }

    deque &operator=(const deque &o) {
        if (this != &o) assign(o.begin(), o.end());
        return *this;
    }
    deque &operator=(deque &&o) {
        if (this != &o) {
            clear();
            release();
            empty0();
            take(o);
        }
        return *this;
    }
    deque &operator=(initializer_list<T> il) {
        assign(il.begin(), il.end());
        return *this;
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    void assign(It first, It last) {
        clear();
        for (; first != last; ++first) push_back(*first);
    }
    void assign(size_type n, const T &v) {
        clear();
        for (; n > 0; --n) push_back(v);
    }
    void assign(initializer_list<T> il) { assign(il.begin(), il.end()); }
    allocator_type get_allocator() const noexcept { return alloc_; }

    iterator begin() noexcept { return iterator(map_, start_); }
    const_iterator begin() const noexcept { return const_iterator(map_, start_); }
    iterator end() noexcept { return iterator(map_, start_ + size_); }
    const_iterator end() const noexcept { return const_iterator(map_, start_ + size_); }
    reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }
    const_iterator cbegin() const noexcept { return begin(); }
    const_iterator cend() const noexcept { return end(); }
    const_reverse_iterator crbegin() const noexcept { return rbegin(); }
    const_reverse_iterator crend() const noexcept { return rend(); }

    size_type size() const noexcept { return size_; }
    size_type max_size() const noexcept { return (size_type)-1 / sizeof(T); }
    void resize(size_type n) {
        while (size_ > n) pop_back();
        while (size_ < n) emplace_back();
    }
    void resize(size_type n, const T &v) {
        while (size_ > n) pop_back();
        while (size_ < n) push_back(v);
    }
    void shrink_to_fit() {}
    bool empty() const noexcept { return size_ == 0; }

    T &operator[](size_type i) { return slot(start_ + i); }
    const T &operator[](size_type i) const { return slot(start_ + i); }
    T &at(size_type i) {
        if (i >= size_) throw out_of_range("deque::at");
        return slot(start_ + i);
    }
    const T &at(size_type i) const {
        if (i >= size_) throw out_of_range("deque::at");
        return slot(start_ + i);
    }
    T &front() { return slot(start_); }
    const T &front() const { return slot(start_); }
    T &back() { return slot(start_ + size_ - 1); }
    const T &back() const { return slot(start_ + size_ - 1); }

    template <class... A> void emplace_front(A &&... a) {
        if (start_ == 0) growFront();
        allocator_traits<Alloc>::construct(alloc_, place(start_ - 1), std::forward<A>(a)...);
        --start_;
        ++size_;
    }
    template <class... A> void emplace_back(A &&... a) {
        if (start_ + size_ == blocks_ * B) growBack();
        allocator_traits<Alloc>::construct(alloc_, place(start_ + size_), std::forward<A>(a)...);
        ++size_;
    }
    // Made at an end, then moved to its place from the nearer one.
    template <class... A> iterator emplace(const_iterator pos, A &&... a) {
        const size_type k = pos.place - start_;
        if (k <= size_ / 2) {
            emplace_front(std::forward<A>(a)...);
            T held(std::move(slot(start_)));
            for (size_type i = 0; i < k; i++) slot(start_ + i) = std::move(slot(start_ + i + 1));
            slot(start_ + k) = std::move(held);
        } else {
            emplace_back(std::forward<A>(a)...);
            T held(std::move(slot(start_ + size_ - 1)));
            for (size_type i = size_ - 1; i > k; i--) slot(start_ + i) = std::move(slot(start_ + i - 1));
            slot(start_ + k) = std::move(held);
        }
        return iterator(map_, start_ + k);
    }
    void push_front(const T &v) { emplace_front(v); }
    void push_front(T &&v) { emplace_front(std::move(v)); }
    void push_back(const T &v) { emplace_back(v); }
    void push_back(T &&v) { emplace_back(std::move(v)); }
    iterator insert(const_iterator pos, const T &v) { return emplace(pos, v); }
    iterator insert(const_iterator pos, T &&v) { return emplace(pos, std::move(v)); }
    iterator insert(const_iterator pos, size_type n, const T &v) {
        const size_type k = pos.place - start_;
        for (size_type i = 0; i < n; i++) emplace(const_iterator(map_, start_ + k + i), v);
        return iterator(map_, start_ + k);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type>
    iterator insert(const_iterator pos, It first, It last) {
        const size_type k = pos.place - start_;
        for (size_type i = k; first != last; ++first, ++i) emplace(const_iterator(map_, start_ + i), *first);
        return iterator(map_, start_ + k);
    }
    iterator insert(const_iterator pos, initializer_list<T> il) { return insert(pos, il.begin(), il.end()); }

    void pop_front() {
        allocator_traits<Alloc>::destroy(alloc_, &slot(start_));
        ++start_;
        --size_;
    }
    void pop_back() {
        --size_;
        allocator_traits<Alloc>::destroy(alloc_, &slot(start_ + size_));
    }
    // The elements on the nearer side moved over the gap, and the end they leave popped.
    iterator erase(const_iterator pos) {
        const size_type k = pos.place - start_;
        if (k < size_ / 2) {
            for (size_type i = k; i > 0; i--) slot(start_ + i) = std::move(slot(start_ + i - 1));
            pop_front();
        } else {
            for (size_type i = k; i + 1 < size_; i++) slot(start_ + i) = std::move(slot(start_ + i + 1));
            pop_back();
        }
        return iterator(map_, start_ + k);
    }
    iterator erase(const_iterator first, const_iterator last) {
        const size_type k = first.place - start_, n = last.place - first.place;
        if (n == 0) return iterator(map_, first.place);
        if (k < size_ - k - n) {
            for (size_type i = k; i > 0; i--) slot(start_ + i - 1 + n) = std::move(slot(start_ + i - 1));
            for (size_type i = 0; i < n; i++) pop_front();
        } else {
            for (size_type i = k + n; i < size_; i++) slot(start_ + i - n) = std::move(slot(start_ + i));
            for (size_type i = 0; i < n; i++) pop_back();
        }
        return iterator(map_, start_ + k);
    }
    void swap(deque &o) {
        T **m = map_; map_ = o.map_; o.map_ = m;
        size_type t = blocks_; blocks_ = o.blocks_; o.blocks_ = t;
        t = start_; start_ = o.start_; o.start_ = t;
        t = size_; size_ = o.size_; o.size_ = t;
    }
    void clear() noexcept {
        while (size_ != 0) pop_back();
        start_ = blocks_ * B / 2;
    }

private:
    T &slot(size_type p) const { return map_[p / B][p % B]; }
    // The slot's storage, its block made if it has none yet.
    T *place(size_type p) {
        T *&block = map_[p / B];
        if (block == 0) block = allocator_traits<Alloc>::allocate(alloc_, B);
        return block + p % B;
    }
    void empty0() {
        map_ = 0;
        blocks_ = 0;
        start_ = 0;
        size_ = 0;
    }
    void take(deque &o) {
        map_ = o.map_;
        blocks_ = o.blocks_;
        start_ = o.start_;
        size_ = o.size_;
        o.empty0();
    }
    void release() {
        for (size_type b = 0; b < blocks_; b++)
            if (map_[b] != 0) allocator_traits<Alloc>::deallocate(alloc_, map_[b], B);
        if (map_ != 0) __cxx1_nodes<T *, Alloc>::put(alloc_, map_, blocks_);
        map_ = 0;
        blocks_ = 0;
    }
    // The map doubled, the old blocks laid at `shift` in it: their elements keep their addresses.
    void regrow(size_type shift, size_type total) {
        T **m = __cxx1_nodes<T *, Alloc>::get(alloc_, total);
        for (size_type b = 0; b < total; b++) m[b] = 0;
        for (size_type b = 0; b < blocks_; b++) m[b + shift] = map_[b];
        if (map_ != 0) __cxx1_nodes<T *, Alloc>::put(alloc_, map_, blocks_);
        map_ = m;
        blocks_ = total;
        start_ += shift * B;
    }
    void growBack() {
        if (blocks_ == 0) {
            regrow(0, 2);
            start_ = B;
            return;
        }
        regrow(0, blocks_ * 2);
    }
    void growFront() {
        if (blocks_ == 0) {
            regrow(0, 2);
            start_ = B;
            return;
        }
        regrow(blocks_, blocks_ * 2);
    }

    T **map_;
    size_type blocks_;
    size_type start_;
    size_type size_;
    Alloc alloc_;
};

template <class T, class A> inline bool operator==(const deque<T, A> &x, const deque<T, A> &y) {
    if (x.size() != y.size()) return false;
    for (std::size_t i = 0; i < x.size(); i++)
        if (!(x[i] == y[i])) return false;
    return true;
}
template <class T, class A> inline bool operator<(const deque<T, A> &x, const deque<T, A> &y) {
    for (std::size_t i = 0; i < x.size() && i < y.size(); i++) {
        if (x[i] < y[i]) return true;
        if (y[i] < x[i]) return false;
    }
    return x.size() < y.size();
}
template <class T, class A> inline bool operator!=(const deque<T, A> &x, const deque<T, A> &y) { return !(x == y); }
template <class T, class A> inline bool operator>(const deque<T, A> &x, const deque<T, A> &y) { return y < x; }
template <class T, class A> inline bool operator>=(const deque<T, A> &x, const deque<T, A> &y) { return !(x < y); }
template <class T, class A> inline bool operator<=(const deque<T, A> &x, const deque<T, A> &y) { return !(y < x); }
template <class T, class A> inline void swap(deque<T, A> &x, deque<T, A> &y) { x.swap(y); }

}  // namespace std

#endif
