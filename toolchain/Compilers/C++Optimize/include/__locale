template <class charT, class traits, class Allocator>
bool locale::operator()(const basic_string<charT, traits, Allocator> &s1, const basic_string<charT, traits, Allocator> &s2) const {
    // std::collate: inside locale, collate is the category.
    const std::collate<charT> &c = std::use_facet<std::collate<charT> >(*this);
