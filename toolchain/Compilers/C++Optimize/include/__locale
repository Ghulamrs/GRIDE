    if (e - p < extra + 1) return -2;
    for (int i = 1; i <= extra; i++) {
        if ((p[i] & 0xC0) != 0x80) return -1;
        cp = (cp << 6) | (p[i] & 0x3F);
    }
    if ((extra == 2 && cp < 0x800) || (extra == 3 && cp < 0x10000) || (cp >= 0xD800 && cp <= 0xDFFF) || cp > maxcode)
        return -1;
    from += extra + 1;
    return static_cast<long>(cp);
}
// Writing answers the bytes it took, 0 where there is no room, -1 for no code point.
inline int __cxx1_utf8_write(unsigned long cp, char *&to, char *end) {
    if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) return -1;
    const int n = cp < 0x80 ? 1 : cp < 0x800 ? 2 : cp < 0x10000 ? 3 : 4;
    if (end - to < n) return 0;
    unsigned char *q = reinterpret_cast<unsigned char *>(to);
    if (n == 1) q[0] = static_cast<unsigned char>(cp);
    else if (n == 2) { q[0] = static_cast<unsigned char>(0xC0 | (cp >> 6)); q[1] = static_cast<unsigned char>(0x80 | (cp & 0x3F)); }
    else if (n == 3) {
        q[0] = static_cast<unsigned char>(0xE0 | (cp >> 12));
        q[1] = static_cast<unsigned char>(0x80 | ((cp >> 6) & 0x3F));
        q[2] = static_cast<unsigned char>(0x80 | (cp & 0x3F));
    } else {
        q[0] = static_cast<unsigned char>(0xF0 | (cp >> 18));
        q[1] = static_cast<unsigned char>(0x80 | ((cp >> 12) & 0x3F));
        q[2] = static_cast<unsigned char>(0x80 | ((cp >> 6) & 0x3F));
        q[3] = static_cast<unsigned char>(0x80 | (cp & 0x3F));
    }
    to += n;
    return n;
}

