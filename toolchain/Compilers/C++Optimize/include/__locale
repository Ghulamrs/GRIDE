// [locale.codecvt]
class codecvt_base {
public:
    enum result { ok, partial, error, noconv };
};

// UTF-8 for the conversions of char16_t, char32_t and <codecvt>: one code point read or written at a time.
// Reading answers the code point, or -1 for an ill-formed sequence, -2 for one cut short.
inline long __cxx1_utf8_read(const char *&from, const char *end, unsigned long maxcode) {
    const unsigned char *p = reinterpret_cast<const unsigned char *>(from);
    const unsigned char *e = reinterpret_cast<const unsigned char *>(end);
    const unsigned char c = *p;
    unsigned long cp;
    int extra;
    if (c < 0x80) { cp = c; extra = 0; }
    else if (c < 0xC2) return -1;
    else if (c < 0xE0) { cp = c & 0x1F; extra = 1; }
    else if (c < 0xF0) { cp = c & 0x0F; extra = 2; }
