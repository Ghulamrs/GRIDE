// <__locale> - [locales]: the locale, and the facets every stream needs - ctype, codecvt, numpunct, collate.
//
// A locale shares a table of facets indexed by each facet type's locale::id. The "C" locale is the only named
// one: "C", "POSIX" and "" name it. Its standard facets are made the first time one is asked for, so a facet is
// declared in the header that can define it (num_get and num_put beside the streams) and still belongs to every
// locale that has not replaced it.
#ifndef _CXX1___LOCALE
#define _CXX1___LOCALE

#include <cctype>
#include <climits>
#include <clocale>
#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <cwchar>
#include <cwctype>
#include <new>
#include <stdexcept>
#include <string>
#include <typeinfo>
#include <__threads>

namespace std {

class locale;
template <class Facet> const Facet &use_facet(const locale &loc);
template <class Facet> bool has_facet(const locale &loc) noexcept;

// What a standard facet is and how the "C" locale makes it: specialized beside each standard facet.
template <class Facet> struct __cxx1_standard_facet {
    static const bool is = false;
    static Facet *make() { return 0; }
};

struct __cxx1_locale_rep;

class locale {
public:
    // [locale.facet]: a facet made with refs 0 is deleted with the last locale holding it; one made with refs 1
    // is the program's to delete.
    class facet {
        friend class locale;
        friend struct __cxx1_locale_rep;
        size_t refs_;
        size_t uses_;

    protected:
        explicit facet(size_t refs = 0) : refs_(refs), uses_(0) {}
        virtual ~facet() {}

    public:
        // The category a standard facet belongs to, for locale(other, one, cats); a program's own has none.
        static const int __cxx1_category = 0;
        facet(const facet &) = delete;
        void operator=(const facet &) = delete;
    };
    // [locale.id]: each facet type's index in every locale, given out the first time the type is asked for.
    class id {
        friend class locale;
        size_t index_;

    public:
        id() {}
        void operator=(const id &) = delete;
        id(const id &) = delete;
        size_t __cxx1_index() {
            if (index_ == 0) {
                std::__cxx1_os::global_guard g;
                if (index_ == 0) index_ = ++counter();
            }
            return index_;
        }

    private:
        static size_t &counter() {
            static size_t n = 0;
            return n;
        }
    };

    typedef int category;
    static const category none = 0;
    static const category collate = 0x010;
    static const category ctype = 0x020;
    static const category monetary = 0x040;
    static const category numeric = 0x080;
    static const category time = 0x100;
    static const category messages = 0x200;
    static const category all = collate | ctype | monetary | numeric | time | messages;

    locale() noexcept;
    locale(const locale &other) noexcept;
    explicit locale(const char *std_name);
    explicit locale(const string &std_name);
    locale(const locale &other, const char *std_name, category cats);
    locale(const locale &other, const string &std_name, category cats);
    template <class Facet> locale(const locale &other, Facet *f);
    locale(const locale &other, const locale &one, category cats);
    ~locale();
    const locale &operator=(const locale &other) noexcept;

    template <class Facet> locale combine(const locale &other) const;
    string name() const;
    // Which table this locale reads: a stream's cached facet is still good while this has not changed.
    const void *__cxx1_key() const noexcept { return rep_; }
    bool operator==(const locale &other) const;
    bool operator!=(const locale &other) const { return !(*this == other); }
    template <class charT, class traits, class Allocator>
    bool operator()(const basic_string<charT, traits, Allocator> &s1, const basic_string<charT, traits, Allocator> &s2) const;

    static locale global(const locale &loc);
    static const locale &classic();

    // The facet at an index, the "C" locale's where this one has none; null where neither has it.
    const facet *__cxx1_find(size_t index) const;
    // The "C" locale's standard facet at an index, made now if it has not been.
    const facet *__cxx1_standard(size_t index, facet *(*make)(), int cat) const;

private:
    explicit locale(__cxx1_locale_rep *r) : rep_(r) {}
    static __cxx1_locale_rep *classicRep();
    static locale &globalLocale();
    static bool cName(const char *name) { return name != 0 && (std::strcmp(name, "C") == 0 || std::strcmp(name, "POSIX") == 0 || name[0] == 0); }
    static void refuseName(const char *name) {
        if (!cName(name))
            throw runtime_error(string("locale: '") + (name != 0 ? name : "(null)") +
                                "' is not a locale this implementation has - \"C\" is the only one");
    }
    void replaceCategories(const locale &from, category cats);

    __cxx1_locale_rep *rep_;
};

// The table: facets by index, each with its category. `base` is the "C" locale's table, read where this one has
// nothing at an index; the "C" locale's own has none.
struct __cxx1_locale_rep {
    size_t uses;
    size_t size;
    locale::facet **facets;
    int *cats;
    string name;
    __cxx1_locale_rep *base;

    __cxx1_locale_rep() : uses(1), size(0), facets(0), cats(0), name("C"), base(0) {}
    ~__cxx1_locale_rep() {
        for (size_t i = 0; i < size; i++) drop(facets[i]);
        delete[] facets;
        delete[] cats;
    }
    static void hold(locale::facet *f) {
        if (f != 0) f->uses_++;
    }
    static void drop(locale::facet *f) {
        if (f != 0 && --f->uses_ == 0 && f->refs_ == 0) delete f;
    }
    void grow(size_t n) {
        if (n <= size) return;
        locale::facet **nf = new locale::facet *[n];
        int *nc = new int[n];
        for (size_t i = 0; i < n; i++) {
            nf[i] = i < size ? facets[i] : 0;
            nc[i] = i < size ? cats[i] : 0;
        }
        delete[] facets;
        delete[] cats;
        facets = nf;
        cats = nc;
        size = n;
    }
    void put(size_t index, locale::facet *f, int cat) {
        grow(index + 1);
        hold(f);
        drop(facets[index]);
        facets[index] = f;
        cats[index] = cat;
    }
    __cxx1_locale_rep *copy() const {
        __cxx1_locale_rep *r = new __cxx1_locale_rep;
        r->grow(size);
        for (size_t i = 0; i < size; i++) {
            hold(facets[i]);
            r->facets[i] = facets[i];
            r->cats[i] = cats[i];
        }
        r->name = name;
        r->base = base != 0 ? base : const_cast<__cxx1_locale_rep *>(this);
        return r;
    }
};

inline __cxx1_locale_rep *locale::classicRep() {
    static __cxx1_locale_rep *r = new __cxx1_locale_rep;
    return r;
}
inline locale &locale::globalLocale() {
    static locale *g = new locale(classic());
    return *g;
}
inline const locale &locale::classic() {
    static const locale *c = new locale(classicRep());
    return *c;
}
// The global locale is made before the lock is taken: making it copies the "C" locale, which takes the lock.
inline locale::locale() noexcept {
    locale &global = globalLocale();
    std::__cxx1_os::global_guard g;
    rep_ = global.rep_;
    rep_->uses++;
}
inline locale::locale(const locale &other) noexcept : rep_(other.rep_) {
    std::__cxx1_os::global_guard g;
    rep_->uses++;
}
inline locale::locale(const char *std_name) {
    refuseName(std_name);
    std::__cxx1_os::global_guard g;
    rep_ = classicRep();
    rep_->uses++;
}
inline locale::locale(const string &std_name) {
    refuseName(std_name.c_str());
    std::__cxx1_os::global_guard g;
    rep_ = classicRep();
    rep_->uses++;
}
inline locale::locale(const locale &other, const char *std_name, category cats) {
    refuseName(std_name);
    std::__cxx1_os::global_guard g;
    rep_ = other.rep_->copy();
    replaceCategories(classic(), cats);
    if (other.rep_->name != "C") rep_->name = "*";
}
inline locale::locale(const locale &other, const string &std_name, category cats) {
    refuseName(std_name.c_str());
    std::__cxx1_os::global_guard g;
    rep_ = other.rep_->copy();
    replaceCategories(classic(), cats);
    if (other.rep_->name != "C") rep_->name = "*";
}
inline locale::locale(const locale &other, const locale &one, category cats) {
    std::__cxx1_os::global_guard g;
    rep_ = other.rep_->copy();
    replaceCategories(one, cats);
    if (!(other.rep_->name == "C" && one.rep_->name == "C")) rep_->name = "*";
}
template <class Facet> locale::locale(const locale &other, Facet *f) {
    classicRep();
    if (f == 0) {
        std::__cxx1_os::global_guard g;
        rep_ = other.rep_;
        rep_->uses++;
        return;
    }
    const size_t index = Facet::id.__cxx1_index();
    std::__cxx1_os::global_guard g;
    rep_ = other.rep_->copy();
    rep_->put(index, f, Facet::__cxx1_category);
    rep_->name = "*";
}
inline locale::~locale() {
    __cxx1_locale_rep *dead = 0;
    {
        std::__cxx1_os::global_guard g;
        if (--rep_->uses == 0 && rep_ != classicRep()) dead = rep_;
    }
    delete dead;
}
inline const locale &locale::operator=(const locale &other) noexcept {
    __cxx1_locale_rep *dead = 0;
    {
        std::__cxx1_os::global_guard g;
        other.rep_->uses++;
        if (--rep_->uses == 0 && rep_ != classicRep()) dead = rep_;
        rep_ = other.rep_;
    }
    delete dead;
    return *this;
}
// A category's facets taken from `from`: this table's own of those categories dropped, then `from`'s own put in.
inline void locale::replaceCategories(const locale &from, category cats) {
    for (size_t i = 0; i < rep_->size; i++)
        if ((rep_->cats[i] & cats) != 0) {
            __cxx1_locale_rep::drop(rep_->facets[i]);
            rep_->facets[i] = 0;
            rep_->cats[i] = 0;
        }
    if (from.rep_ == classicRep()) return;
    for (size_t i = 0; i < from.rep_->size; i++)
        if (from.rep_->facets[i] != 0 && (from.rep_->cats[i] & cats) != 0) rep_->put(i, from.rep_->facets[i], from.rep_->cats[i]);
}
template <class Facet> locale locale::combine(const locale &other) const {
    if (!has_facet<Facet>(other)) throw runtime_error("locale::combine: the other locale has no such facet");
    return locale(*this, const_cast<Facet *>(&use_facet<Facet>(other)));
}
inline string locale::name() const {
    std::__cxx1_os::global_guard g;
    return rep_->name;
}
inline bool locale::operator==(const locale &other) const {
    if (rep_ == other.rep_) return true;
    std::__cxx1_os::global_guard g;
    return rep_->name != "*" && rep_->name == other.rep_->name;
}
// [locale.statics]/1: the global locale replaced, and the C library's set to it where it has a name. `was` holds
// the previous one, so its count does not reach 0 here.
inline locale locale::global(const locale &loc) {
    locale was;
    locale &cur = globalLocale();
    string named;
    {
        std::__cxx1_os::global_guard g;
        loc.rep_->uses++;
        cur.rep_->uses--;
        cur.rep_ = loc.rep_;
        named = loc.rep_->name;
    }
    if (named != "*") std::setlocale(LC_ALL, named.c_str());
    return was;
}
inline const locale::facet *locale::__cxx1_find(size_t index) const {
    std::__cxx1_os::global_guard g;
    for (const __cxx1_locale_rep *r = rep_; r != 0; r = r->base)
        if (index < r->size && r->facets[index] != 0) return r->facets[index];
    return 0;
}
inline const locale::facet *locale::__cxx1_standard(size_t index, facet *(*make)(), int cat) const {
    __cxx1_locale_rep *c = classicRep();
    {
        std::__cxx1_os::global_guard g;
        if (index < c->size && c->facets[index] != 0) return c->facets[index];
    }
    facet *f = make();
    std::__cxx1_os::global_guard g;
    if (index < c->size && c->facets[index] != 0) {
        delete f;
        return c->facets[index];
    }
    c->put(index, f, cat);
    return f;
}

template <class Facet> locale::facet *__cxx1_make_standard_facet() { return __cxx1_standard_facet<Facet>::make(); }

// The id of an explicit specialization's facet - ctype<char>, the codecvts - as a template's static member, so each
// program has one however many units include this.
template <class Facet> struct __cxx1_facet_id {
    static locale::id id;
};
template <class Facet> locale::id __cxx1_facet_id<Facet>::id;

// [locale.global.templates]
template <class Facet> const Facet &use_facet(const locale &loc) {
    const size_t index = Facet::id.__cxx1_index();
    const locale::facet *f = loc.__cxx1_find(index);
    if (f == 0 && __cxx1_standard_facet<Facet>::is)
        f = loc.__cxx1_standard(index, &__cxx1_make_standard_facet<Facet>, Facet::__cxx1_category);
    if (f == 0) throw bad_cast();
    return static_cast<const Facet &>(*f);
}
template <class Facet> bool has_facet(const locale &loc) noexcept {
    return __cxx1_standard_facet<Facet>::is || loc.__cxx1_find(Facet::id.__cxx1_index()) != 0;
}

// [category.ctype]
class ctype_base {
public:
    typedef unsigned short mask;
    static const mask space = 0x001;
    static const mask print = 0x002;
    static const mask cntrl = 0x004;
    static const mask upper = 0x008;
    static const mask lower = 0x010;
    static const mask alpha = 0x020;
    static const mask digit = 0x040;
    static const mask punct = 0x080;
    static const mask xdigit = 0x100;
    static const mask blank = 0x200;
    static const mask alnum = alpha | digit;
    static const mask graph = alnum | punct;
};

// The classification of one character in the "C" locale, wide or narrow.
inline ctype_base::mask __cxx1_classify(unsigned long c) {
    ctype_base::mask m = 0;
    if (c > 0x7f) return m;
    const int b = static_cast<int>(c);
    if (std::isspace(b)) m |= ctype_base::space;
    if (std::isprint(b)) m |= ctype_base::print;
    if (std::iscntrl(b)) m |= ctype_base::cntrl;
    if (std::isupper(b)) m |= ctype_base::upper;
    if (std::islower(b)) m |= ctype_base::lower;
    if (std::isalpha(b)) m |= ctype_base::alpha;
    if (std::isdigit(b)) m |= ctype_base::digit;
    if (std::ispunct(b)) m |= ctype_base::punct;
    if (std::isxdigit(b)) m |= ctype_base::xdigit;
    if (b == ' ' || b == '\t') m |= ctype_base::blank;
    return m;
}

template <class charT> class ctype : public locale::facet, public ctype_base {
public:
    typedef charT char_type;
    static const int __cxx1_category = locale::ctype;
    explicit ctype(size_t refs = 0) : locale::facet(refs) {}

    bool is(mask m, charT c) const { return do_is(m, c); }
    const charT *is(const charT *low, const charT *high, mask *vec) const { return do_is(low, high, vec); }
    const charT *scan_is(mask m, const charT *low, const charT *high) const { return do_scan_is(m, low, high); }
    const charT *scan_not(mask m, const charT *low, const charT *high) const { return do_scan_not(m, low, high); }
    charT toupper(charT c) const { return do_toupper(c); }
    const charT *toupper(charT *low, const charT *high) const { return do_toupper(low, high); }
    charT tolower(charT c) const { return do_tolower(c); }
    const charT *tolower(charT *low, const charT *high) const { return do_tolower(low, high); }
    charT widen(char c) const { return do_widen(c); }
    const char *widen(const char *low, const char *high, charT *to) const { return do_widen(low, high, to); }
    char narrow(charT c, char dfault) const { return do_narrow(c, dfault); }
    const charT *narrow(const charT *low, const charT *high, char dfault, char *to) const {
        return do_narrow(low, high, dfault, to);
    }
    static locale::id id;

protected:
    ~ctype() {}
    virtual bool do_is(mask m, charT c) const { return (__cxx1_classify(static_cast<unsigned long>(c)) & m) != 0; }
    virtual const charT *do_is(const charT *low, const charT *high, mask *vec) const {
        for (; low != high; ++low, ++vec) *vec = __cxx1_classify(static_cast<unsigned long>(*low));
        return high;
    }
    virtual const charT *do_scan_is(mask m, const charT *low, const charT *high) const {
        while (low != high && !do_is(m, *low)) ++low;
        return low;
    }
    virtual const charT *do_scan_not(mask m, const charT *low, const charT *high) const {
        while (low != high && do_is(m, *low)) ++low;
        return low;
    }
    virtual charT do_toupper(charT c) const { return c >= charT('a') && c <= charT('z') ? charT(c - 'a' + 'A') : c; }
    virtual const charT *do_toupper(charT *low, const charT *high) const {
        for (; low != high; ++low) *low = do_toupper(*low);
        return high;
    }
    virtual charT do_tolower(charT c) const { return c >= charT('A') && c <= charT('Z') ? charT(c - 'A' + 'a') : c; }
    virtual const charT *do_tolower(charT *low, const charT *high) const {
        for (; low != high; ++low) *low = do_tolower(*low);
        return high;
    }
    virtual charT do_widen(char c) const { return charT(static_cast<unsigned char>(c)); }
    virtual const char *do_widen(const char *low, const char *high, charT *dest) const {
        for (; low != high; ++low, ++dest) *dest = do_widen(*low);
        return high;
    }
    virtual char do_narrow(charT c, char dfault) const {
        return static_cast<unsigned long>(c) < 0x80 ? static_cast<char>(c) : dfault;
    }
    virtual const charT *do_narrow(const charT *low, const charT *high, char dfault, char *dest) const {
        for (; low != high; ++low, ++dest) *dest = do_narrow(*low, dfault);
        return high;
    }
};
template <class charT> locale::id ctype<charT>::id;
template <> struct __cxx1_standard_facet<ctype<wchar_t> > {
    static const bool is = true;
    static ctype<wchar_t> *make() { return new ctype<wchar_t>(1); }
};

// [facet.ctype.special]: char's, by a table of 256 masks - the "C" locale's unless the program gives one.
template <> class ctype<char> : public locale::facet, public ctype_base, public __cxx1_facet_id<ctype<char> > {
public:
    typedef char char_type;
    static const int __cxx1_category = locale::ctype;
    static const size_t table_size = 256;

    explicit ctype(const mask *tab = 0, bool del = false, size_t refs = 0)
        : locale::facet(refs), tab_(tab != 0 ? tab : classic_table()), del_(tab != 0 && del) {}

    bool is(mask m, char c) const { return (tab_[static_cast<unsigned char>(c)] & m) != 0; }
    const char *is(const char *low, const char *high, mask *vec) const {
        for (; low != high; ++low, ++vec) *vec = tab_[static_cast<unsigned char>(*low)];
        return high;
    }
    const char *scan_is(mask m, const char *low, const char *high) const {
        while (low != high && !is(m, *low)) ++low;
        return low;
    }
    const char *scan_not(mask m, const char *low, const char *high) const {
        while (low != high && is(m, *low)) ++low;
        return low;
    }
    char toupper(char c) const { return do_toupper(c); }
    const char *toupper(char *low, const char *high) const { return do_toupper(low, high); }
    char tolower(char c) const { return do_tolower(c); }
    const char *tolower(char *low, const char *high) const { return do_tolower(low, high); }
    char widen(char c) const { return do_widen(c); }
    const char *widen(const char *low, const char *high, char *to) const { return do_widen(low, high, to); }
    char narrow(char c, char dfault) const { return do_narrow(c, dfault); }
    const char *narrow(const char *low, const char *high, char dfault, char *to) const {
        return do_narrow(low, high, dfault, to);
    }
    const mask *table() const noexcept { return tab_; }
    static const mask *classic_table() noexcept {
        static mask t[table_size];
        static bool made = false;
        if (!made) {
            for (size_t i = 0; i < table_size; i++) t[i] = __cxx1_classify(i);
            made = true;
        }
        return t;
    }

protected:
    ~ctype() {
        if (del_) delete[] tab_;
    }
    virtual char do_toupper(char c) const { return c >= 'a' && c <= 'z' ? static_cast<char>(c - 'a' + 'A') : c; }
    virtual const char *do_toupper(char *low, const char *high) const {
        for (; low != high; ++low) *low = do_toupper(*low);
        return high;
    }
    virtual char do_tolower(char c) const { return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : c; }
    virtual const char *do_tolower(char *low, const char *high) const {
        for (; low != high; ++low) *low = do_tolower(*low);
        return high;
    }
    virtual char do_widen(char c) const { return c; }
    virtual const char *do_widen(const char *low, const char *high, char *to) const {
        std::memcpy(to, low, static_cast<size_t>(high - low));
        return high;
    }
    virtual char do_narrow(char c, char) const { return c; }
    virtual const char *do_narrow(const char *low, const char *high, char, char *to) const {
        std::memcpy(to, low, static_cast<size_t>(high - low));
        return high;
    }

private:
    const mask *tab_;
    bool del_;
};
template <> struct __cxx1_standard_facet<ctype<char> > {
    static const bool is = true;
    static ctype<char> *make() { return new ctype<char>(0, false, 1); }
};

