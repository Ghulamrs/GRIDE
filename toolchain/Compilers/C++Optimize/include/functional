// [negators]
template <class P> class unary_negate {
    P p_;
public:
    typedef typename P::argument_type argument_type;
    typedef bool result_type;
    explicit unary_negate(const P &p) : p_(p) {}
    bool operator()(const typename P::argument_type &x) const { return !p_(x); }
};
template <class P> class binary_negate {
    P p_;
public:
    typedef typename P::first_argument_type first_argument_type;
    typedef typename P::second_argument_type second_argument_type;
    typedef bool result_type;
    explicit binary_negate(const P &p) : p_(p) {}
    bool operator()(const typename P::first_argument_type &x, const typename P::second_argument_type &y) const {
        return !p_(x, y);
    }
};
template <class P> inline unary_negate<P> not1(const P &p) { return unary_negate<P>(p); }
template <class P> inline binary_negate<P> not2(const P &p) { return binary_negate<P>(p); }

// [depr.lib.binders]
template <class Op> class binder1st {
protected:
    Op op;
    typename Op::first_argument_type value;
public:
    typedef typename Op::second_argument_type argument_type;
    typedef typename Op::result_type result_type;
    binder1st(const Op &x, const typename Op::first_argument_type &y) : op(x), value(y) {}
    typename Op::result_type operator()(const typename Op::second_argument_type &x) const { return op(value, x); }
};
template <class Op> class binder2nd {
protected:
    Op op;
    typename Op::second_argument_type value;
public:
    typedef typename Op::first_argument_type argument_type;
    typedef typename Op::result_type result_type;
    binder2nd(const Op &x, const typename Op::second_argument_type &y) : op(x), value(y) {}
    typename Op::result_type operator()(const typename Op::first_argument_type &x) const { return op(x, value); }
};
template <class Op, class T> inline binder1st<Op> bind1st(const Op &op, const T &x) {
    return binder1st<Op>(op, typename Op::first_argument_type(x));
}
template <class Op, class T> inline binder2nd<Op> bind2nd(const Op &op, const T &x) {
    return binder2nd<Op>(op, typename Op::second_argument_type(x));
}

// [depr.function.pointer.adaptors] and [depr.member.pointer.adaptors]
template <class Arg, class Result> class pointer_to_unary_function : public unary_function<Arg, Result> {
    Result (*f_)(Arg);
public:
    explicit pointer_to_unary_function(Result (*f)(Arg)) : f_(f) {}
    Result operator()(Arg x) const { return f_(x); }
};
template <class Arg1, class Arg2, class Result>
class pointer_to_binary_function : public binary_function<Arg1, Arg2, Result> {
    Result (*f_)(Arg1, Arg2);
public:
    explicit pointer_to_binary_function(Result (*f)(Arg1, Arg2)) : f_(f) {}
    Result operator()(Arg1 x, Arg2 y) const { return f_(x, y); }
};
template <class Arg, class Result> inline pointer_to_unary_function<Arg, Result> ptr_fun(Result (*f)(Arg)) {
    return pointer_to_unary_function<Arg, Result>(f);
}
template <class Arg1, class Arg2, class Result>
inline pointer_to_binary_function<Arg1, Arg2, Result> ptr_fun(Result (*f)(Arg1, Arg2)) {
    return pointer_to_binary_function<Arg1, Arg2, Result>(f);
}
template <class S, class T> class mem_fun_t : public unary_function<T *, S> {
    S (T::*p_)();
public:
    explicit mem_fun_t(S (T::*p)()) : p_(p) {}
    S operator()(T *t) const { return (t->*p_)(); }
};
template <class S, class T> class const_mem_fun_t : public unary_function<const T *, S> {
    S (T::*p_)() const;
public:
    explicit const_mem_fun_t(S (T::*p)() const) : p_(p) {}
    S operator()(const T *t) const { return (t->*p_)(); }
};
template <class S, class T> class mem_fun_ref_t : public unary_function<T, S> {
    S (T::*p_)();
public:
    explicit mem_fun_ref_t(S (T::*p)()) : p_(p) {}
    S operator()(T &t) const { return (t.*p_)(); }
};
template <class S, class T> class const_mem_fun_ref_t : public unary_function<T, S> {
    S (T::*p_)() const;
public:
    explicit const_mem_fun_ref_t(S (T::*p)() const) : p_(p) {}
    S operator()(const T &t) const { return (t.*p_)(); }
};
template <class S, class T> inline mem_fun_t<S, T> mem_fun(S (T::*p)()) { return mem_fun_t<S, T>(p); }
template <class S, class T> inline const_mem_fun_t<S, T> mem_fun(S (T::*p)() const) { return const_mem_fun_t<S, T>(p); }
template <class S, class T> inline mem_fun_ref_t<S, T> mem_fun_ref(S (T::*p)()) { return mem_fun_ref_t<S, T>(p); }
template <class S, class T> inline const_mem_fun_ref_t<S, T> mem_fun_ref(S (T::*p)() const) {
    return const_mem_fun_ref_t<S, T>(p);
}

// [func.memfn]: a pointer to member as a function object, called through INVOKE.
template <class M> class __cxx1_mem_fn {
    M pm_;
public:
    explicit __cxx1_mem_fn(M pm) : pm_(pm) {}
    template <class... A> typename __cxx1_invoke_result<const M &, A...>::type operator()(A &&... a) const {
        return std::__cxx1_invoke(pm_, std::forward<A>(a)...);
    }
};
template <class R, class T> inline __cxx1_mem_fn<R T::*> mem_fn(R T::*pm) { return __cxx1_mem_fn<R T::*>(pm); }
template <class R, class T, class... P> inline __cxx1_mem_fn<R (T::*)(P...)> mem_fn(R (T::*pm)(P...)) {
    return __cxx1_mem_fn<R (T::*)(P...)>(pm);
}
template <class R, class T, class... P> inline __cxx1_mem_fn<R (T::*)(P...) const> mem_fn(R (T::*pm)(P...) const) {
    return __cxx1_mem_fn<R (T::*)(P...) const>(pm);
}

// [func.wrap]
class bad_function_call : public exception {
public:
    bad_function_call() noexcept {}
    const char *what() const noexcept { return "bad function call"; }
};

// [func.wrap.func.con]/8: a null pointer to function or to member makes an empty function.
template <class F> inline bool __cxx1_is_null(const F &) { return false; }
template <class T> inline bool __cxx1_is_null(T *p) { return p == nullptr; }
template <class R, class C> inline bool __cxx1_is_null(R C::*p) { return p == nullptr; }

template <class Signature> class function;
template <class R, class... Args> class function<R(Args...)> {
    struct __base {
        virtual ~__base() {}
        virtual R __call(Args &&... a) = 0;
        virtual __base *__clone() const = 0;
        virtual const type_info &__type() const = 0;
        virtual void *__target() = 0;
    };
    template <class F> struct __holder : __base {
        F f;
        explicit __holder(const F &g) : f(g) {}
        R __call(Args &&... a) { return static_cast<R>(std::__cxx1_invoke(f, std::forward<Args>(a)...)); }
        __base *__clone() const { return new __holder(f); }
        const type_info &__type() const { return typeid(F); }
        void *__target() { return &f; }
    };
    __base *p_;

public:
    typedef R result_type;

    function() noexcept : p_(nullptr) {}
    function(nullptr_t) noexcept : p_(nullptr) {}
    function(const function &o) : p_(o.p_ != nullptr ? o.p_->__clone() : nullptr) {}
    function(function &&o) noexcept : p_(o.p_) { o.p_ = nullptr; }
    template <class F> function(F f) : p_(std::__cxx1_is_null(f) ? nullptr : new __holder<F>(f)) {}
    ~function() { delete p_; }

    function &operator=(const function &o) {
        function(o).swap(*this);
        return *this;
    }
    function &operator=(function &&o) {
        function(std::move(o)).swap(*this);
        return *this;
    }
    function &operator=(nullptr_t) {
        delete p_;
        p_ = nullptr;
        return *this;
    }
    template <class F> function &operator=(F f) {
        function(f).swap(*this);
        return *this;
    }
    template <class F> function &operator=(reference_wrapper<F> f) noexcept {
        function(f).swap(*this);
        return *this;
    }

    void swap(function &o) noexcept {
        __base *t = p_;
        p_ = o.p_;
        o.p_ = t;
    }
    explicit operator bool() const noexcept { return p_ != nullptr; }

    R operator()(Args... a) const {
        if (p_ == nullptr) throw bad_function_call();
        return p_->__call(std::forward<Args>(a)...);
    }

    const type_info &target_type() const noexcept { return p_ != nullptr ? p_->__type() : typeid(void); }
    template <class T> T *target() noexcept {
        return p_ != nullptr && p_->__type() == typeid(T) ? static_cast<T *>(p_->__target()) : nullptr;
    }
    template <class T> const T *target() const noexcept {
        return p_ != nullptr && p_->__type() == typeid(T) ? static_cast<const T *>(p_->__target()) : nullptr;
    }
};

template <class R, class... A> inline bool operator==(const function<R(A...)> &f, nullptr_t) noexcept { return !f; }
template <class R, class... A> inline bool operator==(nullptr_t, const function<R(A...)> &f) noexcept { return !f; }
template <class R, class... A> inline bool operator!=(const function<R(A...)> &f, nullptr_t) noexcept {
    return static_cast<bool>(f);
}
template <class R, class... A> inline bool operator!=(nullptr_t, const function<R(A...)> &f) noexcept {
    return static_cast<bool>(f);
}
template <class R, class... A> inline void swap(function<R(A...)> &x, function<R(A...)> &y) { x.swap(y); }

