template <int N> struct __cxx1_placeholder {};
namespace placeholders {
const __cxx1_placeholder<1> _1 = __cxx1_placeholder<1>();
const __cxx1_placeholder<2> _2 = __cxx1_placeholder<2>();
const __cxx1_placeholder<3> _3 = __cxx1_placeholder<3>();
const __cxx1_placeholder<4> _4 = __cxx1_placeholder<4>();
const __cxx1_placeholder<5> _5 = __cxx1_placeholder<5>();
const __cxx1_placeholder<6> _6 = __cxx1_placeholder<6>();
const __cxx1_placeholder<7> _7 = __cxx1_placeholder<7>();
const __cxx1_placeholder<8> _8 = __cxx1_placeholder<8>();
const __cxx1_placeholder<9> _9 = __cxx1_placeholder<9>();
const __cxx1_placeholder<10> _10 = __cxx1_placeholder<10>();
}  // namespace placeholders

template <class T> struct is_placeholder : integral_constant<int, 0> {};
template <int N> struct is_placeholder<__cxx1_placeholder<N> > : integral_constant<int, N> {};
template <class T> struct is_placeholder<const T> : integral_constant<int, is_placeholder<T>::value> {};
template <class T> struct is_bind_expression : false_type {};
template <class T> struct is_bind_expression<const T> : integral_constant<bool, is_bind_expression<T>::value> {};

// [func.bind.bind]/10: each bound argument as the call sees it - a reference_wrapper's referent, the
// call's own argument for a placeholder, a nested bind expression's result, the stored value otherwise.
template <class B, class U, int P = is_placeholder<B>::value, bool E = is_bind_expression<B>::value>
struct __cxx1_bound;
template <class B, class U> struct __cxx1_bound<B, U, 0, false> {
    typedef B &type;
    static B &get(B &b, U &) { return b; }
};
template <class T, class U> struct __cxx1_bound<reference_wrapper<T>, U, 0, false> {
    typedef T &type;
    static T &get(reference_wrapper<T> &b, U &) { return b.get(); }
};
template <class B, class U, int P> struct __cxx1_bound<B, U, P, false> {
    typedef typename tuple_element<P - 1, U>::type type;
    static type get(B &, U &u) { return std::forward<type>(std::get<P - 1>(u)); }
};
template <class B, class U> struct __cxx1_bound<B, U, 0, true> {
    typedef typename B::template __cxx1_result<U>::type type;
    static type get(B &b, U &u) { return b.__cxx1_call(u); }
};

template <class F, class BT, class U, class I> struct __cxx1_bind_result;
template <class F, class... B, class U, std::size_t... I>
struct __cxx1_bind_result<F, tuple<B...>, U, __cxx1_indices<I...> > {
    typedef typename __cxx1_invoke_result<F &, typename __cxx1_bound<B, U>::type...>::type type;
};

struct __cxx1_bind_tag {};
template <class F, class... B> class __cxx1_binder {
    typedef typename __cxx1_make_indices<sizeof...(B)>::type __cxx1_idx;
    F f_;
    tuple<B...> b_;
    template <class U, std::size_t... I>
    typename __cxx1_bind_result<F, tuple<B...>, U, __cxx1_indices<I...> >::type __cxx1_apply(U &u, __cxx1_indices<I...>) {
        return std::__cxx1_invoke(f_, __cxx1_bound<B, U>::get(std::get<I>(b_), u)...);
    }

public:
    template <class U> struct __cxx1_result {
        typedef typename __cxx1_bind_result<F, tuple<B...>, U, __cxx1_idx>::type type;
    };
    // Behind a tag, so that copying or moving a binder never deduces this - a forwarding G would outrank
    // the copy constructor for a non-const one.
    template <class G, class... A>
    __cxx1_binder(__cxx1_bind_tag, G &&g, A &&... a) : f_(std::forward<G>(g)), b_(std::forward<A>(a)...) {}
    template <class U> typename __cxx1_result<U>::type __cxx1_call(U &u) { return __cxx1_apply(u, __cxx1_idx()); }
    template <class... A> typename __cxx1_result<tuple<A &&...> >::type operator()(A &&... a) {
        tuple<A &&...> u(std::forward<A>(a)...);
        return __cxx1_apply(u, __cxx1_idx());
    }
    template <class... A> typename __cxx1_result<tuple<A &&...> >::type operator()(A &&... a) const {
        tuple<A &&...> u(std::forward<A>(a)...);
        return const_cast<__cxx1_binder *>(this)->__cxx1_apply(u, __cxx1_idx());
    }
};
// bind<R>: the same call, its result converted to R.
template <class R, class F, class... B> class __cxx1_binder_r : public __cxx1_binder<F, B...> {
public:
    typedef R result_type;
    template <class G, class... A>
    __cxx1_binder_r(__cxx1_bind_tag t, G &&g, A &&... a)
        : __cxx1_binder<F, B...>(t, std::forward<G>(g), std::forward<A>(a)...) {}
    template <class... A> R operator()(A &&... a) {
        return static_cast<R>(static_cast<__cxx1_binder<F, B...> &>(*this)(std::forward<A>(a)...));
    }
    template <class... A> R operator()(A &&... a) const {
        return static_cast<R>(static_cast<const __cxx1_binder<F, B...> &>(*this)(std::forward<A>(a)...));
    }
};
template <class F, class... B> struct is_bind_expression<__cxx1_binder<F, B...> > : true_type {};
template <class R, class F, class... B> struct is_bind_expression<__cxx1_binder_r<R, F, B...> > : true_type {};

template <class F, class... B>
inline __cxx1_binder<typename decay<F>::type, typename decay<B>::type...> bind(F &&f, B &&... b) {
    return __cxx1_binder<typename decay<F>::type, typename decay<B>::type...>(__cxx1_bind_tag(), std::forward<F>(f),
                                                                              std::forward<B>(b)...);
}
template <class R, class F, class... B>
inline __cxx1_binder_r<R, typename decay<F>::type, typename decay<B>::type...> bind(F &&f, B &&... b) {
    return __cxx1_binder_r<R, typename decay<F>::type, typename decay<B>::type...>(__cxx1_bind_tag(), std::forward<F>(f),
                                                                                  std::forward<B>(b)...);
}

// [unord.hash]: FNV-1a over the object's bytes, the 64-bit form where size_t is 64 bits.
inline std::size_t __cxx1_fnv(const void *p, std::size_t n) {
    const unsigned char *b = static_cast<const unsigned char *>(p);
#if defined(__TMS320C6X__)
    std::size_t h = 2166136261u;
    for (std::size_t i = 0; i < n; i++) { h ^= b[i]; h *= 16777619u; }
#else
    unsigned long long h = 14695981039346656037ULL;
    for (std::size_t i = 0; i < n; i++) { h ^= b[i]; h *= 1099511628211ULL; }
#endif
    return (std::size_t)h;
}
template <class T> struct hash;
template <class T> struct __cxx1_scalar_hash {
    typedef T argument_type;
    typedef std::size_t result_type;
    std::size_t operator()(T v) const noexcept { return std::__cxx1_fnv(&v, sizeof v); }
};
template <class T> struct __cxx1_float_hash {
    typedef T argument_type;
    typedef std::size_t result_type;
    std::size_t operator()(T v) const noexcept {
        if (v == 0) v = 0;   // +0 and -0 compare equal, so they hash alike
        return std::__cxx1_fnv(&v, sizeof v);
    }
};
template <> struct hash<bool> : __cxx1_scalar_hash<bool> {};
template <> struct hash<char> : __cxx1_scalar_hash<char> {};
template <> struct hash<signed char> : __cxx1_scalar_hash<signed char> {};
template <> struct hash<unsigned char> : __cxx1_scalar_hash<unsigned char> {};
template <> struct hash<char16_t> : __cxx1_scalar_hash<char16_t> {};
template <> struct hash<char32_t> : __cxx1_scalar_hash<char32_t> {};
template <> struct hash<wchar_t> : __cxx1_scalar_hash<wchar_t> {};
template <> struct hash<short> : __cxx1_scalar_hash<short> {};
template <> struct hash<unsigned short> : __cxx1_scalar_hash<unsigned short> {};
template <> struct hash<int> : __cxx1_scalar_hash<int> {};
template <> struct hash<unsigned int> : __cxx1_scalar_hash<unsigned int> {};
template <> struct hash<long> : __cxx1_scalar_hash<long> {};
template <> struct hash<unsigned long> : __cxx1_scalar_hash<unsigned long> {};
template <> struct hash<long long> : __cxx1_scalar_hash<long long> {};
template <> struct hash<unsigned long long> : __cxx1_scalar_hash<unsigned long long> {};
template <> struct hash<float> : __cxx1_float_hash<float> {};
template <> struct hash<double> : __cxx1_float_hash<double> {};
