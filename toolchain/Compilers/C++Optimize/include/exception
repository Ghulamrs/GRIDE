#else
class bad_exception : public exception {
public:
    bad_exception() {}
    virtual ~bad_exception();
    virtual const char *what() const;
};
#endif

// [propagation]: exception_ptr is the platform library's, as the exception itself is - on Windows
// over libcpmt's functions in cl's layout, on Linux libstdc++'s __exception_ptr::exception_ptr and
// on the Mac libc++'s, each declared with the members those libraries export. The C6000's runtime
// has none: there a program naming one compiles and does not link.
//
// The comparisons every form has, beside its class so that they are found from its namespace.
#define _CXX1_EXCEPTION_PTR_COMPARISONS                                                                  \
inline bool operator!=(const exception_ptr &a, const exception_ptr &b) noexcept { return !(a == b); }   \
inline bool operator==(const exception_ptr &a, decltype(nullptr)) noexcept { return !a; }              \
inline bool operator==(decltype(nullptr), const exception_ptr &a) noexcept { return !a; }              \
inline bool operator!=(const exception_ptr &a, decltype(nullptr)) noexcept { return (bool)a; }         \
inline bool operator!=(decltype(nullptr), const exception_ptr &a) noexcept { return (bool)a; }

#if defined(_WIN32)
class exception_ptr {
public:
    exception_ptr() noexcept { __ExceptionPtrCreate(this); }
    exception_ptr(decltype(nullptr)) noexcept { __ExceptionPtrCreate(this); }
    exception_ptr(const exception_ptr &o) noexcept { __ExceptionPtrCopy(this, &o); }
    ~exception_ptr() noexcept { __ExceptionPtrDestroy(this); }
    exception_ptr &operator=(const exception_ptr &o) noexcept {
        __ExceptionPtrAssign(this, &o);
        return *this;
    }
    exception_ptr &operator=(decltype(nullptr)) noexcept {
        exception_ptr none;
        __ExceptionPtrAssign(this, &none);
        return *this;
    }
    explicit operator bool() const noexcept { return __ExceptionPtrToBool(this); }

private:
    void *data1_;
    void *data2_;
};

inline bool operator==(const exception_ptr &a, const exception_ptr &b) noexcept { return __ExceptionPtrCompare(&a, &b); }
inline void swap(exception_ptr &a, exception_ptr &b) noexcept { __ExceptionPtrSwap(&a, &b); }
_CXX1_EXCEPTION_PTR_COMPARISONS

inline exception_ptr current_exception() noexcept {
    exception_ptr e;
    __ExceptionPtrCurrentException(&e);
    return e;
}

inline void rethrow_exception(exception_ptr p) { __ExceptionPtrRethrow(&p); }
#elif defined(__APPLE__)
class exception_ptr {
public:
    exception_ptr() noexcept : ptr_(0) {}
    exception_ptr(decltype(nullptr)) noexcept : ptr_(0) {}
    exception_ptr(const exception_ptr &) noexcept;
    ~exception_ptr() noexcept;
    exception_ptr &operator=(const exception_ptr &) noexcept;
    exception_ptr &operator=(decltype(nullptr)) noexcept {
        exception_ptr none;
        return *this = none;
    }
    explicit operator bool() const noexcept { return ptr_ != 0; }
    bool __cxx1_same(const exception_ptr &o) const noexcept { return ptr_ == o.ptr_; }

private:
    void *ptr_;
};

inline bool operator==(const exception_ptr &a, const exception_ptr &b) noexcept { return a.__cxx1_same(b); }
inline void swap(exception_ptr &a, exception_ptr &b) noexcept {
    exception_ptr held = a;
    a = b;
    b = held;
}
_CXX1_EXCEPTION_PTR_COMPARISONS

exception_ptr current_exception() noexcept;
void rethrow_exception(exception_ptr);
#else
namespace __exception_ptr {
class exception_ptr {
public:
    exception_ptr() noexcept;
    exception_ptr(decltype(nullptr)) noexcept : object_(0) {}
    exception_ptr(const exception_ptr &) noexcept;
    ~exception_ptr() noexcept;
    exception_ptr &operator=(const exception_ptr &) noexcept;
    exception_ptr &operator=(decltype(nullptr)) noexcept {
        exception_ptr none;
        swap(none);
        return *this;
    }
    void swap(exception_ptr &) noexcept;
    explicit operator bool() const noexcept { return object_ != 0; }

private:
    void *object_;
};

bool operator==(const exception_ptr &, const exception_ptr &) noexcept;
inline void swap(exception_ptr &a, exception_ptr &b) noexcept { a.swap(b); }
_CXX1_EXCEPTION_PTR_COMPARISONS
}  // namespace __exception_ptr

using __exception_ptr::exception_ptr;

exception_ptr current_exception() noexcept;
void rethrow_exception(exception_ptr);
#endif

#undef _CXX1_EXCEPTION_PTR_COMPARISONS

template <class E>
exception_ptr make_exception_ptr(E e) noexcept {
    try {
        throw e;
    } catch (...) {
        return current_exception();
    }
}

// [except.nested]
class nested_exception {
public:
    nested_exception() noexcept : nested_(current_exception()) {}
    nested_exception(const nested_exception &o) noexcept : nested_(o.nested_) {}
    nested_exception &operator=(const nested_exception &o) noexcept {
        nested_ = o.nested_;
        return *this;
    }
    virtual ~nested_exception() noexcept {}

    void rethrow_nested() const {
        if (!nested_) terminate();
        rethrow_exception(nested_);
    }
    exception_ptr nested_ptr() const noexcept { return nested_; }

private:
    exception_ptr nested_;
};

// What throw_with_nested and rethrow_if_nested ask of a type, by overload rather than <type_traits>'
// is_class, is_base_of and is_polymorphic, which wait on the compiler.
template <class T> char __cxx1_exception_class_test(int T::*) { return 0; }
template <class T> long __cxx1_exception_class_test(...) { return 0; }
inline char __cxx1_exception_nested_test(const volatile nested_exception *) { return 0; }
inline long __cxx1_exception_nested_test(...) { return 0; }

template <class T> struct __cxx1_nest {
    typedef typename remove_cv<typename remove_reference<T>::type>::type type;
    static const bool wrap = sizeof(std::__cxx1_exception_class_test<type>(0)) == 1 &&
                             sizeof(std::__cxx1_exception_nested_test((type *)0)) != 1;
};

template <class E, bool = sizeof(std::__cxx1_exception_class_test<E>(0)) == 1>
struct __cxx1_is_polymorphic { static const bool value = false; };
template <class E> struct __cxx1_is_polymorphic<E, true> {
    struct __plain : E { char __c; };
    struct __virtual : E { virtual ~__virtual() {} char __c; };
    static const bool value = sizeof(__plain) == sizeof(__virtual);
};

template <class U>
struct __cxx1_nested_with : U, nested_exception {
    __cxx1_nested_with(const U &u) : U(u) {}
    __cxx1_nested_with(U &&u) : U(static_cast<U &&>(u)) {}
};

template <class T, class U>
void __cxx1_throw_nested(T &&t, U *, integral_constant<bool, true>) {
    throw __cxx1_nested_with<U>(static_cast<T &&>(t));
}
template <class T, class U>
void __cxx1_throw_nested(T &&t, U *, integral_constant<bool, false>) {
    throw static_cast<T &&>(t);
}

template <class T>
void throw_with_nested(T &&t) {
    std::__cxx1_throw_nested(static_cast<T &&>(t), (typename __cxx1_nest<T>::type *)0,
                             integral_constant<bool, __cxx1_nest<T>::wrap>());
}

template <class E>
void __cxx1_rethrow_if_nested(const E &e, integral_constant<bool, true>) {
    const nested_exception *n = dynamic_cast<const nested_exception *>(&e);
    if (n != 0) n->rethrow_nested();
}
template <class E>
void __cxx1_rethrow_if_nested(const E &, integral_constant<bool, false>) {}

template <class E>
void rethrow_if_nested(const E &e) {
    std::__cxx1_rethrow_if_nested(e, integral_constant<bool, __cxx1_is_polymorphic<E>::value>());
}

