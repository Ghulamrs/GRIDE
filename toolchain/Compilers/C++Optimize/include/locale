// [classification], [conversions.character]
template <class charT> bool isspace(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::space, c); }
template <class charT> bool isprint(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::print, c); }
template <class charT> bool iscntrl(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::cntrl, c); }
template <class charT> bool isupper(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::upper, c); }
template <class charT> bool islower(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::lower, c); }
template <class charT> bool isalpha(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::alpha, c); }
template <class charT> bool isdigit(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::digit, c); }
template <class charT> bool ispunct(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::punct, c); }
template <class charT> bool isxdigit(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::xdigit, c); }
template <class charT> bool isalnum(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::alnum, c); }
template <class charT> bool isgraph(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::graph, c); }
template <class charT> bool isblank(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).is(ctype_base::blank, c); }
template <class charT> charT toupper(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).toupper(c); }
template <class charT> charT tolower(charT c, const locale &loc) { return use_facet<ctype<charT> >(loc).tolower(c); }

// [conversions.string]: a wide string and its bytes, through a codecvt facet the converter owns. A sequence that
// does not convert is the error string given at construction, or range_error where none was.
template <class Codecvt, class Elem = wchar_t, class Wide_alloc = allocator<Elem>, class Byte_alloc = allocator<char> >
class wstring_convert {
public:
    typedef basic_string<char, char_traits<char>, Byte_alloc> byte_string;
    typedef basic_string<Elem, char_traits<Elem>, Wide_alloc> wide_string;
    typedef typename Codecvt::state_type state_type;
    typedef typename wide_string::traits_type::int_type int_type;

    explicit wstring_convert(Codecvt *pcvt = new Codecvt) : cvt_(pcvt), state_(), count_(0), hasByteErr_(false), hasWideErr_(false) {}
    wstring_convert(Codecvt *pcvt, state_type state) : cvt_(pcvt), state_(state), count_(0), hasByteErr_(false), hasWideErr_(false) {}
    explicit wstring_convert(const byte_string &byte_err, const wide_string &wide_err = wide_string())
        : cvt_(new Codecvt), state_(), count_(0), byteErr_(byte_err), wideErr_(wide_err), hasByteErr_(true), hasWideErr_(true) {}
    ~wstring_convert() { delete cvt_; }
    wstring_convert(const wstring_convert &) = delete;
    wstring_convert &operator=(const wstring_convert &) = delete;

    wide_string from_bytes(char byte) { return from_bytes(&byte, &byte + 1); }
    wide_string from_bytes(const char *ptr) { return from_bytes(ptr, ptr + char_traits<char>::length(ptr)); }
    wide_string from_bytes(const byte_string &str) { return from_bytes(str.data(), str.data() + str.size()); }
    wide_string from_bytes(const char *first, const char *last) {
        wide_string out;
        state_type st = state_;
        const char *from = first;
        count_ = 0;
        if (cvt_->always_noconv()) {
            for (; from != last; ++from) out += static_cast<Elem>(static_cast<unsigned char>(*from));
            count_ = static_cast<size_t>(last - first);
            return out;
        }
        while (from != last) {
            Elem buf[64];
            const char *next = from;
            Elem *to = buf;
            const codecvt_base::result r = cvt_->in(st, from, last, next, buf, buf + 64, to);
            out.append(buf, static_cast<size_t>(to - buf));
            if (r == codecvt_base::noconv) {
                for (; from != last; ++from) out += static_cast<Elem>(static_cast<unsigned char>(*from));
                break;
            }
            if (r == codecvt_base::error || (next == from && to == buf)) {
                count_ = static_cast<size_t>(next - first);
                if (hasWideErr_) return wideErr_;
                throw range_error("wstring_convert::from_bytes: a sequence does not convert");
            }
            from = next;
        }
        count_ = static_cast<size_t>(from - first);
        return out;
    }

    byte_string to_bytes(Elem wchar) { return to_bytes(&wchar, &wchar + 1); }
    byte_string to_bytes(const Elem *wptr) { return to_bytes(wptr, wptr + char_traits<Elem>::length(wptr)); }
    byte_string to_bytes(const wide_string &wstr) { return to_bytes(wstr.data(), wstr.data() + wstr.size()); }
    byte_string to_bytes(const Elem *first, const Elem *last) {
        byte_string out;
        state_type st = state_;
        const Elem *from = first;
        count_ = 0;
        if (cvt_->always_noconv()) {
            for (; from != last; ++from) out += static_cast<char>(*from);
            count_ = static_cast<size_t>(last - first);
            return out;
        }
        while (from != last) {
            char buf[256];
            const Elem *next = from;
            char *to = buf;
            const codecvt_base::result r = cvt_->out(st, from, last, next, buf, buf + 256, to);
            out.append(buf, static_cast<size_t>(to - buf));
            if (r == codecvt_base::noconv) {
                for (; from != last; ++from) out += static_cast<char>(*from);
                break;
            }
            if (r == codecvt_base::error || (next == from && to == buf)) {
                count_ = static_cast<size_t>(next - first);
                if (hasByteErr_) return byteErr_;
                throw range_error("wstring_convert::to_bytes: a character does not convert");
            }
            from = next;
        }
        char tail[16];
        char *t = tail;
        if (cvt_->unshift(st, tail, tail + 16, t) == codecvt_base::ok) out.append(tail, static_cast<size_t>(t - tail));
        count_ = static_cast<size_t>(from - first);
        return out;
    }

    size_t converted() const noexcept { return count_; }
    state_type state() const { return state_; }

private:
    Codecvt *cvt_;
    state_type state_;
    size_t count_;
    byte_string byteErr_;
    wide_string wideErr_;
    bool hasByteErr_, hasWideErr_;
};

// [conversions.buffer]: a stream buffer of Elem over a buffer of bytes, converting each character as it passes.
template <class Codecvt, class Elem = wchar_t, class Tr = char_traits<Elem> >
class wbuffer_convert : public basic_streambuf<Elem, Tr> {
public:
    typedef typename Codecvt::state_type state_type;
    typedef typename Tr::int_type int_type;

    explicit wbuffer_convert(streambuf *bytebuf = 0, Codecvt *pcvt = new Codecvt, state_type state = state_type())
        : bytes_(bytebuf), cvt_(pcvt), state_(state), held_(false), heldChar_() {}
    ~wbuffer_convert() {
        sync();
        delete cvt_;
    }
    wbuffer_convert(const wbuffer_convert &) = delete;
    wbuffer_convert &operator=(const wbuffer_convert &) = delete;
    streambuf *rdbuf() const { return bytes_; }
    streambuf *rdbuf(streambuf *bytebuf) {
        streambuf *was = bytes_;
        bytes_ = bytebuf;
        return was;
    }
    state_type state() const { return state_; }

protected:
    virtual int_type overflow(int_type c = Tr::eof()) {
        if (Tr::eq_int_type(c, Tr::eof())) return Tr::not_eof(c);
        if (bytes_ == 0) return Tr::eof();
        const Elem e = Tr::to_char_type(c);
        const Elem *next = &e;
        char buf[16];
        char *to = buf;
        const codecvt_base::result r = cvt_->out(state_, &e, &e + 1, next, buf, buf + 16, to);
        if (r == codecvt_base::noconv) {
            buf[0] = static_cast<char>(e);
            to = buf + 1;
        } else if (r != codecvt_base::ok) {
            return Tr::eof();
        }
        const streamsize n = to - buf;
        return bytes_->sputn(buf, n) == n ? c : Tr::eof();
    }
    virtual int_type underflow() {
        if (held_) return Tr::to_int_type(heldChar_);
        if (!take()) return Tr::eof();
        return Tr::to_int_type(heldChar_);
    }
    virtual int_type uflow() {
        if (!held_ && !take()) return Tr::eof();
        held_ = false;
        return Tr::to_int_type(heldChar_);
    }
    virtual int sync() { return bytes_ != 0 ? bytes_->pubsync() : 0; }

private:
    // One character read: bytes taken until they convert to one.
    bool take() {
        if (bytes_ == 0) return false;
        char buf[16];
        size_t n = 0;
        while (n < sizeof buf) {
            const int b = bytes_->sbumpc();
            if (b == EOF) return false;
            buf[n++] = static_cast<char>(b);
            state_type st = state_;
            const char *next = buf;
            Elem out = Elem();
            Elem *to = &out;
            const codecvt_base::result r = cvt_->in(st, buf, buf + n, next, &out, &out + 1, to);
            if (r == codecvt_base::noconv) {
                heldChar_ = static_cast<Elem>(static_cast<unsigned char>(buf[0]));
                held_ = true;
                return true;
            }
            if (r == codecvt_base::error) return false;
            if (to != &out) {
                state_ = st;
                heldChar_ = out;
                held_ = true;
                return true;
            }
        }
        return false;
    }

    streambuf *bytes_;
    Codecvt *cvt_;
    state_type state_;
    bool held_;
    Elem heldChar_;
};

// [locale.monetary]
class money_base {
public:
    enum part { none, space, symbol, sign, value };
    struct pattern { char field[4]; };
};

template <class charT, bool International = false> class moneypunct : public locale::facet, public money_base {
public:
    typedef charT char_type;
    typedef basic_string<charT> string_type;
    static const int __cxx1_category = locale::monetary;
    static const bool intl = International;
    explicit moneypunct(size_t refs = 0) : locale::facet(refs) {}
    charT decimal_point() const { return do_decimal_point(); }
    charT thousands_sep() const { return do_thousands_sep(); }
    string grouping() const { return do_grouping(); }
    string_type curr_symbol() const { return do_curr_symbol(); }
    string_type positive_sign() const { return do_positive_sign(); }
    string_type negative_sign() const { return do_negative_sign(); }
    int frac_digits() const { return do_frac_digits(); }
    pattern pos_format() const { return do_pos_format(); }
    pattern neg_format() const { return do_neg_format(); }
    static locale::id id;

protected:
    ~moneypunct() {}
    virtual charT do_decimal_point() const { return charT('.'); }
    virtual charT do_thousands_sep() const { return charT(','); }
    virtual string do_grouping() const { return string(); }
    virtual string_type do_curr_symbol() const { return string_type(); }
    virtual string_type do_positive_sign() const { return string_type(); }
    virtual string_type do_negative_sign() const { return string_type(1, charT('-')); }
    virtual int do_frac_digits() const { return 0; }
    // [locale.moneypunct.virtuals]/6: the required instantiations' { symbol, sign, none, value }.
    virtual pattern do_pos_format() const {
        pattern p = { { symbol, sign, none, value } };
        return p;
    }
    virtual pattern do_neg_format() const {
        pattern p = { { symbol, sign, none, value } };
        return p;
    }
};
template <class charT, bool International> locale::id moneypunct<charT, International>::id;
template <class charT, bool International> const bool moneypunct<charT, International>::intl;
template <class charT, bool International> struct __cxx1_standard_facet<moneypunct<charT, International> > {
    static const bool is = true;
    static moneypunct<charT, International> *make() { return new moneypunct<charT, International>(1); }
};
template <class charT, bool Intl = false> class moneypunct_byname : public moneypunct<charT, Intl> {
public:
    explicit moneypunct_byname(const char *name, size_t refs = 0) : moneypunct<charT, Intl>(refs) { locale l(name); (void)l; }
    explicit moneypunct_byname(const string &name, size_t refs = 0) : moneypunct<charT, Intl>(refs) { locale l(name); (void)l; }

protected:
    ~moneypunct_byname() {}
};

template <class charT, class OutputIterator = ostreambuf_iterator<charT> > class money_put : public locale::facet {
public:
    typedef charT char_type;
    typedef OutputIterator iter_type;
    typedef basic_string<charT> string_type;
    static const int __cxx1_category = locale::monetary;
    explicit money_put(size_t refs = 0) : locale::facet(refs) {}
    iter_type put(iter_type s, bool intl, ios_base &f, char_type fill, long double units) const { return do_put(s, intl, f, fill, units); }
    iter_type put(iter_type s, bool intl, ios_base &f, char_type fill, const string_type &digits) const {
        return do_put(s, intl, f, fill, digits);
    }
    static locale::id id;

protected:
    ~money_put() {}
    virtual iter_type do_put(iter_type s, bool intl, ios_base &str, char_type fill, long double units) const {
        char buf[512];
        const int n = std::snprintf(buf, sizeof buf, "%.0Lf", units);
        const ctype<charT> &ct = use_facet<ctype<charT> >(str.getloc());
        string_type digits;
        for (int i = 0; i < n && i < static_cast<int>(sizeof buf); i++) digits += ct.widen(buf[i]);
        return do_put(s, intl, str, fill, digits);
    }
    // [locale.money.put.virtuals]: the digits with the point placed frac_digits from the right, grouped, laid out
    // by the sign's pattern, and padded where `none` is with `internal`, else before or after.
    virtual iter_type do_put(iter_type s, bool intl, ios_base &str, char_type fill, const string_type &digits) const {
        const locale loc = str.getloc();
        const ctype<charT> &ct = use_facet<ctype<charT> >(loc);
        bool negative = !digits.empty() && digits[0] == ct.widen('-');
        string_type d;
        for (size_t i = negative ? 1 : 0; i < digits.size() && ct.is(ctype_base::digit, digits[i]); i++) d += digits[i];
        string_type sym, signText, valueText;
        money_base::pattern pat;
        int frac;
        charT point, sep;
        string grouping;
        if (intl) {
            const moneypunct<charT, true> &mp = use_facet<moneypunct<charT, true> >(loc);
            sym = mp.curr_symbol(); signText = negative ? mp.negative_sign() : mp.positive_sign();
            pat = negative ? mp.neg_format() : mp.pos_format(); frac = mp.frac_digits(); point = mp.decimal_point();
            sep = mp.thousands_sep(); grouping = mp.grouping();
        } else {
            const moneypunct<charT, false> &mp = use_facet<moneypunct<charT, false> >(loc);
            sym = mp.curr_symbol(); signText = negative ? mp.negative_sign() : mp.positive_sign();
            pat = negative ? mp.neg_format() : mp.pos_format(); frac = mp.frac_digits(); point = mp.decimal_point();
            sep = mp.thousands_sep(); grouping = mp.grouping();
        }
        if (frac < 0) frac = 0;
        while (static_cast<int>(d.size()) <= frac) d.insert(d.begin(), ct.widen('0'));
        string_type whole = d.substr(0, d.size() - static_cast<size_t>(frac)), part = d.substr(d.size() - static_cast<size_t>(frac));
        if (!grouping.empty() && grouping[0] > 0 && grouping[0] != CHAR_MAX) {
            string_type grouped;
            size_t g = 0, run = static_cast<unsigned char>(grouping[0]), counted = 0;
            for (size_t i = whole.size(); i-- > 0;) {
                if (counted == run) {
                    grouped.insert(grouped.begin(), sep);
                    counted = 0;
                    if (g + 1 < grouping.size() && grouping[g + 1] > 0 && grouping[g + 1] != CHAR_MAX) run = static_cast<unsigned char>(grouping[++g]);
                }
                grouped.insert(grouped.begin(), whole[i]);
                counted++;
            }
            whole = grouped;
        }
        valueText = whole;
        if (frac > 0) { valueText += point; valueText += part; }
        string_type out;
        size_t padAt = string_type::npos;
        for (int k = 0; k < 4; k++) {
            switch (pat.field[k]) {
            case money_base::symbol:
                if ((str.flags() & ios_base::showbase) != 0) out += sym;
                break;
            case money_base::sign:
                if (!signText.empty()) out += signText[0];
                break;
            case money_base::value: out += valueText; break;
            case money_base::space: out += ct.widen(' '); padAt = out.size(); break;
            case money_base::none: padAt = out.size(); break;
            }
        }
        if (signText.size() > 1) out += signText.substr(1);
        const size_t width = str.width() > 0 ? static_cast<size_t>(str.width()) : 0;
        if (width > out.size()) {
            const size_t pad = width - out.size();
            const ios_base::fmtflags adjust = str.flags() & ios_base::adjustfield;
            const size_t at = adjust == ios_base::internal && padAt != string_type::npos ? padAt
                            : adjust == ios_base::left ? out.size() : 0;
            out.insert(at, pad, fill);
        }
        str.width(0);
        for (size_t i = 0; i < out.size(); i++, ++s) *s = out[i];
        return s;
    }
};
template <class charT, class OutputIterator> locale::id money_put<charT, OutputIterator>::id;
template <class charT, class OutputIterator> struct __cxx1_standard_facet<money_put<charT, OutputIterator> > {
    static const bool is = true;
    static money_put<charT, OutputIterator> *make() { return new money_put<charT, OutputIterator>(1); }
};

template <class charT, class InputIterator = istreambuf_iterator<charT> > class money_get : public locale::facet {
public:
    typedef charT char_type;
    typedef InputIterator iter_type;
    typedef basic_string<charT> string_type;
    static const int __cxx1_category = locale::monetary;
    explicit money_get(size_t refs = 0) : locale::facet(refs) {}
    iter_type get(iter_type s, iter_type end, bool intl, ios_base &f, ios_base::iostate &err, long double &units) const {
        return do_get(s, end, intl, f, err, units);
    }
    iter_type get(iter_type s, iter_type end, bool intl, ios_base &f, ios_base::iostate &err, string_type &digits) const {
        return do_get(s, end, intl, f, err, digits);
    }
    static locale::id id;

protected:
    ~money_get() {}
    virtual iter_type do_get(iter_type s, iter_type end, bool intl, ios_base &str, ios_base::iostate &err, long double &units) const {
        string_type digits;
        ios_base::iostate e = ios_base::goodbit;
        s = do_get(s, end, intl, str, e, digits);
        err |= e;
        if ((e & ios_base::failbit) == 0) {
            const ctype<charT> &ct = use_facet<ctype<charT> >(str.getloc());
            string narrow;
            for (size_t i = 0; i < digits.size(); i++) narrow += ct.narrow(digits[i], '0');
            units = std::strtold(narrow.c_str(), 0);
        }
        return s;
    }
    // [locale.money.get.virtuals]: the negative pattern read - the symbol where showbase asks for it, either sign,
    // the digits with their separators and the point - and the digits answered as units of frac_digits.
    virtual iter_type do_get(iter_type s, iter_type end, bool intl, ios_base &str, ios_base::iostate &err, string_type &digits) const {
        const locale loc = str.getloc();
        const ctype<charT> &ct = use_facet<ctype<charT> >(loc);
        string_type sym, pos, neg;
        money_base::pattern pat;
        int frac;
        charT point, sep;
        string grouping;
        if (intl) {
            const moneypunct<charT, true> &mp = use_facet<moneypunct<charT, true> >(loc);
            sym = mp.curr_symbol(); pos = mp.positive_sign(); neg = mp.negative_sign(); pat = mp.neg_format();
            frac = mp.frac_digits(); point = mp.decimal_point(); sep = mp.thousands_sep(); grouping = mp.grouping();
        } else {
            const moneypunct<charT, false> &mp = use_facet<moneypunct<charT, false> >(loc);
            sym = mp.curr_symbol(); pos = mp.positive_sign(); neg = mp.negative_sign(); pat = mp.neg_format();
            frac = mp.frac_digits(); point = mp.decimal_point(); sep = mp.thousands_sep(); grouping = mp.grouping();
        }
        if (frac < 0) frac = 0;
        bool negative = false, any = false;
        const string_type *signSeen = 0;
        string_type whole, part;
        bool inPart = false;
        for (int k = 0; k < 4; k++) {
            switch (pat.field[k]) {
            case money_base::none:
            case money_base::space:
                if (k == 3) break;
                while (s != end && ct.is(ctype_base::space, *s)) ++s;
                break;
            case money_base::symbol: {
                const bool required = (str.flags() & ios_base::showbase) != 0;
                size_t i = 0;
                while (i < sym.size() && s != end && *s == sym[i]) { ++s; i++; }
                if (required && i != sym.size() && !sym.empty()) { err |= ios_base::failbit; return s; }
                break;
            }
            case money_base::sign:
                if (s != end && !neg.empty() && *s == neg[0]) { negative = true; signSeen = &neg; ++s; }
                else if (s != end && !pos.empty() && *s == pos[0]) { signSeen = &pos; ++s; }
                else if (!pos.empty() && neg.empty()) negative = true;
                break;
            case money_base::value:
                for (; s != end; ++s) {
                    const charT c = *s;
                    if (ct.is(ctype_base::digit, c)) { (inPart ? part : whole) += c; any = true; continue; }
                    if (!inPart && frac > 0 && c == point) { inPart = true; continue; }
                    if (!inPart && !grouping.empty() && c == sep && any) continue;
                    break;
                }
                break;
            }
        }
        if (signSeen != 0)
            for (size_t i = 1; i < signSeen->size(); i++) {
                if (s == end || *s != (*signSeen)[i]) { err |= ios_base::failbit; return s; }
                ++s;
            }
        if (s == end) err |= ios_base::eofbit;
        if (!any) { err |= ios_base::failbit; return s; }
        while (static_cast<int>(part.size()) < frac) part += ct.widen('0');
        if (static_cast<int>(part.size()) > frac) part.resize(static_cast<size_t>(frac));
        string_type all = whole + part;
        size_t lead = 0;
        while (lead + 1 < all.size() && all[lead] == ct.widen('0')) lead++;
        all = all.substr(lead);
        digits.clear();
        if (negative) digits += ct.widen('-');
        digits += all;
        return s;
    }
};
template <class charT, class InputIterator> locale::id money_get<charT, InputIterator>::id;
template <class charT, class InputIterator> struct __cxx1_standard_facet<money_get<charT, InputIterator> > {
    static const bool is = true;
    static money_get<charT, InputIterator> *make() { return new money_get<charT, InputIterator>(1); }
};

