// <queue> - [queue]: first in first out over a deque; [priority.queue]: the greatest first, a heap over a vector
// kept by <algorithm>'s push_heap and pop_heap.
#ifndef _CXX1_QUEUE
#define _CXX1_QUEUE

#include <deque>
#include <vector>
#include <algorithm>
#include <functional>
#include <utility>
#include <memory>

namespace std {

template <class T, class Container = deque<T> > class queue {
public:
    typedef typename Container::value_type value_type;
    typedef typename Container::reference reference;
    typedef typename Container::const_reference const_reference;
    typedef typename Container::size_type size_type;
    typedef Container container_type;

protected:
    Container c;

public:
    explicit queue(const Container &x) : c(x) {}
    explicit queue(Container &&x = Container()) : c(std::move(x)) {}
    template <class A> explicit queue(const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(a) {}
    template <class A> queue(const Container &x, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(x, a) {}
    template <class A> queue(Container &&x, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(std::move(x), a) {}
    template <class A> queue(const queue &q, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(q.c, a) {}
    template <class A> queue(queue &&q, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(std::move(q.c), a) {}

    bool empty() const { return c.empty(); }
    size_type size() const { return c.size(); }
    reference front() { return c.front(); }
    const_reference front() const { return c.front(); }
    reference back() { return c.back(); }
    const_reference back() const { return c.back(); }
    void push(const value_type &x) { c.push_back(x); }
    void push(value_type &&x) { c.push_back(std::move(x)); }
    template <class... A> void emplace(A &&... a) { c.emplace_back(std::forward<A>(a)...); }
    void pop() { c.pop_front(); }
    void swap(queue &q) {
        using std::swap;
        swap(c, q.c);
    }

    bool __cxx1_equal(const queue &y) const { return c == y.c; }
    bool __cxx1_less(const queue &y) const { return c < y.c; }
};

template <class T, class C> inline bool operator==(const queue<T, C> &x, const queue<T, C> &y) { return x.__cxx1_equal(y); }
template <class T, class C> inline bool operator<(const queue<T, C> &x, const queue<T, C> &y) { return x.__cxx1_less(y); }
template <class T, class C> inline bool operator!=(const queue<T, C> &x, const queue<T, C> &y) { return !(x == y); }
template <class T, class C> inline bool operator>(const queue<T, C> &x, const queue<T, C> &y) { return y < x; }
template <class T, class C> inline bool operator>=(const queue<T, C> &x, const queue<T, C> &y) { return !(x < y); }
template <class T, class C> inline bool operator<=(const queue<T, C> &x, const queue<T, C> &y) { return !(y < x); }
template <class T, class C> inline void swap(queue<T, C> &x, queue<T, C> &y) { x.swap(y); }
template <class T, class C, class A> struct uses_allocator<queue<T, C>, A> : uses_allocator<C, A>::type {};

template <class T, class Container = vector<T>, class Compare = less<typename Container::value_type> >
class priority_queue {
public:
    typedef typename Container::value_type value_type;
    typedef typename Container::reference reference;
    typedef typename Container::const_reference const_reference;
    typedef typename Container::size_type size_type;
    typedef Container container_type;

protected:
    Container c;
    Compare comp;

public:
    priority_queue(const Compare &x, const Container &y) : c(y), comp(x) { std::make_heap(c.begin(), c.end(), comp); }
    explicit priority_queue(const Compare &x = Compare(), Container &&y = Container()) : c(std::move(y)), comp(x) {
        std::make_heap(c.begin(), c.end(), comp);
    }
    template <class It>
    priority_queue(It first, It last, const Compare &x, const Container &y) : c(y), comp(x) {
        c.insert(c.end(), first, last);
        std::make_heap(c.begin(), c.end(), comp);
    }
    template <class It>
    priority_queue(It first, It last, const Compare &x = Compare(), Container &&y = Container())
        : c(std::move(y)), comp(x) {
        c.insert(c.end(), first, last);
        std::make_heap(c.begin(), c.end(), comp);
    }
    template <class A> explicit priority_queue(const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(a), comp() {}
    template <class A> priority_queue(const Compare &x, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(a), comp(x) {}
    template <class A>
    priority_queue(const Compare &x, const Container &y, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0)
        : c(y, a), comp(x) {
        std::make_heap(c.begin(), c.end(), comp);
    }
    template <class A>
    priority_queue(const Compare &x, Container &&y, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0)
        : c(std::move(y), a), comp(x) {
        std::make_heap(c.begin(), c.end(), comp);
    }
    template <class A> priority_queue(const priority_queue &q, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(q.c, a), comp(q.comp) {}
    template <class A> priority_queue(priority_queue &&q, const A &a, typename enable_if<uses_allocator<Container, A>::value>::type * = 0) : c(std::move(q.c), a), comp(std::move(q.comp)) {}

    bool empty() const { return c.empty(); }
    size_type size() const { return c.size(); }
    const_reference top() const { return c.front(); }
    void push(const value_type &x) {
        c.push_back(x);
        std::push_heap(c.begin(), c.end(), comp);
    }
    void push(value_type &&x) {
        c.push_back(std::move(x));
        std::push_heap(c.begin(), c.end(), comp);
    }
    template <class... A> void emplace(A &&... a) {
        c.emplace_back(std::forward<A>(a)...);
        std::push_heap(c.begin(), c.end(), comp);
    }
    void pop() {
        std::pop_heap(c.begin(), c.end(), comp);
        c.pop_back();
    }
    void swap(priority_queue &q) {
        using std::swap;
        swap(c, q.c);
        swap(comp, q.comp);
    }
};
template <class T, class C, class Cmp> inline void swap(priority_queue<T, C, Cmp> &x, priority_queue<T, C, Cmp> &y) { x.swap(y); }
template <class T, class C, class Cmp, class A>
struct uses_allocator<priority_queue<T, C, Cmp>, A> : uses_allocator<C, A>::type {};

}  // namespace std

#endif
