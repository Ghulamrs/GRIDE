<?xml version="1.0" encoding="utf-8"?>
<!--
  ToolchainBeside.vcxproj - GRIDE3.sln's one build of the toolchain, put beside each outlook's GRIDE.exe. GRIDE3.sln
  builds the eleven tools, the runtimes and gride-dbg once, into x64\<Config>\ beside it; the three GRIDE projects
  build into GRIDEd\x64\<Config>, GRIDE 2.0\x64\<Config> and GRIDE 1.0\x64\<Config>. Each outlook finds its tools
  beside GRIDE.exe (toolchain.json's lookup), and the Setup stages those three folders, so this project copies the
  one build into each. A Utility project: nothing is compiled, and a file already there unchanged is not copied.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7B7E06B9-2A45-4E37-B27F-4A2DFDAD1A9E}</ProjectGuid>
    <RootNamespace>ToolchainBeside</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <GrideRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))\</GrideRoot>
    <OutDir>$(MSBuildThisFileDirectory)build\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)</IntDir>
    <!-- Visual Studio's own up-to-date check knows nothing of the tools, so it would skip the copies -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ToolchainOutput>$(GrideRoot)$(Platform)\$(Configuration)\</ToolchainOutput>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="ToolchainBeside" AfterTargets="Build">
    <ItemGroup>
      <ToolchainFile Include="$(ToolchainOutput)**\*" />
    </ItemGroup>
    <Error Condition="!Exists('$(ToolchainOutput)cpp11.exe')" Text="ToolchainBeside: no cpp11.exe in $(ToolchainOutput) - build GRIDE3.sln" />
    <Copy SourceFiles="@(ToolchainFile)" DestinationFiles="@(ToolchainFile->'$(GrideRoot)GRIDEd\$(Platform)\$(Configuration)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ToolchainFile)" DestinationFiles="@(ToolchainFile->'$(GrideRoot)GRIDE 2.0\$(Platform)\$(Configuration)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ToolchainFile)" DestinationFiles="@(ToolchainFile->'$(GrideRoot)GRIDE 1.0\$(Platform)\$(Configuration)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="ToolchainBeside: the one build of the toolchain is beside the three outlooks' GRIDE.exe" />
  </Target>
</Project>
