<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolchain.targets - the toolchain's build steps as MSBuild tasks, so no step runs through cmd.exe (it is blocked
  on this machine, and nothing here needs it). Imported by rts6x.vcxproj and shc.vcxproj.

    RunTool        runs one program with its arguments, in a folder, optionally with Visual Studio's INCLUDE,
                   LIB and PATH (for cl and lib); fails the build when it exits non-zero
    Rts6xVariant   RTS6x's build.cmd :variant - every folder of src\ through cpp11 (its .cpp) and asm6x (its .s),
                   then the library's members packed by ar6x into rts6x<tag>.lib and printf6x<tag>.lib
    PackObjects    a folder of .s through asm6x and the objects packed by ar6x into one library (shmrt6x[d].lib)
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <UsingTask TaskName="RunTool" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Exe ParameterType="System.String" Required="true" />
      <Arguments ParameterType="System.String" />
      <WorkingDirectory ParameterType="System.String" />
      <IncludePath ParameterType="System.String" />
      <LibPath ParameterType="System.String" />
      <ExePath ParameterType="System.String" />
      <Quiet ParameterType="System.Boolean" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(Exe)) { Log.LogError("RunTool: no program at " + Exe); return false; }
        var psi = new ProcessStartInfo(Exe, Arguments ?? "");
        psi.UseShellExecute = false; psi.CreateNoWindow = true;
        psi.RedirectStandardOutput = true; psi.RedirectStandardError = true;
        if (!string.IsNullOrEmpty(WorkingDirectory)) { Directory.CreateDirectory(WorkingDirectory); psi.WorkingDirectory = WorkingDirectory; }
        if (!string.IsNullOrEmpty(IncludePath)) psi.EnvironmentVariables["INCLUDE"] = IncludePath;
        if (!string.IsNullOrEmpty(LibPath)) psi.EnvironmentVariables["LIB"] = LibPath;
        if (!string.IsNullOrEmpty(ExePath)) psi.EnvironmentVariables["PATH"] = ExePath + ";" + psi.EnvironmentVariables["PATH"];
        var lines = new System.Collections.Generic.List<string>();
        object gate = new object();
        using (var p = new Process())
        {
            p.StartInfo = psi;
            p.OutputDataReceived += (s, e) => { if (e.Data != null) lock (gate) lines.Add(e.Data); };
            p.ErrorDataReceived += (s, e) => { if (e.Data != null) lock (gate) lines.Add(e.Data); };
            p.Start(); p.BeginOutputReadLine(); p.BeginErrorReadLine(); p.WaitForExit();
            var imp = Quiet ? Microsoft.Build.Framework.MessageImportance.Low : Microsoft.Build.Framework.MessageImportance.Normal;
            Log.LogMessage(imp, "> \"" + Exe + "\" " + Arguments);
            foreach (var l in lines) Log.LogMessage(p.ExitCode != 0 ? Microsoft.Build.Framework.MessageImportance.High : imp, l);
            if (p.ExitCode != 0) Log.LogError(Path.GetFileName(Exe) + " exited with " + p.ExitCode + " (" + Arguments + ")");
        }
        // (the task factory ends the fragment with return !Log.HasLoggedErrors)
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="Rts6xVariant" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Linq;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

// RTS6x's build.cmd, :variant: every folder of src\ compiled and assembled, then the members - every .cpp and .s
// of src\, the *-reference files and the eh-none\ and internal\ folders left out - packed by ar6x, and
// printf6x.lib from printf6x.members. build.cmd ran cpp11 -c, which assembles through std::system and so
// through cmd.exe; here cpp11 -S writes each .cpp's assembly as <stem>.s into the object folder and asm6x is run
// directly on it - the same objects (asm6x records only the input's name, which -c also gave as <stem>.s).
public class Rts6xVariant : Task
{
    [Required] public string Cpp11 { get; set; }
    [Required] public string Asm6x { get; set; }
    [Required] public string Ar6x { get; set; }
    [Required] public string SourceRoot { get; set; }     // RTS6x's folder (src\, printf6x.members)
    [Required] public string ObjDir { get; set; }
    [Required] public string Flags { get; set; }
    [Required] public string Members { get; set; }
    [Required] public string Library { get; set; }
    [Required] public string PrintfLibrary { get; set; }

    // runs one program; its output and exit code are returned, not logged, so it can run on several threads
    static int Exec(string exe, string args, out string output)
    {
        var psi = new ProcessStartInfo(exe, args) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true };
        var lines = new List<string>(); object gate = new object();
        using (var p = new Process { StartInfo = psi })
        {
            p.OutputDataReceived += (s, e) => { if (e.Data != null) lock (gate) lines.Add(e.Data); };
            p.ErrorDataReceived += (s, e) => { if (e.Data != null) lock (gate) lines.Add(e.Data); };
            p.Start(); p.BeginOutputReadLine(); p.BeginErrorReadLine(); p.WaitForExit();
            output = string.Join(Environment.NewLine, lines);
            return p.ExitCode;
        }
    }

    bool Run(string exe, string args)
    {
        string output;
        int rc = Exec(exe, args, out output);
        Log.LogMessage(MessageImportance.Low, "> \"" + exe + "\" " + args);
        if (rc == 0) return true;
        if (output.Length > 0) Log.LogMessage(MessageImportance.High, output);
        Log.LogError(Path.GetFileName(exe) + " exited with " + rc + " (" + args + ")");
        return false;
    }

    public override bool Execute()
    {
        string src = Path.Combine(SourceRoot, "src");
        string internalDir = Path.Combine(src, "internal");
        foreach (string d in Directory.GetDirectories(src).OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
        {
            string name = Path.GetFileName(d);
            string obj = Path.Combine(ObjDir, name);
            string asm = Path.Combine(obj, "s");
            Directory.CreateDirectory(obj);
            string[] sources = Directory.GetFiles(d, "*.cpp").OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
            if (sources.Length > 0)
            {
                Directory.CreateDirectory(asm);
                var failures = new System.Collections.Concurrent.ConcurrentBag<string>();
                System.Threading.Tasks.Parallel.ForEach(sources, new System.Threading.Tasks.ParallelOptions { MaxDegreeOfParallelism = Environment.ProcessorCount }, f =>
                {
                    string args = "-S -arch tms6747 -nologo " + Flags + " \"-I" + internalDir + "\" \"" + f + "\" -o \"" +
                                  Path.Combine(asm, Path.GetFileNameWithoutExtension(f) + ".s") + "\"";
                    string output;
                    int rc = Exec(Cpp11, args, out output);
                    if (rc != 0) failures.Add("cpp11 exited with " + rc + " (" + args + ")" + Environment.NewLine + output);
                });
                if (!failures.IsEmpty)
                {
                    foreach (string f in failures.OrderBy(x => x, StringComparer.OrdinalIgnoreCase)) Log.LogError(f);
                    Log.LogError("rts6x: cpp11 refused something in " + d);
                    return false;
                }
                if (!Run(Asm6x, "\"" + Path.Combine(asm, "*.s") + "\" -o \"" + obj + "\"")) return false;
            }
            if (Directory.GetFiles(d, "*.s").Length > 0 &&
                !Run(Asm6x, "\"" + Path.Combine(d, "*.s") + "\" -o \"" + obj + "\"")) return false;
        }
        var members = new List<string>();
        foreach (string dir in new[] { src }.Concat(Directory.GetDirectories(src, "*", SearchOption.AllDirectories).OrderBy(x => x, StringComparer.OrdinalIgnoreCase)))
        {
            string rel = dir.Length > src.Length ? dir.Substring(src.Length + 1) + "\\" : "";
            if (rel.Equals("eh-none\\", StringComparison.OrdinalIgnoreCase) || rel.Equals("internal\\", StringComparison.OrdinalIgnoreCase)) continue;
            foreach (string pattern in new[] { "*.cpp", "*.s" })
                foreach (string f in Directory.GetFiles(dir, pattern).OrderBy(x => x, StringComparer.OrdinalIgnoreCase))
                {
                    string stem = Path.GetFileNameWithoutExtension(f);
                    if (stem.EndsWith("-reference", StringComparison.OrdinalIgnoreCase)) continue;
                    members.Add(Path.Combine(ObjDir, rel + stem + ".obj"));
                }
        }
        string list = Path.Combine(ObjDir, Path.GetFileNameWithoutExtension(Library) + ".objs");
        Directory.CreateDirectory(Path.GetDirectoryName(Library));
        File.WriteAllLines(list, members);
        if (File.Exists(Library)) File.Delete(Library);
        if (!Run(Ar6x, "-r \"" + Library + "\" @\"" + list + "\"")) return false;
        Log.LogMessage(MessageImportance.Normal, "rts6x: " + Library + " (" + members.Count + " members)");

        var printf = new List<string>();
        foreach (string line in File.ReadAllLines(Members))
        {
            string m = line.Trim();
            if (m.Length == 0) continue;
            if (m.StartsWith("src/")) m = m.Substring(4);
            m = m.Replace('/', '\\');
            m = Path.ChangeExtension(m, ".obj");
            printf.Add("\"" + Path.Combine(ObjDir, m) + "\"");
        }
        if (File.Exists(PrintfLibrary)) File.Delete(PrintfLibrary);
        if (!Run(Ar6x, "-r \"" + PrintfLibrary + "\" " + string.Join(" ", printf))) return false;
        Log.LogMessage(MessageImportance.Normal, "rts6x: " + PrintfLibrary + " (" + printf.Count + " members)");
        return true;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="PackObjects" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Asm6x ParameterType="System.String" Required="true" />
      <Ar6x ParameterType="System.String" Required="true" />
      <AssemblyDir ParameterType="System.String" Required="true" />
      <ObjDir ParameterType="System.String" Required="true" />
      <Library ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // rts6x's own step for the Shalimar runtime of the C6747: the assembly shc's build wrote (lib\shmrt-tms6747
        // or its -debug twin) through asm6x into a fresh folder, and every object packed by ar6x into one library
        if (Directory.Exists(ObjDir)) Directory.Delete(ObjDir, true);
        Directory.CreateDirectory(ObjDir);
        Func<string, string, bool> run = (exe, args) =>
        {
            var psi = new ProcessStartInfo(exe, args) { UseShellExecute = false, CreateNoWindow = true, RedirectStandardOutput = true, RedirectStandardError = true };
            using (var p = Process.Start(psi))
            {
                string o = p.StandardOutput.ReadToEnd(), e = p.StandardError.ReadToEnd();
                p.WaitForExit();
                if (p.ExitCode != 0) { Log.LogError(Path.GetFileName(exe) + " exited with " + p.ExitCode + " (" + args + ")\n" + o + e); return false; }
            }
            return true;
        };
        if (!run(Asm6x, "\"" + Path.Combine(AssemblyDir, "*.s") + "\" -o \"" + ObjDir + "\"")) return false;
        var objs = Directory.GetFiles(ObjDir, "*.obj", SearchOption.AllDirectories).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToArray();
        string list = ObjDir.TrimEnd('\\') + ".list";
        File.WriteAllLines(list, objs);
        Directory.CreateDirectory(Path.GetDirectoryName(Library));
        if (File.Exists(Library)) File.Delete(Library);
        if (!run(Ar6x, "-r \"" + Library + "\" @\"" + list + "\"")) return false;
        Log.LogMessage(MessageImportance.Normal, "rts6x: " + Library + " (" + objs.Length + " members)");
        // (the task factory ends the fragment with return !Log.HasLoggedErrors)
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Visual Studio's compiler and librarian for the project's toolset, with the environment they read -->
  <PropertyGroup>
    <ToolchainCl>$(VCToolsInstallDir)bin\HostX64\x64\cl.exe</ToolchainCl>
    <ToolchainLib>$(VCToolsInstallDir)bin\HostX64\x64\lib.exe</ToolchainLib>
  </PropertyGroup>
</Project>
