# The sources of RTS6x's C library (toolchain\TI\RTS6x\src) that grtc compiles for x86_64-windows with cpp11,
# beside grtc's own c\. A line names a file or a folder's *.cpp; a line starting with - takes one back out.
# What is left out is the C6747's: its host and boot (the Windows layer and start-up are grtwin's and
# grtstart's), its assembly (.s, C6000 instructions), the C6000 ABI's helpers, the Itanium C++ ABI, and the
# files whose Windows form is the runtime's own - noted where they go.
ctype/*.cpp
# locale: setlocale is c\setlocale.cpp, which also asks for UTF-8 (docs\Runtime_Design.md 6)
locale/*.cpp
-locale/setlocale.cpp
# math: fabs is c\fabs.asm (two instructions) and sqrt c\sqrt.asm (the processor's sqrtsd, and EDOM); exp, log, sin,
# cos and pow are c\mathfast.asm, which leaves the cases it does not take to RTS6x's kernels (c\mathslow.cpp);
# rint and nearbyint are c\rint.asm, in the rounding mode in force; fma is c\fma.asm, the processor's instruction
# where it has one and RTS6x's exact sum where not (c\fmasoft.cpp)
math/*.cpp
-math/fabs.cpp
-math/sqrt.cpp
-math/exp.cpp
-math/log.cpp
-math/sin.cpp
-math/cos.cpp
-math/pow.cpp
-math/rint.cpp
-math/nearbyint.cpp
-math/fma.cpp
# exit: atexit is c\atexit.cpp, RTS6x's with its list locked once a program has threads; exit is c\exit.cpp, which
# ends the calling thread's thread_local objects first; abort is c\abort.cpp, the Release and Debug runtimes' ends
exit/*.cpp
-exit/atexit.cpp
-exit/exit.cpp
-exit/abort.cpp
# string: memcpy, memmove and memset are c\memory.asm; strlen, strchr, strrchr, memchr, memcmp, strcmp, strncmp,
# strcpy and strcat are c\string\*.asm (SSE2); the rest are RTS6x's C++
string/*.cpp
-string/memcpy-reference.cpp
-string/memmove-reference.cpp
-string/memset-reference.cpp
-string/strlen-reference.cpp
-string/strchr-reference.cpp
-string/strrchr.cpp
-string/memchr.cpp
-string/memcmp.cpp
-string/strcmp-reference.cpp
-string/strncmp.cpp
-string/strcpy.cpp
-string/strcat.cpp
# stdlib: the heap is Windows' (win\heap.c); qsort is c\qsort.cpp, the Microsoft runtime's order of equal elements;
# rand and srand are c\rand.cpp, the Microsoft runtime's generator; mblen is c\multibyte.cpp, which reads UTF-8 once
# setlocale asks for it
stdlib/*.cpp
-stdlib/mblen.cpp
-stdlib/rand.cpp
-stdlib/srand.cpp
-stdlib/Random.cpp
-stdlib/qsort.cpp
-stdlib/Heap.cpp
-stdlib/malloc.cpp
-stdlib/calloc.cpp
-stdlib/realloc.cpp
-stdlib/free.cpp
-stdlib/_msize.cpp
# stdio: the scanning engine and the float conversions are RTS6x's; the printf family reads its format as the
# Microsoft runtime does (c\fmt\Printer.h), into memory (c\sprintf.cpp ...) or a stream. The stream itself (its
# buffer, opening and closing, position) is the Windows stream layer's (c\Stream*.cpp), and so are fflush,
# tmpfile, the character functions (c\fputc.cpp ...) and _fileno (c\streams.cpp). The functions that take a FILE
# are grtc's own files (c\fprintf.cpp ...), which lock the stream for the call once a program has threads
# (c\StreamWin.h). feof and ferror are grtc's too (c\feof.cpp, c\ferror.cpp: a null FILE * fails fast). fopen (its
# slot claimed by the stream layer), perror (fputs and fputc), remove, rename and sscanf stay RTS6x's.
stdio/*.cpp
-stdio/StreamRead.cpp
-stdio/StreamOpen.cpp
-stdio/StreamFill.cpp
-stdio/StreamPosition.cpp
-stdio/StreamWrite.cpp
-stdio/fflush.cpp
-stdio/tmpfile.cpp
-stdio/fputc.cpp
-stdio/putc.cpp
-stdio/putchar.cpp
-stdio/fgetc.cpp
-stdio/getc.cpp
-stdio/getchar.cpp
-stdio/fileno.cpp
-stdio/clearerr.cpp
-stdio/feof.cpp
-stdio/ferror.cpp
-stdio/fclose.cpp
-stdio/fgets.cpp
-stdio/fprintf.cpp
-stdio/fputs.cpp
-stdio/fread.cpp
-stdio/freopen.cpp
-stdio/fscanf.cpp
-stdio/fseek.cpp
-stdio/ftell.cpp
-stdio/fwrite.cpp
-stdio/gets.cpp
-stdio/printf.cpp
-stdio/puts.cpp
-stdio/rewind.cpp
-stdio/scanf.cpp
-stdio/ungetc.cpp
-stdio/vfprintf.cpp
-stdio/vprintf.cpp
-stdio/wprintf.cpp
-stdio/sprintf.cpp
-stdio/snprintf.cpp
-stdio/vsprintf.cpp
-stdio/vsnprintf.cpp
-stdio/_snprintf.cpp
-stdio/_vsnprintf.cpp
# time: the calendar and the formatter; the clock and the time zone are Windows' (win\time.c, c\time64.cpp)
time/Calendar.cpp
time/TimeFormatter.cpp
time/asctime.cpp
time/strftime.cpp
# misc: none of it. Signals are c\signals.cpp, the Microsoft runtime's numbers, Ctrl+C and the SEH signals; errno's
# storage is grtwin's (win\errno.cpp); getenv reads the Windows environment (win\environment.c); strerror says what
# the Microsoft runtime says (c\messages.c); setjmp is c\setjmp.asm
# helpers: the soft-float arithmetic math reads its bits with (the C6000 ABI's entry points are left out)
helpers/SoftFloat.cpp
helpers/FloatRounding.cpp
