; kernel32.def - the import library grt's programs link against, written by GRIDE's own librarian
; (link /LIB /DEF:kernel32.def /OUT:kernel32.lib); no SDK library is read. Two parts: the functions grt
; calls (src\internal\win32.h declares them), and the ones the compilers' own <windows.h> declares, so a
; program that includes it links with GRIDE's runtime as it does with Microsoft's. The grt build checks
; that grt.lib with this library leaves nothing undefined.
LIBRARY KERNEL32.dll
EXPORTS
    ; grt: files and handles
    GetStdHandle
    GetFileType
    GetConsoleMode
    WriteConsoleW
    ReadConsoleW
    WriteFile
    ReadFile
    CreateFileW
    CloseHandle
    SetFilePointerEx
    DeleteFileW
    MoveFileExW
    GetLastError
    SetLastError
    ; grt: directories and a file's status (win\getcwd.c, findfile.c, stat.c, access.c, directory.c)
    SetCurrentDirectoryW
    SetEnvironmentVariableW
    CreateDirectoryW
    RemoveDirectoryW
    GetFileAttributesExW
    GetFileInformationByHandle
    PeekNamedPipe
    GetDriveTypeW
    FindFirstFileExW
    FindNextFileW
    FindClose
    GetCurrentDirectoryW
    GetFullPathNameW
    ; grt: Ctrl+C and Ctrl+Break for signal (win\control.c), and the event a program sends itself
    SetConsoleCtrlHandler
    GenerateConsoleCtrlEvent
    ; grt: the temporary files' folder and names (win\temporary.c)
    GetTempPathW
    GetCurrentProcessId
    ; grt: system (win\system.c)
    CreateProcessW
    WaitForSingleObject
    GetExitCodeProcess
    ; grt: the heap, and memory by pages (the string tests' unreadable pages)
    GetProcessHeap
    HeapAlloc
    HeapReAlloc
    HeapFree
    VirtualAlloc
    VirtualProtect
    VirtualFree
    ; grt: the command line, the environment, text in the ANSI code page
    GetCommandLineW
    GetCommandLineA
    GetStartupInfoW
    GetModuleFileNameW
    GetEnvironmentStringsW
    FreeEnvironmentStringsW
    WideCharToMultiByte
    MultiByteToWideChar
    ; grt: time and the time zone
    GetSystemTimeAsFileTime
    QueryPerformanceCounter
    QueryPerformanceFrequency
    FileTimeToSystemTime
    SystemTimeToFileTime
    SystemTimeToTzSpecificLocalTime
    TzSpecificLocalTimeToSystemTime
    GetTimeZoneInformation
    ; grt: locks (win\lock.c: function-local statics, the descriptors, the streams, the atexit list)
    AcquireSRWLockExclusive
    ReleaseSRWLockExclusive
    SleepConditionVariableSRW
    WakeAllConditionVariable
    ; grt: CreateThread is grtwin's own (win\thread.c), over kernel32's: DATA, so that this library defines
    ; __imp_CreateThread alone and no thunk of the plain name competes with grt's
    CreateThread DATA
    ; grt: C++ exceptions over structured ones (win\seh.c), and the runtime's block for each thread
    RaiseException
    RtlUnwindEx
    RtlPcToFileHeader
    RtlLookupFunctionEntry
    SetUnhandledExceptionFilter
    FlsAlloc
    FlsGetValue
    FlsSetValue
    ; grt: the end
    ExitProcess
    ; grt: wctype's classes past 255 (win\chartype.c), and rand_s's generator, advapi32's, loaded when first wanted
    ; (win\random.c), so that a program still imports KERNEL32.dll alone
    GetStringTypeW
    LoadLibraryW
    GetProcAddress
    ; the compilers' <windows.h> (cpp11's lib\windows.h): threads, waits, locks, the clock
    WaitForMultipleObjects
    GetSystemInfo
    GetTickCount
    GetTickCount64
    GetCurrentThreadId
    Sleep
    InitializeCriticalSection
    EnterCriticalSection
    LeaveCriticalSection
    DeleteCriticalSection
    ; the compilers' <chrono> and <system_error> (cpp11 1.53): system_clock's time, an error code's message
    GetSystemTimePreciseAsFileTime
    FormatMessageA
    ; the compilers' <mutex>, <condition_variable> and <thread> (cpp11 1.54's __threads)
    TryAcquireSRWLockExclusive
    WakeConditionVariable
    SwitchToThread
    GetActiveProcessorCount
