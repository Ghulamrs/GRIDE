  <ItemGroup>
    <!-- the one toolchain.json of the three outlooks, common\toolchain.json (2026-11-12): this project keeps no copy -->
    <None Include="..\common\toolchain.json" />
    <None Include="lib\ccs\options-ccs74-C6000_8.2.tsv" />
    <None Include="lib\ccs\options-ccs55-C6000_7.4.tsv" />
    <None Include="..\docs\GRIDE_Help.html" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyToolchainFile" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\common\toolchain.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\common\compile\$(Platform)\$(Configuration)\compile.dll;$(ProjectDir)..\common\compile\$(Platform)\$(Configuration)\gride-plan.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- TI's option definitions for reading CCS projects (toolchain.json's ccs section names them) -->
    <ItemGroup>
      <CcsDefinitionFiles Include="$(ProjectDir)lib\ccs\*.tsv" />
    </ItemGroup>
    <Copy SourceFiles="@(CcsDefinitionFiles)" DestinationFolder="$(OutDir)share\ccs" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutDir)lib\ccs" />
  </Target>
  <!-- Help: GRIDEx3's docs\, which the three outlooks share - GRIDE_Help.html, RIDE's manual and its chapter pages,
       the Shalimar reference and the toolchain file's format - in docs beside the exe, where Help looks -->
  <Target Name="CopyHelpFiles" AfterTargets="Build">
    <ItemGroup>
      <HelpFiles Include="$(ProjectDir)..\docs\*.html;$(ProjectDir)..\docs\*.md" />
    </ItemGroup>
    <Copy SourceFiles="@(HelpFiles)" DestinationFolder="$(OutDir)docs" SkipUnchangedFiles="true" />
  </Target>
</Project>
