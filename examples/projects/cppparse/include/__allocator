// __allocator - cppparse's C++98 library: std::allocator (20.4.1), the default allocator of the containers and of
// basic_string, on its own so that <string> has it without <memory> (whose <iterator> includes the streams).
#ifndef CPPPARSE_ALLOCATOR
#define CPPPARSE_ALLOCATOR

#include <cstddef>
#include <cstdlib>
#include <new>

namespace std {

template <class T>
class allocator {
public:
    typedef size_t    size_type;
    typedef ptrdiff_t difference_type;
    typedef T*        pointer;
    typedef const T*  const_pointer;
    typedef T&        reference;
    typedef const T&  const_reference;
    typedef T         value_type;
    template <class U> struct rebind { typedef allocator<U> other; };

    allocator() {}
    allocator(const allocator&) {}
    template <class U> allocator(const allocator<U>&) {}
    pointer       address(reference r) const { return &r; }
    const_pointer address(const_reference r) const { return &r; }
    pointer   allocate(size_type n, const void* = 0) { return static_cast<pointer>(malloc(n * sizeof(T))); }
    void      deallocate(pointer p, size_type) { free(p); }
    size_type max_size() const { return ~static_cast<size_t>(0) / sizeof(T); }
    void      construct(pointer p, const T& v) { new (p) T(v); }
    void      destroy(pointer p) { p->~T(); }
};
template <class T, class U> bool operator==(const allocator<T>&, const allocator<U>&) { return true; }
template <class T, class U> bool operator!=(const allocator<T>&, const allocator<U>&) { return false; }

}

#endif
