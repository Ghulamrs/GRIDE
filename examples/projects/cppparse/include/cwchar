    using ::fgetwc; using ::fputwc; using ::fgetws; using ::fputws; using ::getwc; using ::putwc; using ::getwchar; using ::putwchar; using ::ungetwc;
    using ::wprintf; using ::fwprintf; using ::wscanf; using ::fwscanf;
}

#endif
