// cwchar - cppparse's C++98 library: the wide-character functions of MSVC's C runtime (wchar_t is 16 bits).
#ifndef CPPPARSE_CWCHAR
#define CPPPARSE_CWCHAR

#include <cstddef>
#include <cstdio>
#include <cstring>

typedef unsigned short wint_t;
typedef int            mbstate_t;
#define WEOF ((wint_t)0xffff)
#ifndef WCHAR_MIN
#define WCHAR_MIN 0
#define WCHAR_MAX 0xffff
#endif

extern "C" {
    size_t   wcslen(const wchar_t* s);
    int      wcscmp(const wchar_t* a, const wchar_t* b);
    int      wcsncmp(const wchar_t* a, const wchar_t* b, size_t n);
    wchar_t* wcscpy(wchar_t* dst, const wchar_t* src);
    wchar_t* wcsncpy(wchar_t* dst, const wchar_t* src, size_t n);
    wchar_t* wcscat(wchar_t* dst, const wchar_t* src);
    wchar_t* wcsncat(wchar_t* dst, const wchar_t* src, size_t n);
    const wchar_t* wcschr(const wchar_t* s, wchar_t c);
    const wchar_t* wcsrchr(const wchar_t* s, wchar_t c);
    const wchar_t* wcspbrk(const wchar_t* s, const wchar_t* accept);
    const wchar_t* wcsstr(const wchar_t* s, const wchar_t* sub);
    size_t   wcsspn(const wchar_t* s, const wchar_t* accept);
    size_t   wcscspn(const wchar_t* s, const wchar_t* reject);
    long     wcstol(const wchar_t* s, wchar_t** end, int base);
    unsigned long wcstoul(const wchar_t* s, wchar_t** end, int base);
    double   wcstod(const wchar_t* s, wchar_t** end);
    size_t   mbrlen(const char* s, size_t n, mbstate_t* state);
    size_t   mbrtowc(wchar_t* out, const char* s, size_t n, mbstate_t* state);
    size_t   wcrtomb(char* out, wchar_t c, mbstate_t* state);
    size_t   mbstowcs(wchar_t* dst, const char* src, size_t n);
    size_t   wcstombs(char* dst, const wchar_t* src, size_t n);
    int      mbtowc(wchar_t* out, const char* s, size_t n);
    int      wctomb(char* out, wchar_t c);
    wint_t   btowc(int c);
    int      wctob(wint_t c);
    wint_t   fgetwc(FILE* f);
    wint_t   fputwc(wchar_t c, FILE* f);
    wchar_t* fgetws(wchar_t* buf, int n, FILE* f);
    int      fputws(const wchar_t* s, FILE* f);
    wint_t   getwc(FILE* f);
    wint_t   putwc(wchar_t c, FILE* f);
    wint_t   getwchar(void);
    wint_t   putwchar(wchar_t c);
    wint_t   ungetwc(wint_t c, FILE* f);
    int      wprintf(const wchar_t* format, ...);
    int      fwprintf(FILE* f, const wchar_t* format, ...);
    int      wscanf(const wchar_t* format, ...);
    int      fwscanf(FILE* f, const wchar_t* format, ...);

    // inline, as the UCRT's own headers define them: its library exports neither wmemcmp nor wmemchr, its import
    // library none of the five
    inline wchar_t* wmemcpy(wchar_t* dst, const wchar_t* src, size_t n) { return static_cast<wchar_t*>(memcpy(dst, src, n * sizeof(wchar_t))); }
    inline wchar_t* wmemmove(wchar_t* dst, const wchar_t* src, size_t n) { return static_cast<wchar_t*>(memmove(dst, src, n * sizeof(wchar_t))); }
    inline wchar_t* wmemset(wchar_t* dst, wchar_t c, size_t n)
    {
        for (wchar_t* p = dst; n > 0; ++p, --n) *p = c;
        return dst;
    }
    inline int wmemcmp(const wchar_t* a, const wchar_t* b, size_t n)
    {
        for (; n > 0; ++a, ++b, --n) if (*a != *b) return *a < *b ? -1 : 1;
        return 0;
    }
    inline const wchar_t* wmemchr(const wchar_t* s, wchar_t c, size_t n)
    {
        for (; n > 0; ++s, --n) if (*s == c) return s;
        return 0;
    }
}

// 21.4: the search functions as a const and a non-const overload, as the UCRT's wchar.h has them for C++
inline wchar_t* wcschr(wchar_t* s, wchar_t c) { return const_cast<wchar_t*>(wcschr(static_cast<const wchar_t*>(s), c)); }
inline wchar_t* wcsrchr(wchar_t* s, wchar_t c) { return const_cast<wchar_t*>(wcsrchr(static_cast<const wchar_t*>(s), c)); }
inline wchar_t* wcspbrk(wchar_t* s, const wchar_t* accept) { return const_cast<wchar_t*>(wcspbrk(static_cast<const wchar_t*>(s), accept)); }
inline wchar_t* wcsstr(wchar_t* s, const wchar_t* sub) { return const_cast<wchar_t*>(wcsstr(static_cast<const wchar_t*>(s), sub)); }
inline wchar_t* wmemchr(wchar_t* s, wchar_t c, size_t n) { return const_cast<wchar_t*>(wmemchr(static_cast<const wchar_t*>(s), c, n)); }

