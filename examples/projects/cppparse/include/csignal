// csignal - cppparse's C++98 library: signal and raise of MSVC's C runtime.
#ifndef CPPPARSE_CSIGNAL
#define CPPPARSE_CSIGNAL

typedef int sig_atomic_t;
typedef void (*__cppparse_sighandler)(int);

extern "C" {
    __cppparse_sighandler signal(int sig, __cppparse_sighandler handler);
    int raise(int sig);
}

#define SIGINT   2
#define SIGILL   4
#define SIGFPE   8
#define SIGSEGV  11
#define SIGTERM  15
#define SIGBREAK 21
#define SIGABRT  22

#define SIG_DFL  ((__cppparse_sighandler)0)
#define SIG_IGN  ((__cppparse_sighandler)1)
#define SIG_ERR  ((__cppparse_sighandler)-1)

namespace std {
    using ::sig_atomic_t; using ::signal; using ::raise;
}

#endif
