// new - cppparse's C++98 library: the global allocation functions, placement new, the nothrow forms and bad_alloc.
// New- and delete-expressions call the global operators by their MSVC names without looking them up here;
// libcpp/iostream.cpp defines them (malloc; bad_alloc thrown through cppparse's runtime when it fails), a program
// that does not link it gets the C runtime's (whose failure is reported through MSVC's exception handling, which no
// cppparse frame can catch), and a program may replace them in any of its units. The nothrow forms are inline here
// (malloc: null when it fails).
#ifndef CPPPARSE_NEW
#define CPPPARSE_NEW

#include <cstddef>
#include <cstdlib>
#include <exception>

namespace std {

class bad_alloc : public exception {
public:
    bad_alloc() {}
    virtual ~bad_alloc() {}
    virtual const char* what() const { return "bad allocation"; }
};

struct nothrow_t {};
const nothrow_t nothrow = {};

typedef void (*new_handler)();

}

void* operator new(size_t);
void* operator new[](size_t);
void  operator delete(void*);
void  operator delete[](void*);
inline void* operator new(size_t, void* place) { return place; }
inline void* operator new[](size_t, void* place) { return place; }
inline void  operator delete(void*, void*) {}
inline void  operator delete[](void*, void*) {}
inline void* operator new(size_t n, const std::nothrow_t&) { return malloc(n ? n : 1); }
inline void* operator new[](size_t n, const std::nothrow_t&) { return malloc(n ? n : 1); }
inline void  operator delete(void* p, const std::nothrow_t&) { free(p); }
inline void  operator delete[](void* p, const std::nothrow_t&) { free(p); }

#endif
