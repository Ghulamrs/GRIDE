void __num_get_in(basic_istream<wchar_t, char_traits<wchar_t> >& is, ios_base::iostate& err, unsigned short& v);
void __num_get_in(basic_istream<wchar_t, char_traits<wchar_t> >& is, ios_base::iostate& err, unsigned int& v);
void __num_get_in(basic_istream<wchar_t, char_traits<wchar_t> >& is, ios_base::iostate& err, unsigned long& v);
void __num_get_in(basic_istream<wchar_t, char_traits<wchar_t> >& is, ios_base::iostate& err, long long& v);
