// __char_traits - cppparse's C++98 library: the stream offsets and positions (27.4.1, 27.4.3) and char_traits<char> and
// char_traits<wchar_t> (21.1), which basic_string and the streams take as their traits; <iosfwd> and <string> include it.
#ifndef CPPPARSE_CHAR_TRAITS
#define CPPPARSE_CHAR_TRAITS

#include <cstddef>
#include <cstring>
#include <cwchar>

namespace std {

typedef long long streamoff;
typedef long long streamsize;

// a stream position: an offset and a conversion state. It converts to and from streamoff, so positions are compared,
// subtracted and moved by an offset through the built-in operators on streamoff (27.4.3.2)
template <class stateT>
class fpos {
public:
    fpos(streamoff off = 0) : m_off(off), m_state() {}
    operator streamoff() const { return m_off; }
    stateT state() const { return m_state; }
    void   state(stateT s) { m_state = s; }
    fpos&  operator+=(streamoff off) { m_off += off; return *this; }
    fpos&  operator-=(streamoff off) { m_off -= off; return *this; }
private:
    streamoff m_off;
    stateT    m_state;
};
typedef fpos<mbstate_t> streampos;
typedef fpos<mbstate_t> wstreampos;

// only the two specialisations are defined (21.1.1: char_traits of another character type is the program's to write)
template <class charT> struct char_traits;

template <>
struct char_traits<char> {
    typedef char      char_type;
    typedef int       int_type;
    typedef streamoff off_type;
    typedef streampos pos_type;
    typedef mbstate_t state_type;

    static void assign(char_type& c1, const char_type& c2) { c1 = c2; }
    static bool eq(const char_type& c1, const char_type& c2) { return c1 == c2; }
    static bool lt(const char_type& c1, const char_type& c2) { return static_cast<unsigned char>(c1) < static_cast<unsigned char>(c2); }
    static int compare(const char_type* s1, const char_type* s2, size_t n) { return n == 0 ? 0 : memcmp(s1, s2, n); }
    static size_t length(const char_type* s) { return strlen(s); }
    static const char_type* find(const char_type* s, size_t n, const char_type& a) { return n == 0 ? 0 : static_cast<const char_type*>(memchr(s, a, n)); }
    static char_type* move(char_type* s1, const char_type* s2, size_t n) { return n == 0 ? s1 : static_cast<char_type*>(memmove(s1, s2, n)); }
    static char_type* copy(char_type* s1, const char_type* s2, size_t n) { return n == 0 ? s1 : static_cast<char_type*>(memcpy(s1, s2, n)); }
    static char_type* assign(char_type* s, size_t n, char_type a) { return n == 0 ? s : static_cast<char_type*>(memset(s, a, n)); }
    static int_type  not_eof(const int_type& c) { return c != eof() ? c : 0; }
    static char_type to_char_type(const int_type& c) { return static_cast<char_type>(c); }
    static int_type  to_int_type(const char_type& c) { return static_cast<unsigned char>(c); }
    static bool      eq_int_type(const int_type& c1, const int_type& c2) { return c1 == c2; }
    static int_type  eof() { return -1; }
};

// wchar_t is 16 bits on this target and wint_t an unsigned short, so eof() is WEOF (0xffff), as MSVC's
template <>
struct char_traits<wchar_t> {
    typedef wchar_t    char_type;
    typedef wint_t     int_type;
    typedef streamoff  off_type;
    typedef wstreampos pos_type;
    typedef mbstate_t  state_type;

    static void assign(char_type& c1, const char_type& c2) { c1 = c2; }
    static bool eq(const char_type& c1, const char_type& c2) { return c1 == c2; }
    static bool lt(const char_type& c1, const char_type& c2) { return c1 < c2; }
    static int compare(const char_type* s1, const char_type* s2, size_t n)
    {
        for (size_t i = 0; i < n; ++i) if (s1[i] != s2[i]) return s1[i] < s2[i] ? -1 : 1;
        return 0;
    }
    static size_t length(const char_type* s) { return wcslen(s); }
    static const char_type* find(const char_type* s, size_t n, const char_type& a)
    {
        for (size_t i = 0; i < n; ++i) if (s[i] == a) return s + i;
        return 0;
    }
    static char_type* move(char_type* s1, const char_type* s2, size_t n) { return n == 0 ? s1 : static_cast<char_type*>(memmove(s1, s2, n * sizeof(char_type))); }
    static char_type* copy(char_type* s1, const char_type* s2, size_t n) { return n == 0 ? s1 : static_cast<char_type*>(memcpy(s1, s2, n * sizeof(char_type))); }
    static char_type* assign(char_type* s, size_t n, char_type a) { return n == 0 ? s : wmemset(s, a, n); }
    static int_type  not_eof(const int_type& c) { return c != eof() ? c : 0; }
    static char_type to_char_type(const int_type& c) { return static_cast<char_type>(c); }
    static int_type  to_int_type(const char_type& c) { return static_cast<int_type>(c); }
    static bool      eq_int_type(const int_type& c1, const int_type& c2) { return c1 == c2; }
    static int_type  eof() { return static_cast<int_type>(0xffff); }
};

// the library's: whether traits is char_traits<char>, whose compare, length and find are memcmp, strlen and memchr:
// basic_string calls those itself then, one call fewer per operation (every call is made in a -O0 build)
template <class traits> struct __is_char_traits { static const bool value = false; };
template <> struct __is_char_traits<char_traits<char> > { static const bool value = true; };

}

#endif
