// cstdio - cppparse's C++98 library: declarations of the C runtime's stdio.
// FILE matches the UCRT's opaque record; stdin/stdout/stderr come from __acrt_iob_func as in
// the UCRT headers. printf and friends resolve to legacy_stdio_definitions.lib.
#ifndef CPPPARSE_CSTDIO
#define CPPPARSE_CSTDIO

#include <cstdarg>
#include <cstddef>

struct _iobuf { void* _Placeholder; };
typedef struct _iobuf FILE;
typedef long long fpos_t;

extern "C" {
    FILE*  __acrt_iob_func(unsigned index);
    FILE*  fopen(const char* name, const char* mode);
    int    fclose(FILE* f);
    int    fflush(FILE* f);
    size_t fread(void* buffer, size_t size, size_t count, FILE* f);
    size_t fwrite(const void* buffer, size_t size, size_t count, FILE* f);
    int    fseek(FILE* f, long offset, int origin);
    long   ftell(FILE* f);
    int    _fseeki64(FILE* f, long long offset, int origin);
    long long _ftelli64(FILE* f);
    int    feof(FILE* f);
    int    ferror(FILE* f);
    int    fgetc(FILE* f);
    char*  fgets(char* buffer, int n, FILE* f);
    int    fputc(int c, FILE* f);
    int    fputs(const char* s, FILE* f);
    int    getc(FILE* f);
    int    putc(int c, FILE* f);
    int    getchar(void);
    int    putchar(int c);
    int    puts(const char* s);
    int    ungetc(int c, FILE* f);
    int    printf(const char* format, ...);
    int    fprintf(FILE* f, const char* format, ...);
    int    sprintf(char* buffer, const char* format, ...);
    int    _snprintf(char* buffer, size_t n, const char* format, ...);
    int    vprintf(const char* format, va_list args);
    int    vfprintf(FILE* f, const char* format, va_list args);
    int    vsprintf(char* buffer, const char* format, va_list args);
    int    sscanf(const char* s, const char* format, ...);
    int    remove(const char* name);
    int    rename(const char* from, const char* to);
    int    setvbuf(FILE* f, char* buffer, int mode, size_t size);
    void   perror(const char* message);
}

#define stdin  (__acrt_iob_func(0))
#define stdout (__acrt_iob_func(1))
#define stderr (__acrt_iob_func(2))
#define EOF      (-1)
#define SEEK_SET 0
#define SEEK_CUR 1
#define SEEK_END 2
#define BUFSIZ   512
#define _IOFBF   0x0000
#define _IOLBF   0x0040
#define _IONBF   0x0004
#define snprintf _snprintf

namespace std {
    using ::FILE; using ::fpos_t;
    using ::fopen; using ::fclose; using ::fflush; using ::fread; using ::fwrite; using ::fseek; using ::ftell; using ::_fseeki64; using ::_ftelli64;
    using ::feof; using ::ferror; using ::fgetc; using ::fgets; using ::fputc; using ::fputs; using ::getc; using ::putc;
    using ::getchar; using ::putchar; using ::puts; using ::ungetc; using ::printf; using ::fprintf; using ::sprintf;
    using ::vprintf; using ::vfprintf; using ::vsprintf;
    using ::sscanf; using ::remove; using ::rename; using ::setvbuf; using ::perror;
}

#endif
