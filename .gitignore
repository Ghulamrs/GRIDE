# macOS
.DS_Store

# Visual Studio
.vs/
*.user
*.suo
*.aps
*.VC.db
*.VC.opendb

# Build output
bin/
obj/
x64/
x86/
Debug/
Release/
# GRIDE 2.0's debugger source shares a name with a build folder
!/GRIDE 2.0/src/Debug/
# a tool's IntDir, ar6x's own output; the MSI and its checks
/toolchain/**/build/
/installer/dist/
# GRIDE 1.0 (RIDE 5.17, the White outlook): what its builds and tests leave in the tree. Its own
# .gitignore beside it already keeps out bin/, dist/, obj/, x64/, lib/, build/, *.log and the programs it
# builds (tests/test, tests/session among them).
/GRIDE 1.0/tests/out-*/
/GRIDE 1.0/.claude/
# its CCS reference projects carry Debug/ and Release/ folders of their own, which "Debug/" above would hide
!/GRIDE 1.0/docs/ccs-reference/**/Debug/
!/GRIDE 1.0/docs/ccs-reference/**/Release/

# Python's caches, wherever a script ran (washout.py, RIDE's tools/)
__pycache__/
*.pyc
