# macOS
.DS_Store

# Visual Studio
.vs/
*.user
*.suo
*.aps
*.VC.db
*.VC.opendb

# Build output
bin/
obj/
x64/
x86/
Debug/
Release/
# GRIDE 2.0's debugger source shares a name with a build folder
!/GRIDE 2.0/src/Debug/
# a tool's IntDir, ar6x's own output; the MSI and its checks
/toolchain/**/build/
/installer/dist/
# RIDE-4.7 (RIDE 5.17, the White outlook): what its builds and tests leave in the tree. Its own
# .gitignore beside it already keeps out bin/, dist/, obj/, x64/, lib/ and the programs it builds.
/RIDE-4.7/tests/out-*/
/RIDE-4.7/tests/build/
/RIDE-4.7/tests/gui
/RIDE-4.7/tests/session
/RIDE-4.7/tests/test
/RIDE-4.7/tests/toolchain-check
/RIDE-4.7/.claude/
# its CCS reference projects carry Debug/ and Release/ folders of their own, which "Debug/" above would hide
!/RIDE-4.7/docs/ccs-reference/**/Debug/
!/RIDE-4.7/docs/ccs-reference/**/Release/
