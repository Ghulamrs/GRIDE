  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- The Shalimar runtime beside shalimar.exe, as the post-build event built it, as MSBuild steps (nothing through
       cmd.exe; ..\..\..\msbuild\Toolchain.targets): the Windows libraries with Visual Studio's cl and lib, and the
       C6747 runtime as assembly with the solution's own cpp11 (built first), which rts6x packs into shmrt6x[d].lib. -->
  <Import Project="..\..\..\msbuild\Toolchain.targets" />
  <PropertyGroup>
    <!-- Visual Studio's own up-to-date check knows shalimar.exe's inputs only, so it would skip the project - and
         the runtimes with it - once shalimar.exe is built; the target's Inputs/Outputs decide instead -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ShmRuntimeDir>$(ProjectDir)..\runtime\</ShmRuntimeDir>
    <ShmCl>/nologo /std:c++14 /W4 /WX /EHsc /permissive- /O2 /D_CRT_SECURE_NO_WARNINGS</ShmCl>
    <ShmCpp11>$(OutDir)cpp11.exe</ShmCpp11>
  </PropertyGroup>
  <ItemGroup>
    <ShmRuntime Include="Shortest;Failure;Numbers;Array;Console;Runtime" />
    <ShmRuntimeDebug Include="Shortest;Failure;Numbers;Array;Console;Runtime;Debug" />
    <ShmRuntimeSource Include="$(ProjectDir)..\runtime\*.cpp;$(ProjectDir)..\runtime\*.h" />
  </ItemGroup>
  <Target Name="ShalimarRuntimes" AfterTargets="Build"
          Inputs="@(ShmRuntimeSource);$(ShmCpp11)"
          Outputs="$(OutDir)lib\shmrt-x86_64-windows.lib;$(OutDir)lib\shmrt-x86_64-windows-debug.lib;$(OutDir)lib\shmrt-tms6747\Runtime.s;$(OutDir)lib\shmrt-tms6747-debug\Debug.s">
    <MakeDir Directories="$(OutDir)lib;$(IntDir)rt;$(IntDir)rtd;$(OutDir)lib\shmrt-tms6747;$(OutDir)lib\shmrt-tms6747-debug" />
    <RunTool Exe="$(ToolchainCl)" WorkingDirectory="$(IntDir)rt" IncludePath="$(IncludePath)" LibPath="$(LibraryPath)" ExePath="$(ExecutablePath)" Quiet="true"
             Arguments="$(ShmCl) /MT /Fo&quot;$(IntDir)rt\\&quot; /c @(ShmRuntime->'&quot;$(ShmRuntimeDir)%(Identity).cpp&quot;', ' ')" />
    <RunTool Exe="$(ToolchainLib)" IncludePath="$(IncludePath)" LibPath="$(LibraryPath)" ExePath="$(ExecutablePath)" Quiet="true"
             Arguments="/nologo /out:&quot;$(OutDir)lib\shmrt-x86_64-windows.lib&quot; @(ShmRuntime->'&quot;$(IntDir)rt\%(Identity).obj&quot;', ' ')" />
    <RunTool Exe="$(ToolchainCl)" WorkingDirectory="$(IntDir)rtd" IncludePath="$(IncludePath)" LibPath="$(LibraryPath)" ExePath="$(ExecutablePath)" Quiet="true"
             Arguments="$(ShmCl) /MTd /DSHM_DEBUG=1 /Fo&quot;$(IntDir)rtd\\&quot; /c @(ShmRuntimeDebug->'&quot;$(ShmRuntimeDir)%(Identity).cpp&quot;', ' ')" />
    <RunTool Exe="$(ToolchainLib)" IncludePath="$(IncludePath)" LibPath="$(LibraryPath)" ExePath="$(ExecutablePath)" Quiet="true"
             Arguments="/nologo /out:&quot;$(OutDir)lib\shmrt-x86_64-windows-debug.lib&quot; @(ShmRuntimeDebug->'&quot;$(IntDir)rtd\%(Identity).obj&quot;', ' ')" />
    <Error Condition="!Exists('$(ShmCpp11)')" Text="shc.vcxproj: no cpp11.exe in $(OutDir) - the C6000 runtime is its output; cpp11 is built first in the solution" />
    <RunTool Exe="$(ShmCpp11)" Quiet="true"
             Arguments="-S -arch tms6747 -nologo -O2 &quot;$(ShmRuntimeDir)%(ShmRuntime.Identity).cpp&quot; -o &quot;$(OutDir)lib\shmrt-tms6747\%(ShmRuntime.Identity).s&quot;" />
    <RunTool Exe="$(ShmCpp11)" Quiet="true"
             Arguments="-S -arch tms6747 -nologo -O0 -DSHM_DEBUG=1 &quot;$(ShmRuntimeDir)%(ShmRuntimeDebug.Identity).cpp&quot; -o &quot;$(OutDir)lib\shmrt-tms6747-debug\%(ShmRuntimeDebug.Identity).s&quot;" />
  </Target>
  <Target Name="ShalimarRuntimesClean" AfterTargets="Clean">
    <RemoveDir Directories="$(IntDir)rt;$(IntDir)rtd;$(OutDir)lib\shmrt-tms6747;$(OutDir)lib\shmrt-tms6747-debug" />
    <Delete Files="$(OutDir)lib\shmrt-x86_64-windows.lib;$(OutDir)lib\shmrt-x86_64-windows-debug.lib" />
  </Target>
</Project>
