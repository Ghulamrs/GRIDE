  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{5BC0DB40-BD9A-72C2-1130-8E762F9DB1F7}</ProjectGuid>
    <RootNamespace>shc</RootNamespace>
